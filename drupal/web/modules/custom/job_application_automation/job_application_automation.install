      'type' => 'link',
      'label' => 'GitHub URL',
      'description' => 'GitHub profile URL',
      'required' => FALSE,
    ],
    'field_references_available' => [
      'type' => 'boolean',
      'label' => 'References Available',
      'description' => 'References available upon request',
      'required' => FALSE,
      'default_value' => [['value' => 1]],
    ],
    'field_cover_letter_template' => [
      'type' => 'text_long',
      'label' => 'Cover Letter Template',
      'description' => 'Default cover letter template',
      'required' => FALSE,
    ],
    'field_ai_analysis_data' => [
      'type' => 'text_long',
      'label' => 'AI Analysis Data',
      'description' => 'JSON storage for AI-analyzed profile data',
      'required' => FALSE,
    ],
    'field_profile_completeness' => [
      'type' => 'integer',
      'label' => 'Profile Completeness',
      'description' => 'Profile completion percentage',
      'required' => FALSE,
      'default_value' => [['value' => 0]],
    ],
