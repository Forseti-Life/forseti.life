/**
 * Removes custom user fields during uninstall.
 */
function _job_application_automation_remove_user_fields() {
  $logger = \Drupal::logger('job_application_automation');
  $user_fields = _job_application_automation_get_user_field_config();
  
  foreach (array_keys($user_fields) as $field_name) {
    // Remove field instance
    $field = FieldConfig::loadByName('user', 'user', $field_name);
    if ($field) {
      $field->delete();
      $logger->info('Removed user field instance: @field_name', ['@field_name' => $field_name]);
    }
    
    // Remove field storage
    $field_storage = FieldStorageConfig::loadByName('user', $field_name);
    if ($field_storage) {
      $field_storage->delete();
      $logger->info('Removed user field storage: @field_name', ['@field_name' => $field_name]);
    }
  }
}

/**
 * Removes content types during uninstall.
 */
function _job_application_automation_remove_content_types() {
  $logger = \Drupal::logger('job_application_automation');
  $content_types = ['company', 'job_posting', 'application', 'error_queue'];
  
  foreach ($content_types as $type_id) {
    $node_type = NodeType::load($type_id);
    if ($node_type) {
      $node_type->delete();
      $logger->info('Removed content type: @type', ['@type' => $type_id]);
    }
  }
}

