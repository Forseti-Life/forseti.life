<?php

/**
 * @file
 * Install, update and uninstall functions for the Job Application Automation module.
 */

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\views\Views;
use Drupal\menu_link_content\Entity\MenuLinkContent;

/**
 * Implements hook_install().
 */
function job_application_automation_install() {
  $messenger = \Drupal::messenger();
  $logger = \Drupal::logger('job_application_automation');
  
  try {
    $logger->info('Starting Job Application Automation module installation...');
    
    // Create content types
    _job_application_automation_create_content_types();
    
    // Create and attach fields to content types
    _job_application_automation_create_content_type_fields();
    
    // Extend user entity with custom fields
    _job_application_automation_create_user_fields();
    
    // Configure field displays
    _job_application_automation_configure_displays();
    
    // Set default permissions
    _job_application_automation_set_permissions();
    
    // Create main menu links
    _job_application_automation_create_menu_links();
    
    $messenger->addMessage(t('Job Application Automation module has been installed successfully. All content types and fields have been created.'));
    $logger->info('Job Application Automation module installation completed successfully.');
    
  }
  catch (Exception $e) {
    $messenger->addError(t('There was an error installing the Job Application Automation module: @error', ['@error' => $e->getMessage()]));
    $logger->error('Installation error: @error', ['@error' => $e->getMessage()]);
    throw $e;
  }
}

/**
 * Implements hook_uninstall().
 */
function job_application_automation_uninstall() {
  $messenger = \Drupal::messenger();
  $logger = \Drupal::logger('job_application_automation');
  
  try {
    $logger->info('Starting Job Application Automation module uninstallation...');
    
    // Remove menu links
    _job_application_automation_remove_menu_links();
    
    // Remove custom configuration
    \Drupal::configFactory()->getEditable('job_application_automation.settings')->delete();
    
    // Note: Content types and fields are preserved to avoid data loss
    // Administrators can manually delete them if desired
    
    $messenger->addMessage(t('Job Application Automation module has been uninstalled. Content types and fields have been preserved to prevent data loss.'));
    $logger->info('Job Application Automation module uninstallation completed.');
    
  }
  catch (Exception $e) {
    $messenger->addError(t('There was an error uninstalling the Job Application Automation module: @error', ['@error' => $e->getMessage()]));
    $logger->error('Uninstallation error: @error', ['@error' => $e->getMessage()]);
  }
}

/**
 * Create all required content types.
 */
function _job_application_automation_create_content_types() {
  $content_types = [
    'company' => [
      'label' => 'Company',
      'description' => 'Employer companies for job application automation',
    ],
    'job_posting' => [
      'label' => 'Job Posting',
      'description' => 'Individual job opportunities discovered through scraping',
    ],
    'application' => [
      'label' => 'Application',
      'description' => 'User job applications and their status',
    ],
    'error_queue' => [
      'label' => 'Error Queue',
      'description' => 'System errors requiring admin attention',
    ],
  ];

  foreach ($content_types as $type => $info) {
    // Check if content type already exists
    $existing_type = NodeType::load($type);
    if (!$existing_type) {
      $node_type = NodeType::create([
        'type' => $type,
        'name' => $info['label'],
        'description' => $info['description'],
        'title_label' => 'Title',
        'create_body' => FALSE,
        'promote' => FALSE,
        'sticky' => FALSE,
        'locked' => FALSE,
      ]);
      $node_type->save();
      
      \Drupal::logger('job_application_automation')->info('Created content type: @type', ['@type' => $type]);
    }
    else {
      \Drupal::logger('job_application_automation')->info('Content type already exists: @type', ['@type' => $type]);
    }
  }
}

/**
 * Create and attach all fields to content types.
 */
function _job_application_automation_create_content_type_fields() {
  $field_definitions = _job_application_automation_get_field_definitions();
  
  foreach ($field_definitions as $entity_type => $bundles) {
    foreach ($bundles as $bundle => $fields) {
      foreach ($fields as $field_name => $field_config) {
        _job_application_automation_create_field($entity_type, $bundle, $field_name, $field_config);
      }
    }
  }
}

/**
 * Create user entity fields.
 */
function _job_application_automation_create_user_fields() {
  $user_fields = _job_application_automation_get_user_field_definitions();
  
  foreach ($user_fields as $field_name => $field_config) {
    _job_application_automation_create_field('user', 'user', $field_name, $field_config);
  }
}

/**
 * Create a single field and attach it to an entity bundle.
 */
function _job_application_automation_create_field($entity_type, $bundle, $field_name, $field_config) {
  // Check if field storage exists
  $field_storage = FieldStorageConfig::loadByName($entity_type, $field_name);
  
  if (!$field_storage) {
    $storage_config = [
      'field_name' => $field_name,
      'entity_type' => $entity_type,
      'type' => $field_config['type'],
    ];
    
    // Add additional storage settings if specified
    if (isset($field_config['cardinality'])) {
      $storage_config['cardinality'] = $field_config['cardinality'];
    }
    if (isset($field_config['settings'])) {
      $storage_config['settings'] = $field_config['settings'];
    }
    
    $field_storage = FieldStorageConfig::create($storage_config);
    $field_storage->save();
    
    \Drupal::logger('job_application_automation')->info('Created field storage: @field for @entity_type', [
      '@field' => $field_name,
      '@entity_type' => $entity_type,
    ]);
  }
  
  // Check if field config exists for this bundle
  $field_instance = FieldConfig::loadByName($entity_type, $bundle, $field_name);
  
  if (!$field_instance) {
    $instance_config = [
      'field_name' => $field_name,
      'entity_type' => $entity_type,
      'bundle' => $bundle,
      'label' => $field_config['label'],
    ];
    
    // Add additional instance settings
    if (isset($field_config['required'])) {
      $instance_config['required'] = $field_config['required'];
    }
    if (isset($field_config['description'])) {
      $instance_config['description'] = $field_config['description'];
    }
    if (isset($field_config['default_value'])) {
      $instance_config['default_value'] = $field_config['default_value'];
    }
    
    $field_instance = FieldConfig::create($instance_config);
    $field_instance->save();
    
    \Drupal::logger('job_application_automation')->info('Created field instance: @field for @entity_type:@bundle', [
      '@field' => $field_name,
      '@entity_type' => $entity_type,
      '@bundle' => $bundle,
    ]);
  }
}

