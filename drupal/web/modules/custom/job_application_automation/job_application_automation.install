<?php

/**
 * @file
 * Install, update and uninstall functions for the Job Application Automation module.
 */

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\Core\Entity\EntityTypeManagerInterface;

/**
 * Implements hook_install().
 * 
 * Creates all required content types, fields, and configurations when the module is installed.
 */
function job_application_automation_install() {
  $messenger = \Drupal::messenger();
  $logger = \Drupal::logger('job_application_automation');
  
  try {
    // Log installation start
    $logger->info('Job Application Automation module installation started.');
    
    // Create content types with fields
    _job_application_automation_create_content_types();
    
    // Extend user entity with custom fields
    _job_application_automation_create_user_fields();
    
    // Set up permissions
    _job_application_automation_configure_permissions();
    
    // Create default configuration
    _job_application_automation_create_default_config();
    
    // Create administrative views
    require_once __DIR__ . '/job_application_automation.views.inc';
    _job_application_automation_create_admin_views();
    
    // Success message
    $messenger->addStatus(t('Job Application Automation module installed successfully. All content types and fields have been created.'));
    $logger->info('Job Application Automation module installation completed successfully.');
    
  } catch (\Exception $e) {
    $error_message = t('Error during Job Application Automation module installation: @message', ['@message' => $e->getMessage()]);
    $messenger->addError($error_message);
    $logger->error($error_message);
    throw $e;
  }
}

/**
 * Implements hook_uninstall().
 * 
 * Cleans up content types, fields, and configurations when the module is uninstalled.
 */
function job_application_automation_uninstall() {
  $messenger = \Drupal::messenger();
  $logger = \Drupal::logger('job_application_automation');
  
  try {
    $logger->info('Job Application Automation module uninstallation started.');
    
    // Remove custom user fields
    _job_application_automation_remove_user_fields();
    
    // Remove content types (this will also remove associated fields)
    _job_application_automation_remove_content_types();
    
    // Remove administrative views
    require_once __DIR__ . '/job_application_automation.views.inc';
    _job_application_automation_remove_admin_views();
    
    // Remove module configuration
    \Drupal::configFactory()->getEditable('job_application_automation.settings')->delete();
    
    $messenger->addStatus(t('Job Application Automation module uninstalled successfully.'));
    $logger->info('Job Application Automation module uninstallation completed successfully.');
    
  } catch (\Exception $e) {
    $error_message = t('Error during Job Application Automation module uninstallation: @message', ['@message' => $e->getMessage()]);
    $messenger->addWarning($error_message);
    $logger->error($error_message);
  }
}

/**
 * Creates all required content types with their fields.
 */
function _job_application_automation_create_content_types() {
  $logger = \Drupal::logger('job_application_automation');
  
  // Content types to create
  $content_types = [
    'company' => _job_application_automation_get_company_config(),
    'job_posting' => _job_application_automation_get_job_posting_config(),
    'application' => _job_application_automation_get_application_config(),
    'error_queue' => _job_application_automation_get_error_queue_config(),
  ];
  
  foreach ($content_types as $type_id => $config) {
    // Check if content type already exists
    $node_type = NodeType::load($type_id);
    if (!$node_type) {
      // Create content type
      $node_type = NodeType::create([
        'type' => $type_id,
        'name' => $config['name'],
        'description' => $config['description'],
      ]);
      $node_type->save();
      $logger->info('Created content type: @type', ['@type' => $type_id]);
    } else {
      $logger->info('Content type @type already exists, skipping creation.', ['@type' => $type_id]);
    }
    
    // Create fields for this content type
    _job_application_automation_create_fields_for_content_type($type_id, $config['fields']);
  }
}

/**
 * Creates fields for a specific content type.
 */
function _job_application_automation_create_fields_for_content_type($bundle, $fields) {
  $logger = \Drupal::logger('job_application_automation');
  
  foreach ($fields as $field_name => $field_config) {
    // Create field storage if it doesn't exist
    $field_storage = FieldStorageConfig::loadByName('node', $field_name);
    if (!$field_storage) {
      $field_storage = FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $field_config['type'],
        'settings' => $field_config['storage_settings'] ?? [],
        'cardinality' => $field_config['cardinality'] ?? 1,
      ]);
      $field_storage->save();
      $logger->info('Created field storage: @field_name', ['@field_name' => $field_name]);
    }
    
    // Create field instance if it doesn't exist
    $field = FieldConfig::loadByName('node', $bundle, $field_name);
    if (!$field) {
      $field = FieldConfig::create([
        'field_storage' => $field_storage,
        'bundle' => $bundle,
        'label' => $field_config['label'],
        'description' => $field_config['description'] ?? '',
        'required' => $field_config['required'] ?? FALSE,
        'settings' => $field_config['field_settings'] ?? [],
      ]);
      $field->save();
      $logger->info('Created field instance: @field_name for @bundle', [
        '@field_name' => $field_name, 
        '@bundle' => $bundle
      ]);
    }
  }
}

