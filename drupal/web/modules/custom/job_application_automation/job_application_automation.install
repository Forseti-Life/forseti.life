/**
 * Configure field displays for content types.
 */
function _job_application_automation_configure_displays() {
  // Configure form displays for all content types
  _job_application_automation_configure_company_form_display();
  _job_application_automation_configure_job_posting_form_display();
  _job_application_automation_configure_application_form_display();
  _job_application_automation_configure_issue_form_display();
  _job_application_automation_configure_user_form_display();
  
  \Drupal::logger('job_application_automation')->info('Field displays configured successfully.');
}

/**
 * Configure form display for company content type.
 */
function _job_application_automation_configure_company_form_display() {
  $form_display = EntityFormDisplay::load('node.company.default');
  
  if (!$form_display) {
    $form_display = EntityFormDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'company',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }

  // Configure field displays with proper weights
  $form_display->setComponent('field_website', [
    'type' => 'link_default',
    'weight' => 1,
    'settings' => [
      'placeholder_url' => 'https://example.com',
      'placeholder_title' => 'Company Website',
    ],
  ]);

  $form_display->setComponent('field_careers_url', [
    'type' => 'link_default',
    'weight' => 2,
    'settings' => [
      'placeholder_url' => 'https://example.com/careers',
      'placeholder_title' => 'Careers Page',
    ],
  ]);

  $form_display->setComponent('field_description', [
    'type' => 'text_textarea',
    'weight' => 3,
    'settings' => [
      'rows' => 5,
      'placeholder' => 'Enter company description...',
    ],
  ]);

  $form_display->setComponent('field_industry', [
    'type' => 'options_select',
    'weight' => 4,
  ]);

  $form_display->setComponent('field_size', [
    'type' => 'options_select',
    'weight' => 5,
  ]);

  $form_display->setComponent('field_location', [
    'type' => 'string_textfield',
    'weight' => 6,
    'settings' => [
      'placeholder' => 'City, State/Country',
    ],
  ]);

  $form_display->setComponent('field_active', [
    'type' => 'boolean_checkbox',
    'weight' => 7,
    'settings' => [
      'display_label' => TRUE,
    ],
  ]);

  $form_display->setComponent('field_company_logo', [
    'type' => 'image_image',
    'weight' => 8,
  ]);

  $form_display->setComponent('field_scraping_notes', [
    'type' => 'text_textarea',
    'weight' => 9,
    'settings' => [
      'rows' => 3,
      'placeholder' => 'Internal notes about job scraping for this company...',
    ],
  ]);

  $form_display->save();
  
  \Drupal::logger('job_application_automation')->info('Company form display configured successfully.');
}

