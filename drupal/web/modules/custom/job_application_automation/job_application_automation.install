/**
 * Configure form display for user profile fields.
 */
function _job_application_automation_configure_user_form_display() {
  $form_display = EntityFormDisplay::load('user.user.default');
  
  if (!$form_display) {
    $form_display = EntityFormDisplay::create([
      'targetEntityType' => 'user',
      'bundle' => 'user',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }

  // Configure key user profile fields with proper weights
  $weight = 10; // Start after default fields
  
  $user_fields = [
    'field_first_name' => 'string_textfield',
    'field_last_name' => 'string_textfield',
    'field_phone_number' => 'telephone_default',
    'field_city' => 'string_textfield',
    'field_state' => 'string_textfield',
    'field_country' => 'string_textfield',
    'field_job_title' => 'string_textfield',
    'field_years_experience' => 'number',
    'field_skills' => 'text_textarea',
    'field_education_level' => 'options_select',
    'field_resume_file' => 'file_generic',
    'field_desired_salary_min' => 'number',
    'field_desired_salary_max' => 'number',
    'field_job_search_status' => 'options_select',
    'field_remote_preference' => 'options_select',
  ];

  foreach ($user_fields as $field_name => $widget_type) {
    $form_display->setComponent($field_name, [
      'type' => $widget_type,
      'weight' => $weight++,
    ]);
  }

  $form_display->save();
  \Drupal::logger('job_application_automation')->info('User form display configured successfully.');
}

