}

/**
 * Creates default module configuration.
 */
function _job_application_automation_create_default_config() {
  $config = \Drupal::configFactory()->getEditable('job_application_automation.settings');
  
  $default_settings = [
    'api_keys' => [
      'openai' => '',
      'scraping_service' => '',
    ],
    'scraping_settings' => [
      'rate_limit' => 10,
      'user_agent' => 'Job Application Automation Bot 1.0',
      'timeout' => 30,
    ],
    'notification_settings' => [
      'admin_email' => \Drupal::config('system.site')->get('mail'),
      'error_notifications' => TRUE,
      'success_notifications' => FALSE,
    ],
    'general_settings' => [
      'max_applications_per_day' => 10,
      'require_resume_upload' => TRUE,
      'auto_archive_old_applications' => TRUE,
    ],
  ];
  
  $config->setData($default_settings)->save();
}