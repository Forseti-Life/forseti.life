/**
 * Add primary resume text field for automatic text extraction.
 */
function job_application_automation_update_8002() {
  $logger = \Drupal::logger('job_application_automation');
  
  try {
    // Create the new field for storing extracted resume text
    $field_config = [
      'type' => 'text_long',
      'label' => 'Primary Resume Text',
      'description' => 'Extracted text content from uploaded resume file (automatically populated)',
      'required' => FALSE,
    ];
    
    _job_application_automation_create_field('user', 'user', 'field_primary_resume_text', $field_config);
    
    // Configure the field display to be visible
    _job_application_automation_configure_primary_resume_display();
    
    $logger->info('Primary resume text field added successfully.');
    return t('Primary resume text field has been added for automatic text extraction.');
    
  } catch (Exception $e) {
    $logger->error('Error adding primary resume text field: @error', ['@error' => $e->getMessage()]);
    throw $e;
  }
}

/**
 * Configure the primary resume text field display.
 */
function _job_application_automation_configure_primary_resume_display() {
  // Configure view display
  $view_display = EntityViewDisplay::load('user.user.default');
  if ($view_display) {
    $view_display->setComponent('field_primary_resume_text', [
      'type' => 'text_default',
      'label' => 'above',
      'weight' => 15,
      'settings' => [],
      'third_party_settings' => [],
    ]);
    $view_display->save();
    
    \Drupal::logger('job_application_automation')->info('Primary resume text field display configured.');
  }
  
  // Keep field hidden in edit forms (it's auto-populated)
  $form_display = EntityFormDisplay::load('user.user.default');
  if ($form_display) {
    $form_display->removeComponent('field_primary_resume_text');
    $form_display->save();
    
    \Drupal::logger('job_application_automation')->info('Primary resume text field hidden from forms.');
  }
}

