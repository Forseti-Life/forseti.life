/**
 * Create main menu links for job application automation.
 */
function _job_application_automation_create_menu_links() {
  try {
    // Create main Job Application menu item in Admin menu
    $menu_link = MenuLinkContent::create([
      'title' => 'Job Applications',
      'link' => ['uri' => 'internal:/admin/content/job-application/companies'],
      'menu_name' => 'admin',
      'expanded' => TRUE,
      'weight' => 0,
    ]);
    $menu_link->save();
    
    // Create submenu items
    $submenu_items = [
      [
        'title' => 'Companies',
        'uri' => 'internal:/admin/content/job-application/companies',
        'weight' => 0,
        'parent' => 'menu_link_content:' . $menu_link->uuid(),
      ],
      [
        'title' => 'Job Postings', 
        'uri' => 'internal:/admin/content/job-application/job-postings',
        'weight' => 1,
        'parent' => 'menu_link_content:' . $menu_link->uuid(),
      ],
      [
        'title' => 'Applications',
        'uri' => 'internal:/admin/content/job-application/applications', 
        'weight' => 2,
        'parent' => 'menu_link_content:' . $menu_link->uuid(),
      ],
      [
        'title' => 'Error Queue',
        'uri' => 'internal:/admin/content/job-application/errors',
        'weight' => 3,
        'parent' => 'menu_link_content:' . $menu_link->uuid(),
      ],
    ];
    
    foreach ($submenu_items as $item) {
      $submenu_link = MenuLinkContent::create([
        'title' => $item['title'],
        'link' => ['uri' => $item['uri']],
        'menu_name' => 'admin',
        'parent' => $item['parent'],
        'weight' => $item['weight'],
      ]);
      $submenu_link->save();
    }
    
    \Drupal::logger('job_application_automation')->info('Menu links created successfully.');
    
  } catch (Exception $e) {
    \Drupal::logger('job_application_automation')->error('Error creating menu links: @error', ['@error' => $e->getMessage()]);
  }
}

/**
 * Remove menu links created by the module.
 */
function _job_application_automation_remove_menu_links() {
  try {
    // Find and remove menu links by title
    $menu_titles = [
      'Job Applications',
      'Companies', 
      'Job Postings',
      'Applications',
      'Error Queue'
    ];
    
    foreach ($menu_titles as $title) {
      $menu_links = \Drupal::entityTypeManager()
        ->getStorage('menu_link_content')
        ->loadByProperties(['title' => $title, 'menu_name' => 'admin']);
      
      foreach ($menu_links as $menu_link) {
        $menu_link->delete();
      }
    }
    
    \Drupal::logger('job_application_automation')->info('Menu links removed successfully.');
    
  } catch (Exception $e) {
    \Drupal::logger('job_application_automation')->error('Error removing menu links: @error', ['@error' => $e->getMessage()]);
  }
}