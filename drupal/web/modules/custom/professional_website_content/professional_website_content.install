 * NOTE: Page creation functions removed to prevent overwriting manually edited content.
 * Original page creation logic preserved in professional_website_content.install.backup
 */

/**
 * Implements hook_install().
 */
function professional_website_content_install() {
  // NOTE: Page creation functions removed to prevent overwriting manually edited content
  // Original page creation logic preserved in professional_website_content.install.backup
  
  // Place the professional navigation block
  _professional_website_content_place_navigation_block();

  \Drupal::messenger()->addStatus(t('Professional website content module installed - navigation block placed.'));
}

/**
 * REMOVED: All page creation functions moved to professional_website_content.install.backup
 * This prevents overwriting manually edited pages during module operations.
