{#
/**
 * @file
 * Enhanced footer region template with professional layout.
 * This creates a manageable footer that integrates with Drupal's block system.
 */
#}
<footer{{ attributes.addClass('footer', 'site-footer') }} role="contentinfo">
  <div class="container">
    <div class="row">
      {# Company Information Column #}
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="company-info">
          <div class="company-name">St. Louis Integration</div>
          <div class="company-tagline">Technology That Drives Business Outcomes</div>
          <p>Empowering Fortune 500 companies with cutting-edge AI and data solutions across Financial Services, Healthcare, and Energy sectors.</p>
          
          {# Social Media Links #}
          <div class="social-links">
            <a href="https://www.linkedin.com/company/st-louis-integration" class="social-link" title="LinkedIn" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="https://github.com/keithaumiller" class="social-link" title="GitHub" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      {# Services and Solutions Column #}
      <div class="col-lg-2 col-md-6 mb-4">
        <div class="footer-links">
          <h5>Services</h5>
          <ul>
            <li><a href="{{ path('entity.node.canonical', {'node': 'services'}) }}">AI Solutions</a></li>
            <li><a href="{{ path('entity.node.canonical', {'node': 'services'}) }}">Data Engineering</a></li>
            <li><a href="{{ path('entity.node.canonical', {'node': 'services'}) }}">Cloud Migration</a></li>
            <li><a href="{{ path('entity.node.canonical', {'node': 'services'}) }}">System Integration</a></li>
            <li><a href="{{ path('entity.node.canonical', {'node': 'services'}) }}">Digital Transformation</a></li>
          </ul>
        </div>
      </div>

      {# Industries Column #}
      <div class="col-lg-2 col-md-6 mb-4">
        <div class="footer-links">
          <h5>Industries</h5>
          <ul>
            <li><a href="{{ path('entity.node.canonical', {'node': 'industries/fintech'}) }}">Financial Services</a></li>
            <li><a href="{{ path('entity.node.canonical', {'node': 'industries/healthcare'}) }}">Healthcare</a></li>
            <li><a href="{{ path('entity.node.canonical', {'node': 'industries/energy'}) }}">Energy & Utilities</a></li>
            <li><a href="{{ path('entity.node.canonical', {'node': 'case-studies'}) }}">Case Studies</a></li>
            <li><a href="{{ path('entity.node.canonical', {'node': 'leadership'}) }}">Leadership</a></li>
          </ul>
        </div>
      </div>

      {# Contact and Demo Column #}
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="contact-info">
          <h5>Get In Touch</h5>
          <div class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <address>
              St. Louis, Missouri<br>
              United States
            </address>
          </div>
          
          <div class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <a href="{{ path('entity.node.canonical', {'node': 'contact'}) }}">Contact Us</a>
          </div>
          
          <div class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            <a href="{{ path('ai_conversation.claude_demo') }}">Try Claude Demo</a>
          </div>

          <p style="margin-top: 1rem; font-size: 0.9rem; color: #b3deff;">
            <strong>Ready to transform your business?</strong><br>
            Let's discuss how our AI and data solutions can drive measurable outcomes for your organization.
          </p>
        </div>
      </div>
    </div>

    {# Footer Bottom Section #}
    <div class="footer-bottom">
      <div class="row">
        <div class="col-12">
          <p>&copy; {{ "now"|date("Y") }} St. Louis Integration LLC. All rights reserved.</p>
          <div class="footer-legal-links">
            <a href="{{ path('entity.node.canonical', {'node': 'privacy-policy'}) }}">Privacy Policy</a>
            <a href="{{ path('entity.node.canonical', {'node': 'terms-of-service'}) }}">Terms of Service</a>
            <a href="{{ path('entity.node.canonical', {'node': 'sitemap'}) }}">Sitemap</a>
            <a href="{{ path('entity.node.canonical', {'node': 'accessibility'}) }}">Accessibility</a>
          </div>
          <p style="font-size: 0.8rem; margin-top: 1rem; opacity: 0.8;">
            Powered by innovation, driven by results. 
            Serving clients across Financial Services, Healthcare, and Energy industries.
          </p>
        </div>
      </div>
    </div>
  </div>

  {# Drupal Block Content - This allows blocks to be placed in the footer region #}
  {% if content %}
    <div class="container footer-blocks">
      <div class="row">
        <div class="col-12">
          {{ content }}
        </div>
      </div>
    </div>
  {% endif %}
</footer>