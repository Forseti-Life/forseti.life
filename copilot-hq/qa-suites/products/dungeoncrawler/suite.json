{
  "product_id": "dungeoncrawler",
  "product_label": "Dungeoncrawler",
  "tools": [
    "playwright",
    "python"
  ],
  "notes": [
    "This manifest is the canonical list of automated suites for Dungeoncrawler.",
    "If the product also has language-native unit tests (e.g., PHPUnit), they can be included as suites here, but the PASS/FAIL contract must remain consistent."
  ],
  "suites": [
    {
      "id": "role-url-audit",
      "label": "Role-based URL/ACL audit",
      "type": "audit",
      "command": "ALLOW_PROD_QA=${ALLOW_PROD_QA:-0} DUNGEONCRAWLER_BASE_URL=${DUNGEONCRAWLER_BASE_URL:?set DUNGEONCRAWLER_BASE_URL} scripts/site-audit-run.sh dungeoncrawler",
      "artifacts": [
        "sessions/qa-dungeoncrawler/artifacts/auto-site-audit/<ts>/..."
      ],
      "required_for_release": true
    },
    {
      "id": "dc-cr-clan-dagger-e2e",
      "feature_id": "dc-cr-clan-dagger",
      "label": "Clan Dagger \u2014 Dwarven Starting Equipment (drush ev unit tests)",
      "type": "e2e",
      "command": "cd /home/ubuntu/forseti.life/sites/dungeoncrawler && ./vendor/bin/drush ev '...'",
      "notes": "Verified via drush ev (no Playwright suite yet \u2014 drush-ev approach is authoritative until Playwright env is provisioned). Tests cover: TC-001 catalog JSON, TC-002 Dwarf auto-grant, TC-003 item flags, TC-004 sell taboo block, TC-008 non-Dwarf exclusion, TC-009 distinct instances, TC-010 drop no-taboo, TC-011 location change no-taboo, TC-013 graceful fail, TC-014 server-side grant, TC-015 server-side taboo, TC-016 GM override. TC-005/006/007 (combat) deferred: requires dc-cr-encounter-rules completion. TC-012 FAIL: duplicate grant prevention not enforced (see BLOCK note).",
      "artifacts": [
        "sessions/qa-dungeoncrawler/artifacts/20260327-004055-unit-test-20260320-impl-dc-cr-clan-dagger/verification-report.md"
      ],
      "required_for_release": true,
      "activated_release": "20260326-dungeoncrawler-release-b",
      "activated_date": "2026-03-28"
    },
    {
      "id": "dc-cr-character-leveling-e2e",
      "feature_id": "dc-cr-character-leveling",
      "label": "Character Leveling and Advancement \u2014 E2E (drush ev unit tests)",
      "type": "e2e",
      "command": "cd /home/ubuntu/forseti.life/sites/dungeoncrawler && ./vendor/bin/drush ev '...'",
      "notes": "Stage-0 activated 2026-04-05. Playwright test scripts pending implementation (19 TCs defined in features/dc-cr-character-leveling/03-test-plan.md). Until scripts exist, use drush ev inline PHP for TC-001/007/009/010/013/014 (trigger, idempotency, max-level, milestone, non-existent char, structured error). TC-015 (concurrency) and TC-008 (persistence) require live env + PHPUnit. Routes: 8 level-up routes + 1 milestone route registered in dungeoncrawler_content.routing.yml. Admin routes gate on 'administer dungeoncrawler content'; player routes gate on _character_access:TRUE + _csrf_request_header_mode:TRUE. ACL coverage: api-character-entity-routes rule in qa-permissions.json (ignore on parametrized paths). Requires composer install in /home/ubuntu/forseti.life/sites/dungeoncrawler before any drush commands can run.",
      "artifacts": [
        "sessions/qa-dungeoncrawler/artifacts/<ts>-unit-test-dc-cr-character-leveling/verification-report.md"
      ],
      "required_for_release": true,
      "activated_release": "20260402-dungeoncrawler-release-b",
      "activated_date": "2026-04-05"
    },
    {
      "id": "module-test-suite",
      "label": "Module PHPUnit test suite (functional)",
      "type": "unit",
      "command": "cd /home/ubuntu/forseti.life/sites/dungeoncrawler && ./vendor/bin/phpunit -c phpunit.xml.dist --testsuite=functional 2>&1",
      "artifacts": [
        "sessions/qa-dungeoncrawler/artifacts/phpunit/<ts>/phpunit-output.txt"
      ],
      "required_for_release": false,
      "notes": "Requires a configured Drupal test environment (SIMPLETEST_BASE_URL, database). Run via tests/run-tests.sh for auto-setup. Currently not required_for_release due to env dependency; promote when CI env is available."
    },
    {
      "id": "dc-cr-action-economy-phpunit",
      "label": "PHPUnit tests for dc-cr-action-economy \u2014 full 1/2/3-action, reaction, free-action budget enforcement",
      "type": "unit",
      "feature_id": "dc-cr-action-economy",
      "command": "./vendor/bin/phpunit --filter=ActionEconomyTest",
      "artifacts": [
        "sessions/qa-dungeoncrawler/artifacts/dc-cr-action-economy-phpunit/"
      ],
      "required_for_release": true,
      "test_cases": [
        {
          "id": "TC-AE-01",
          "method": "ActionEconomyTest::testTurnStartResetsActionBudget",
          "description": "Turn start resets actions_remaining to 3 and reaction_available to true"
        },
        {
          "id": "TC-AE-02",
          "method": "ActionEconomyTest::testOneActionCostDecrement",
          "description": "1-action cost decrements actions_remaining by 1"
        },
        {
          "id": "TC-AE-03",
          "method": "ActionEconomyTest::testTwoActionActivityDecrement",
          "description": "2-action activity decrements actions_remaining by 2"
        },
        {
          "id": "TC-AE-04",
          "method": "ActionEconomyTest::testThreeActionActivityDecrement",
          "description": "3-action activity decrements actions_remaining by 3"
        },
        {
          "id": "TC-AE-05",
          "method": "ActionEconomyTest::testFreeActionNoCost",
          "description": "Free action does not decrement budget"
        },
        {
          "id": "TC-AE-06",
          "method": "ActionEconomyTest::testReactionConsumption",
          "description": "Spending a reaction sets reaction_available to false"
        },
        {
          "id": "TC-AE-07",
          "method": "ActionEconomyTest::testInsufficientActionsRejected",
          "description": "Cannot act when actions_remaining insufficient for action cost"
        },
        {
          "id": "TC-AE-08",
          "method": "ActionEconomyTest::testSpentReactionRejected",
          "description": "Cannot use reaction if reaction_available is false"
        },
        {
          "id": "TC-AE-09",
          "method": "ActionEconomyTest::testTwoActionActivityRejectedAtOneRemaining",
          "description": "2-action activity rejected with only 1 action remaining"
        },
        {
          "id": "TC-AE-10",
          "method": "ActionEconomyTest::testActionsRemainingFloorAtZero",
          "description": "actions_remaining cannot go below 0"
        },
        {
          "id": "TC-AE-11",
          "method": "ActionEconomyTest::testInvalidActionCostRejected",
          "description": "Invalid action cost (-1, 0, 4, null) rejected at validation"
        },
        {
          "id": "TC-AE-12",
          "method": "ActionEconomyTest::testSpendActionsOutsideActiveTurnRejected",
          "description": "Spending actions outside active turn returns error, no mutation"
        },
        {
          "id": "TC-AE-13",
          "suite": "role-url-audit",
          "method": null,
          "description": "Anon cannot access mutation endpoints (POST /api/combat/action \u2014 403/405)"
        },
        {
          "id": "TC-AE-14",
          "suite": "role-url-audit",
          "method": null,
          "description": "Authenticated player can access own character action endpoint"
        },
        {
          "id": "TC-AE-15",
          "method": "ActionEconomyTest::testPlayerCannotSpendOtherCharacterActions",
          "description": "Player cannot spend another character actions"
        }
      ]
    },
