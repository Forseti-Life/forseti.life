# Environment Configuration Template
# Copy this file to .env in the project root and update with your values

# Database Configuration
DB_NAME=forseti_dev
DB_USER=drupal_user
DB_PASSWORD=drupal_secure_password
DB_HOST=localhost
DB_PORT=3306

# Drupal Admin Configuration
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PASSWORD=admin_secure_password
DRUPAL_ADMIN_EMAIL=admin@forseti.life

# Site Configuration
SITE_NAME="Forseti"
SITE_EMAIL=contact@forseti.life

# Development Settings
ENVIRONMENT=development
DEBUG_MODE=true

# Optional: Web Server Configuration
APACHE_DOCUMENT_ROOT=/var/www/html/forseti
DOMAIN_NAME=forseti.local

# Optional: Backup Configuration
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30