        ->getStorage('path_alias')
        ->create([
          'path' => '/node/' . $node->id(),
          'alias' => '/' . $alias,
          'langcode' => 'en',
        ]);
      $path_alias->save();

      \Drupal::logger('professional_website_content')->info('Created legal page: @title', ['@title' => $page_data['title']]);
