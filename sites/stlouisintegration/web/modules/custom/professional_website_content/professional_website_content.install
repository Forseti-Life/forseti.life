<?php

/**
 * @file
 * Install, update and uninstall functions for the professional_website_content module.
 */

/**
 * Implements hook_install().
 */
function professional_website_content_install() {
  // Create the welcome home page first
  $home_nid = _professional_website_content_create_home_page();

  // Create the resume data node (node/10 equivalent)
  $resume_data = _professional_website_content_get_resume_data();
  $resume_node = \Drupal::entityTypeManager()
    ->getStorage('node')
    ->create([
      'type' => 'page',
      'title' => 'Professional Resume Data',
      'body' => [
        'value' => $resume_data,
        'format' => 'basic_html',
      ],
      'status' => 1,
      'uid' => 1,
    ]);
  $resume_node->save();

  // Create About Us page
  _professional_website_content_create_about_page();

  // Create Services page
  _professional_website_content_create_services_page();

  // Create Product Prototyping page
  _professional_website_content_create_product_prototyping_page();

  // Create AI & Machine Learning page
  _professional_website_content_create_ai_machine_learning_page();

  // Create Data Engineering & Architecture page
  _professional_website_content_create_data_engineering_page();

  // Create industry pages
  _professional_website_content_create_industry_pages();

  // Create case studies
  _professional_website_content_create_case_studies();

  // Create leadership page
  _professional_website_content_create_leadership_page();

  // Create enhanced contact page
  _professional_website_content_create_contact_page();

  // Create legal pages
  _professional_website_content_create_legal_pages();

  // Create URL aliases for pages
  _professional_website_content_create_url_aliases();

  // Place the professional navigation block
  _professional_website_content_place_navigation_block();

  // Set the home page as the front page
  if ($home_nid) {
    \Drupal::configFactory()->getEditable('system.site')
      ->set('page.front', '/node/' . $home_nid)
      ->save();
    \Drupal::messenger()->addStatus(t('Set Welcome to St. Louis Integration as the front page.'));
  }

  \Drupal::messenger()->addStatus(t('Professional website content has been created successfully.'));
}

/**
 * Create the Welcome to St. Louis Integration home page.
 */
function _professional_website_content_create_home_page() {
  $home_content = '
<div class="hero-section text-center py-5 mb-5">
    <div class="container">
        <h1 class="display-4 mb-4">
            Transform Your Business with AI &amp; Automation
        </h1>
        <p class="lead mb-4">
            St. Louis Integration provides cutting-edge technology solutions to help businesses automate processes, integrate AI capabilities, and achieve digital transformation.
        </p>
    </div>
</div>
<div class="container">
    <div class="row mb-5">
        <div class="col-md-4 text-center mb-4">
            <div class="feature-box p-4">
                <h3>
                    AI Integration
                </h3>
                <p>
                    Leverage artificial intelligence to automate tasks, improve decision-making, and enhance customer experiences.
                </p>
            </div>
        </div>
        <div class="col-md-4 text-center mb-4">
            <div class="feature-box p-4">
                <h3>
                    System Integration
                </h3>
                <p>
                    Connect disparate systems and streamline your business processes for maximum efficiency.
                </p>
            </div>
        </div>
        <div class="col-md-4 text-center mb-4">
            <div class="feature-box p-4">
                <h3>
                    Digital Transformation
                </h3>
                <p>
                    Modernize your business with comprehensive digital transformation strategies and implementation.
                </p>
            </div>
        </div>
    </div>
</div>';

  $home_node = \Drupal::entityTypeManager()
    ->getStorage('node')
    ->create([
      'type' => 'page',
      'title' => 'Welcome to St. Louis Integration',
      'body' => [
        'value' => $home_content,
        'format' => 'full_html',
      ],
      'status' => 1,
      'uid' => 1,
    ]);
  $home_node->save();
  
  return $home_node->id();
}

/**
 * Get the comprehensive resume data (54k+ characters).
 */
function _professional_website_content_get_resume_data() {
  return '
<h2>Senior Technology Integration Consultant</h2>

<h3>Professional Summary</h3>
<p>Senior technology consultant with 15+ years of experience delivering enterprise AI, automation, and digital transformation solutions across Financial Services, Healthcare, and Energy sectors. Proven track record of driving operational efficiency improvements of 30%+ and cost savings exceeding $50M through strategic technology implementations.</p>

<h3>Core Competencies</h3>
<ul>
<li><strong>AI & Machine Learning:</strong> Deep learning models, predictive analytics, natural language processing, computer vision</li>
<li><strong>Financial Technology:</strong> Trading algorithms, fraud detection systems, risk management platforms, regulatory compliance</li>
<li><strong>Healthcare Technology:</strong> Clinical trial management, patient data analytics, regulatory compliance systems</li>
<li><strong>Energy & Logistics:</strong> Supply chain optimization, demand forecasting, resource allocation algorithms</li>
<li><strong>Enterprise Architecture:</strong> Cloud-native solutions, microservices, API integration, data architecture</li>
<li><strong>Project Leadership:</strong> Cross-functional team management, stakeholder engagement, agile methodologies</li>
</ul>

<h3>Major Client Engagements</h3>

<h4>Citigroup - Global Investment Banking Division</h4>
<p><strong>Role:</strong> Lead AI Consultant | <strong>Duration:</strong> 18 months | <strong>Team Size:</strong> 12</p>
<p><strong>Project:</strong> Implemented next-generation algorithmic trading platform with machine learning-enhanced risk management capabilities.</p>
<ul>
<li>Designed and deployed real-time fraud detection system processing 500K+ transactions daily</li>
<li>Developed predictive analytics models achieving 94% accuracy in risk assessment</li>
<li>Led integration of AI-powered portfolio optimization tools reducing trading losses by 23%</li>
<li>Implemented automated compliance monitoring system ensuring regulatory adherence across 15 jurisdictions</li>
<li><strong>Business Impact:</strong> Generated $12M annual cost savings, reduced compliance violations by 87%</li>
</ul>

<h4>MasterCard - Global Processing Network</h4>
<p><strong>Role:</strong> Senior Technology Consultant | <strong>Duration:</strong> 14 months | <strong>Team Size:</strong> 8</p>
<p><strong>Project:</strong> Enhanced global payment processing infrastructure with advanced fraud prevention and real-time analytics.</p>
<ul>
<li>Architected distributed fraud detection system processing 2.3B transactions monthly</li>
<li>Implemented machine learning models reducing false positive fraud alerts by 45%</li>
<li>Designed real-time decisioning engine with sub-100ms response times</li>
<li>Led migration to cloud-native architecture supporting 99.99% uptime SLA</li>
<li><strong>Business Impact:</strong> Prevented $18M in fraudulent transactions, improved customer satisfaction scores by 32%</li>
</ul>

<h4>Signant Health - Clinical Trial Technology</h4>
<p><strong>Role:</strong> Healthcare Technology Lead | <strong>Duration:</strong> 24 months | <strong>Team Size:</strong> 15</p>
<p><strong>Project:</strong> Modernized clinical trial management platform serving 700+ active studies across pharmaceutical and biotech clients.</p>
<ul>
<li>Developed AI-powered patient recruitment and retention optimization system</li>
<li>Implemented predictive analytics for clinical endpoint analysis and trial success probability</li>
<li>Built comprehensive data visualization platform for real-time trial monitoring</li>
<li>Designed automated regulatory reporting system ensuring FDA/EMA compliance</li>
<li><strong>Business Impact:</strong> Reduced average trial duration by 28%, increased patient retention by 35%, supported $2.1B in drug approvals</li>
</ul>

<h4>AmeriGas UGI - Energy Distribution Network</h4>
<p><strong>Role:</strong> Supply Chain Technology Consultant | <strong>Duration:</strong> 12 months | <strong>Team Size:</strong> 6</p>
<p><strong>Project:</strong> Optimized propane distribution network through AI-driven demand forecasting and logistics optimization.</p>
<ul>
<li>Developed machine learning models for seasonal demand prediction with 89% accuracy</li>
<li>Implemented route optimization algorithms reducing delivery costs by 22%</li>
<li>Built inventory management system preventing stockouts while minimizing carrying costs</li>
<li>Created predictive maintenance platform for delivery fleet optimization</li>
<li><strong>Business Impact:</strong> Achieved $4.2M annual cost savings, improved delivery efficiency by 31%</li>
</ul>

<h4>NRG Energy - Grid Modernization Initiative</h4>
<p><strong>Role:</strong> Energy Technology Advisor | <strong>Duration:</strong> 16 months | <strong>Team Size:</strong> 10</p>
