{#
/**
 * @file
 * AmISafe Crime Map template.
 *
 * Available variables:
 * - map_config: Configuration for the map
 * - crime_types: Available crime types for filtering
 * - districts: Police districts
 * - date_range: Available date range
 */
#}

<div class="amisafe-crime-map-page">
  <div class="page-header">
    <div class="container">
      <h1 class="page-title">Philadelphia Crime Map</h1>
      <p class="page-subtitle">Interactive crime data visualization and analysis</p>
    </div>
  </div>

  <div class="crime-map-layout">
    <div class="crime-map-controls">
      <div class="control-section">
        <h3>Map Filters</h3>
        
        <!-- Crime Type Multi-Select Filter -->
        <div class="form-group">
          <label class="form-label" for="crime-type-selector">Crime Types</label>
          <select id="crime-type-selector" class="form-control form-select" multiple>
            <!-- Dynamically populated from API -->
          </select>
          <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
        </div>
        
        <!-- District Multi-Select Filter -->
        <div class="form-group">
          <label class="form-label" for="district-selector">Police Districts</label>
          <select id="district-selector" class="form-control form-select" multiple>
            <!-- Dynamically populated from API -->
          </select>
          <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
        </div>
        
        <!-- Date Range Selector -->
        <div class="form-group">
          <label class="form-label">Date Range</label>
          <div class="date-range-container">
            <div class="row">
              <div class="col-6">
                <label class="form-label small" for="start-date">From Date</label>
                <input type="date" id="start-date" class="form-control" 
                       min="2006-01-01" max="2025-12-31" value="2006-01-01">
              </div>
              <div class="col-6">
                <label class="form-label small" for="end-date">To Date</label>
                <input type="date" id="end-date" class="form-control" 
                       min="2006-01-01" max="2025-12-31" value="2025-12-31">
              </div>
            </div>
            <div class="date-presets mt-2">
              <small class="text-muted d-block mb-1">Quick Presets:</small>
              <div class="btn-group btn-group-sm w-100" role="group">
                <button type="button" class="btn btn-outline-secondary" id="preset-last-month">Last Month</button>
                <button type="button" class="btn btn-outline-secondary" id="preset-last-year">Last Year</button>
                <button type="button" class="btn btn-outline-secondary" id="preset-all-time">All Time</button>
              </div>
            </div>
          </div>
        </div>
        
      </div>
      
      <div class="control-section">
        <h3>Time Filters</h3>
        
        <!-- Time of Day Filter -->
        <div class="form-group">
          <label class="form-label" for="time-period-selector">Time of Day</label>
          <select id="time-period-selector" class="form-control form-select" multiple>
            <option value="early-morning" selected>Early Morning (00:00-05:59)</option>
            <option value="morning" selected>Morning (06:00-11:59)</option>
            <option value="afternoon" selected>Afternoon (12:00-17:59)</option>
            <option value="evening" selected>Evening (18:00-23:59)</option>
          </select>
          <small class="text-muted">Select time periods to include</small>
        </div>
        
        <!-- Quick Filter Presets -->
        <div class="form-group">
          <label class="form-label">Quick Presets</label>
          <div class="d-grid gap-2">
            <button id="preset-violent" class="btn btn-outline-primary btn-sm" data-preset="violent">Violent Crimes</button>
            <button id="preset-property" class="btn btn-outline-primary btn-sm" data-preset="property">Property Crimes</button>
            <button id="preset-recent" class="btn btn-outline-primary btn-sm" data-preset="recent">Recent (30 Days)</button>
          </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="d-grid gap-2">
          <button id="apply-filters" class="btn btn-primary">Apply Filters</button>
          <button id="clear-filters" class="btn btn-secondary">Clear All</button>
        </div>
        
      </div>
      
      <div class="control-section">
        <h3>Display Options</h3>
        
        <!-- View Options -->
        <div class="form-group">
          <label class="form-label">Display Mode</label>
          <div class="btn-group w-100" role="group">
            <button id="hexagon-view" class="btn btn-outline-primary active">Hexagon</button>
            <button id="heatmap-view" class="btn btn-outline-primary">Heatmap</button>
            <button id="points-view" class="btn btn-outline-primary">Points</button>
          </div>
        </div>

        <!-- Map Controls -->
        <div class="form-group">
          <button id="fit-hexagons-btn" class="btn btn-outline-secondary w-100">📍 Center on Data</button>
        </div>
      </div>
      
      <!-- Statistics Panel -->
      <div class="stats-panel">
        
        <!-- Stats Summary -->
        <h4>Philadelphia Crime Statistics</h4>
        
        <!-- Citywide Overview -->
        <div class="stats-grid">
          <div class="stat-item">
            <span id="citywide-total" class="stat-value">Loading...</span>
            <span class="stat-label">Total Citywide</span>
          </div>
          <div class="stat-item">
            <span id="citywide-districts" class="stat-value">Loading...</span>
            <span class="stat-label">Districts</span>
          </div>
          <div class="stat-item">
            <span id="active-sectors" class="stat-value">Loading...</span>
            <span class="stat-label">Active Sectors</span>
          </div>
          <div class="stat-item">
            <span id="total-incidents" class="stat-value">0</span>
            <span class="stat-label">Visible Incidents</span>
          </div>
        </div>
      </div>
    </div>
    
    <div class="crime-map-container">
      <!-- Loading Overlay -->
      <div id="loading-overlay" class="loading-overlay" style="display: none;">
        <div class="loading-spinner"></div>
        <div class="loading-text">Loading crime data...</div>
      </div>
      
      <!-- This is the main container the JavaScript expects -->
      <div id="crime-map-container"></div>
      
      <!-- Map Controls -->
      <div class="map-controls">
        <div class="resolution-indicator">
          <span class="zoom-label">ZOOM:</span>
          <span id="zoom-level">12</span>
          <span class="resolution-label">H3:</span>
          <span class="resolution-value" id="h3-resolution">6</span>
          <span class="scale-label">~36km² city areas</span>
          <button id="refresh-zoom" class="btn btn-sm btn-outline-secondary">REFRESH</button>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Expandable Analytics Dashboard -->
  <div class="analytics-section">
    <button id="toggle-analytics" class="btn btn-outline-primary section-toggle">
      <span class="toggle-text">Show Analytics</span>
      <i class="fas fa-chevron-down toggle-icon"></i>
    </button>
    
    <div id="analytics-dashboard" class="analytics-dashboard collapsed">
      <div class="analytics-grid">
        <div class="chart-container">
          <h4 class="chart-title">Temporal Analysis</h4>
          <canvas id="crime-trend-chart"></canvas>
        </div>
        
        <div class="chart-container">
          <h4 class="chart-title">Pattern Matrix</h4>
          <div id="time-pattern-heatmap"></div>
        </div>
        
        <div class="chart-container">
          <h4 class="chart-title">District Rankings</h4>
          <div id="district-rankings-table"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Incident Details Modal -->
<div id="incident-modal" class="modal fade">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">Incident Analysis</h3>
        <button class="btn-close modal-close" aria-label="Close">&times;</button>
      </div>
      <div class="modal-body">
        <div id="incident-details"></div>
      </div>
    </div>
  </div>
</div>