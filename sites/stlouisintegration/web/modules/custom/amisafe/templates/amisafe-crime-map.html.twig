{#
/**
 * @file
 * AmISafe Crime Map template.
 *
 * Available variables:
 * - map_config: Configuration for the map
 * - crime_types: Available crime types for filtering
 * - districts: Police districts
 * - date_range: Available date range
 */
#}

<div class="amisafe-crime-map-page">
  <div class="page-header">
    <div class="container">
      <h1 class="page-title">Philadelphia Crime Map</h1>
      <p class="page-subtitle">Interactive crime data visualization and analysis</p>
    </div>
  </div>

  <div class="crime-map-layout">
    <div class="crime-map-controls">
      <!-- Map Controls -->
      <div class="control-section">
        <div class="form-group">
          <button id="fit-hexagons-btn" class="btn btn-outline-secondary w-100">📍 Center on Data</button>
        </div>
      </div>
      
      <div class="control-section">
        <h3>Map Filters</h3>
        
        <!-- Crime Type Multi-Select Filter -->
        <div class="form-group">
          <label class="form-label" for="crime-type-selector">Crime Types</label>
          <select id="crime-type-selector" class="form-control form-select" multiple>
            <!-- Dynamically populated from API -->
          </select>
          <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
        </div>
        

        
        <!-- Date Range Selector -->
        <div class="form-group">
          <label class="form-label">Date Range</label>
          <div class="date-range-container">
            <div class="row">
              <div class="col-6">
                <label class="form-label small" for="start-date">From Date</label>
                <input type="date" id="start-date" class="form-control" 
                       min="2006-01-01" max="2025-12-31" value="2006-01-01">
              </div>
              <div class="col-6">
                <label class="form-label small" for="end-date">To Date</label>
                <input type="date" id="end-date" class="form-control" 
                       min="2006-01-01" max="2025-12-31" value="2025-12-31">
              </div>
            </div>
            <div class="date-presets mt-2">
              <small class="text-muted d-block mb-1">Quick Presets:</small>
              <div class="btn-group btn-group-sm w-100" role="group">
                <button type="button" class="btn btn-outline-secondary" id="preset-last-month">Last Month</button>
                <button type="button" class="btn btn-outline-secondary" id="preset-last-year">Last Year</button>
                <button type="button" class="btn btn-outline-secondary" id="preset-all-time">All Time</button>
              </div>
            </div>
          </div>
        </div>
        
        
        <!-- Action Buttons -->
        <div class="d-grid gap-2">
          <button id="apply-filters" class="btn btn-primary">Apply Filters</button>
          <button id="clear-filters" class="btn btn-secondary">Clear All</button>
        </div>
        
      </div>
      
      <!-- Statistics Panel -->
      <div class="stats-panel">
        
        <!-- Stats Summary -->
        <h4>Philadelphia Crime Statistics</h4>
        
        <!-- Citywide Overview -->
        <div class="stats-grid">
          <div class="stat-item">
            <span id="citywide-total" class="stat-value">Loading...</span>
            <span class="stat-label">All City Wide</span>
          </div>
          <div class="stat-item">
            <span id="total-incidents" class="stat-value">0</span>
            <span class="stat-label">Total Visible</span>
          </div>
          <div class="stat-item">
            <span id="violent-crimes" class="stat-value">0</span>
            <span class="stat-label">Violent Crimes</span>
          </div>
          <div class="stat-item">
            <span id="property-crimes" class="stat-value">0</span>
            <span class="stat-label">Property Crimes</span>
          </div>
        </div>
      </div>
    </div>
    
    <div class="crime-map-container">
      <!-- Loading Overlay -->
      <div id="loading-overlay" class="loading-overlay" style="display: none;">
        <div class="loading-spinner"></div>
        <div class="loading-text">Loading crime data...</div>
      </div>
      
      <!-- This is the main container the JavaScript expects -->
      <div id="crime-map-container"></div>
      
      <!-- Map Controls -->
      <div class="map-controls">
        <div class="resolution-indicator">
          <span class="zoom-label">ZOOM:</span>
          <span id="zoom-level">12</span>
          <span class="resolution-label">H3:</span>
          <button id="h3-decrease" class="btn btn-xs btn-outline-secondary" title="Decrease H3 Resolution (Larger Hexagons)">−</button>
          <span class="resolution-value" id="h3-resolution">6</span>
          <button id="h3-increase" class="btn btn-xs btn-outline-secondary" title="Increase H3 Resolution (Smaller Hexagons)">+</button>
          <span class="scale-label" id="h3-scale-label">~36km² city areas</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Incident Details Modal -->
<div id="incident-modal" class="modal fade">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">Incident Analysis</h3>
        <button class="btn-close modal-close" aria-label="Close">&times;</button>
      </div>
      <div class="modal-body">
        <div id="incident-details"></div>
      </div>
    </div>
  </div>
</div>