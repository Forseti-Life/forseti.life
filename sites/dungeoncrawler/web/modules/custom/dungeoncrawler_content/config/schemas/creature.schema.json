{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.life/schemas/creature.schema.json",
  "title": "Creature Schema",
  "description": "A creature living in the dungeon — monster, NPC, or beast. Has AI-driven personality, goals, and PF2e-compatible combat statistics. Permanent creatures die forever; respawning creatures return after a cooldown.",
  "type": "object",
  "required": ["creature_id", "name", "level", "creature_type", "pf2e_stats", "ai_personality", "lifecycle"],
  "properties": {
    "creature_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "description": "Display name. AI-generated creatures get unique names.",
      "examples": ["Gribbles Rindsworth the Magnificent", "Skullgnaw the Hungering"]
    },
    "title": {
      "type": ["string", "null"],
      "description": "Optional title/epithet.",
      "examples": ["the Magnificent", "Guardian of the Fungal Pantry"]
    },
    "level": {
      "type": "integer",
      "minimum": -1,
      "maximum": 25,
      "description": "PF2e creature level. Determines stats, DCs, and XP reward."
    },
    "creature_type": {
      "type": "string",
      "enum": [
        "aberration", "animal", "astral", "beast", "celestial",
        "construct", "dragon", "dream", "elemental", "ethereal",
        "fey", "fiend", "fungus", "giant", "humanoid", "monitor",
        "ooze", "plant", "spirit", "undead"
      ],
      "description": "PF2e creature type (trait)."
    },
    "traits": {
      "type": "array",
      "items": { "type": "string" },
      "description": "PF2e traits (e.g., ['Goblin', 'Humanoid', 'Small'])."
    },
    "alignment": {
      "type": "string",
      "enum": ["LG", "NG", "CG", "LN", "N", "CN", "LE", "NE", "CE"],
      "description": "Alignment (pre-Remaster legacy support)."
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "unique"],
      "default": "common"
    },
    "size": {
      "type": "string",
      "enum": ["tiny", "small", "medium", "large", "huge", "gargantuan"],
      "description": "PF2e size category. Determines hex occupation: tiny/small/medium=1, large=3-4, huge=7, gargantuan=12+."
    },
    "hex_footprint": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of hexes this creature occupies."
    },
    "pf2e_stats": {
      "type": "object",
      "description": "Full PF2e-compatible stat block.",
      "required": ["ability_scores", "hp", "ac", "saves", "perception", "speed"],
      "properties": {
        "ability_scores": {
          "type": "object",
          "properties": {
            "strength": { "$ref": "#/definitions/ability_score" },
            "dexterity": { "$ref": "#/definitions/ability_score" },
            "constitution": { "$ref": "#/definitions/ability_score" },
            "intelligence": { "$ref": "#/definitions/ability_score" },
            "wisdom": { "$ref": "#/definitions/ability_score" },
            "charisma": { "$ref": "#/definitions/ability_score" }
          }
        },
        "hp": {
          "type": "object",
          "properties": {
            "max": { "type": "integer" },
            "current": { "type": "integer" },
            "temporary": { "type": "integer", "default": 0 },
            "hardness": { "type": "integer", "default": 0 },
            "immunities": { "type": "array", "items": { "type": "string" } },
            "resistances": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "value": { "type": "integer" }
                }
              }
            },
            "weaknesses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "value": { "type": "integer" }
                }
              }
            }
          }
        },
        "ac": { "type": "integer" },
        "saves": {
          "type": "object",
          "properties": {
            "fortitude": { "$ref": "#/definitions/save" },
            "reflex": { "$ref": "#/definitions/save" },
            "will": { "$ref": "#/definitions/save" }
          }
        },
        "perception": {
          "type": "object",
          "properties": {
            "modifier": { "type": "integer" },
            "senses": {
              "type": "array",
              "items": { "type": "string" },
              "examples": [["darkvision", "scent (imprecise) 30 feet", "tremorsense 60 feet"]]
            }
          }
        },
        "speed": {
          "type": "object",
          "description": "Movement speeds in feet.",
          "properties": {
            "land": { "type": "integer" },
            "fly": { "type": ["integer", "null"] },
            "swim": { "type": ["integer", "null"] },
            "climb": { "type": ["integer", "null"] },
            "burrow": { "type": ["integer", "null"] }
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "modifier": { "type": "integer" },
              "proficiency": { "type": "string", "enum": ["untrained", "trained", "expert", "master", "legendary"] }
            }
          }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "attacks": {
          "type": "array",
          "items": { "$ref": "#/definitions/attack" }
        },
        "special_abilities": {
          "type": "array",
          "items": { "$ref": "#/definitions/ability" }
        },
        "spells": {
          "type": ["object", "null"],
          "description": "Innate or prepared spells.",
          "properties": {
            "tradition": { "type": "string", "enum": ["arcane", "divine", "occult", "primal"] },
            "type": { "type": "string", "enum": ["innate", "prepared", "spontaneous", "focus"] },
            "dc": { "type": "integer" },
            "attack_modifier": { "type": "integer" },
            "spell_slots": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "slots": { "type": "integer" },
                  "spells": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "ai_personality": {
      "type": "object",
      "description": "AI-driven personality system. Powers NPC dialogue, combat decisions, and inter-creature relationships.",
      "required": ["disposition", "personality_traits", "goals"],
      "properties": {
        "disposition": {
          "type": "string",
          "enum": ["hostile", "unfriendly", "indifferent", "friendly", "helpful"],
          "description": "Default disposition toward unknown adventurers."
        },
        "personality_traits": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Core personality descriptors for AI dialogue generation.",
          "examples": [["Cowardly but cunning", "Obsessed with cheese", "Loyal once bribed"]]
        },
        "goals": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "tertiary": { "type": "string" }
          }
        },
        "fears": {
          "type": "array",
          "items": { "type": "string" }
        },
        "desires": {
          "type": "array",
          "items": { "type": "string" }
        },
        "speech_patterns": {
          "type": "object",
          "properties": {
            "dialect": { "type": "string" },
            "catchphrases": { "type": "array", "items": { "type": "string" } },
            "verbal_tics": { "type": "string" },
            "formality": { "type": "string", "enum": ["crude", "casual", "formal", "archaic", "alien"] }
          }
        },
        "combat_personality": {
          "type": "object",
          "properties": {
            "aggression": { "type": "string", "enum": ["pacifist", "defensive", "cautious", "aggressive", "berserk"] },
            "tactics": { "type": "string", "enum": ["mindless", "instinctive", "basic", "tactical", "strategic", "genius"] },
            "morale": { "type": "string", "enum": ["cowardly", "cautious", "steady", "brave", "fanatical"] },
            "flee_threshold_hp_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "preferred_targets": { "type": "array", "items": { "type": "string" } },
            "preferred_range": { "type": "string", "enum": ["melee", "ranged", "mixed", "flee"] }
          }
        },
        "memory": {
          "type": "array",
          "description": "AI memory of past interactions with players. Grows over time.",
          "items": {
            "type": "object",
            "properties": {
              "event": { "type": "string" },
              "party_id": { "type": "string" },
              "sentiment": { "type": "string", "enum": ["very_negative", "negative", "neutral", "positive", "very_positive"] },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "relationships": {
          "type": "object",
          "description": "Relationships with other creatures in the dungeon.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "creature_id": { "type": "string" },
              "name": { "type": "string" },
              "relationship": { "type": "string" },
              "sentiment": { "type": "string", "enum": ["enemy", "rival", "neutral", "ally", "devoted"] }
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "description": "Creature lifecycle management — permadeath, respawning, wandering.",
      "required": ["spawn_type", "is_alive"],
      "properties": {
        "spawn_type": {
          "type": "string",
          "enum": ["permanent", "respawning", "wandering", "boss", "quest", "summoned"],
          "description": "permanent=dies forever, respawning=returns, wandering=roams between rooms, boss=unique encounter."
        },
        "is_alive": { "type": "boolean", "default": true },
        "death_timestamp": { "type": ["string", "null"], "format": "date-time" },
        "killed_by_party": { "type": ["string", "null"] },
        "respawn_cooldown_hours": { "type": ["number", "null"] },
        "next_respawn_at": { "type": ["string", "null"], "format": "date-time" },
        "home_room_id": { "type": "string", "description": "Room this creature considers home." },
        "current_room_id": { "type": "string", "description": "Room the creature is currently in." },
        "patrol_route": {
          "type": "array",
          "description": "For wandering creatures: ordered list of room IDs they visit.",
          "items": { "type": "string" }
        },
        "wander_radius_rooms": {
          "type": "integer",
          "description": "Maximum rooms from home this creature will wander."
        }
      }
    },
    "loot_table": {
      "type": "object",
      "description": "What this creature drops on death.",
      "properties": {
        "guaranteed": {
          "type": "array",
          "items": { "$ref": "#/definitions/loot_entry" }
        },
        "random": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": { "$ref": "#/definitions/loot_entry" },
              "drop_chance": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "currency": {
          "type": "object",
          "properties": {
            "cp_range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
            "sp_range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
            "gp_range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
          }
        }
      }
    },
    "xp_reward": {
      "type": "integer",
      "description": "XP awarded for defeating this creature. Auto-calculated from PF2e level if omitted."
    }
  },
  "definitions": {
    "ability_score": {
      "type": "object",
      "properties": {
        "score": { "type": "integer" },
        "modifier": { "type": "integer" }
      }
    },
    "save": {
      "type": "object",
      "properties": {
        "modifier": { "type": "integer" },
        "proficiency": { "type": "string", "enum": ["untrained", "trained", "expert", "master", "legendary"] },
        "special": { "type": "string", "description": "E.g., '+1 status bonus vs. magic'" }
      }
    },
    "attack": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["melee", "ranged"] },
        "attack_bonus": { "type": "integer" },
        "damage": { "type": "string", "description": "Damage formula, e.g., '2d8+5'" },
        "damage_type": { "type": "string" },
        "traits": { "type": "array", "items": { "type": "string" } },
        "range_ft": { "type": ["integer", "null"] },
        "reach_ft": { "type": "integer", "default": 5 },
        "effects": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" }
      }
    },
    "ability": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "action_cost": { "type": "string", "enum": ["free", "reaction", "1", "2", "3", "passive"] },
        "traits": { "type": "array", "items": { "type": "string" } },
        "frequency": { "type": "string" },
        "trigger": { "type": "string" },
        "requirements": { "type": "string" },
        "description": { "type": "string" },
        "effect": { "type": "string" }
      }
    },
    "loot_entry": {
      "type": "object",
      "properties": {
        "item_id": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "integer", "default": 1 },
        "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "epic", "legendary"] }
      }
    }
  }
}
