{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.life/schemas/obstacle.schema.json",
  "title": "Obstacle Schema",
  "description": "Map obstacle instance. Obstacles are traversal/combat blockers or modifiers; they are not containers.",
  "type": "object",
  "required": ["obstacle_id", "name", "obstacle_type", "movement"],
  "properties": {
    "obstacle_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "obstacle_type": {
      "type": "string",
      "enum": [
        "trap",
        "hazard",
        "barricade",
        "collapsed_passage",
        "difficult_terrain",
        "magical_barrier",
        "door_mechanism",
        "custom"
      ]
    },
    "description": { "type": "string" },
    "hexes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["q", "r"],
        "properties": {
          "q": { "type": "integer" },
          "r": { "type": "integer" }
        }
      }
    },
    "movement": {
      "type": "object",
      "required": ["passable"],
      "properties": {
        "passable": { "type": "boolean" },
        "cost_multiplier": { "type": "number", "minimum": 0, "default": 1 },
        "requires_check": { "type": "boolean", "default": false },
        "check_skill": { "type": ["string", "null"] },
        "check_dc": { "type": ["integer", "null"] }
      }
    },
    "combat_effect": {
      "type": ["object", "null"],
      "properties": {
        "cover": { "type": "string", "enum": ["none", "lesser", "standard", "greater"] },
        "damage_on_enter": { "type": ["string", "null"], "examples": ["1d6", "2d6+3"] },
        "damage_type": { "type": ["string", "null"] },
        "save_type": { "type": ["string", "null"], "enum": ["fortitude", "reflex", "will", null] },
        "save_dc": { "type": ["integer", "null"] }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "active": { "type": "boolean", "default": true },
        "disabled": { "type": "boolean", "default": false },
        "destroyed": { "type": "boolean", "default": false },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "source_ref": {
      "type": ["object", "null"],
      "description": "Optional reference to underlying trap/hazard definition.",
      "properties": {
        "content_type": { "type": "string", "enum": ["trap", "hazard"] },
        "content_id": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
