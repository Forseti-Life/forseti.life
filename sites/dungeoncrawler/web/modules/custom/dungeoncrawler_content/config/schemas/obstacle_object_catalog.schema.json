{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.life/schemas/obstacle_object_catalog.schema.json",
  "title": "Obstacle Object Catalog Schema",
  "description": "Reusable obstacle object definitions used by placed obstacle entities on dungeon maps.",
  "type": "object",
  "required": ["objects"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional self-reference to this schema URI for editor tooling."
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "object_id",
          "label",
          "category",
          "movable",
          "stackable",
          "movement"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "Stable machine-readable ID (lowercase, digits, underscore)."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Human-friendly name shown on the map UI."
          },
          "category": {
            "type": "string",
            "enum": ["bar", "table", "stool", "crate", "door", "decor", "custom"],
            "description": "Coarse grouping used for styling/filtering."
          },
          "description": {
            "type": ["string", "null"],
            "description": "Optional longer text for tooltips or docs."
          },
          "movable": {
            "type": "boolean",
            "description": "Whether the object can be moved (pushed/lifted/rearranged)."
          },
          "stackable": {
            "type": "boolean",
            "description": "Whether multiple instances can share a hex."
          },
          "movement": {
            "type": "object",
            "required": ["passable", "blocks_movement", "cost_multiplier"],
            "properties": {
              "passable": {
                "type": "boolean",
                "description": "If true, occupants can share the hex without obstruction."
              },
              "blocks_movement": {
                "type": "boolean",
                "description": "If true, pathfinding treats this hex as blocked unless interacted with."
              },
              "cost_multiplier": {
                "type": "number",
                "minimum": 0,
                "default": 1,
                "description": "Movement cost multiplier for entering this hex (1 = normal)."
              }
            },
            "additionalProperties": false,
            "description": "Traversal characteristics for this object."
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional freeform tags for filtering and UI chips."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
