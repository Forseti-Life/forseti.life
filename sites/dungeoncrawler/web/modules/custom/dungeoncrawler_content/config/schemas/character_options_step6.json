{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.life/schemas/character_options_step6.json",
  "title": "Character Creation Step 6: Alignment & Deity",
  "description": "Defines options for selecting character's moral alignment and deity (optional) in Pathfinder 2E character creation",
  "type": "object",
  "properties": {
    "step": {
      "type": "integer",
      "const": 6,
      "description": "Step number in character creation process"
    },
    "step_name": {
      "type": "string",
      "const": "Alignment & Deity",
      "description": "Human-readable name for this step"
    },
    "step_description": {
      "type": "string",
      "const": "Define your character's moral and ethical perspective through alignment, and optionally choose a deity they worship.",
      "description": "Explanation of what happens in this step"
    },
    "fields": {
      "type": "object",
      "description": "Form fields available in this step",
      "properties": {
        "alignment": {
          "type": "object",
          "description": "Alignment selection field",
          "properties": {
            "field_type": {
              "type": "string",
              "const": "select",
              "description": "HTML input type"
            },
            "label": {
              "type": "string",
              "const": "Choose Your Alignment",
              "description": "Field label"
            },
            "required": {
              "type": "boolean",
              "const": true,
              "description": "Whether this field is mandatory"
            },
            "options": {
              "type": "array",
              "description": "Available alignments in Pathfinder 2E",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": ["LG", "NG", "CG", "LN", "N", "CN", "LE", "NE", "CE"]
                  },
                  "name": {
                    "type": "string",
                    "enum": ["Lawful Good", "Neutral Good", "Chaotic Good", "Lawful Neutral", "Neutral", "Chaotic Neutral", "Lawful Evil", "Neutral Evil", "Chaotic Evil"]
                  },
                  "description": {
                    "type": "string",
                    "description": "Explanation of the alignment"
                  }
                },
                "required": ["id", "name", "description"]
              },
              "minItems": 9,
              "maxItems": 9,
              "default": [
                {
                  "id": "LG",
                  "name": "Lawful Good",
                  "description": "Acts with compassion and honor within the bounds of law and order."
                },
                {
                  "id": "NG",
                  "name": "Neutral Good",
                  "description": "Does good without bias toward or against order, helping others as needed."
                },
                {
                  "id": "CG",
                  "name": "Chaotic Good",
                  "description": "Acts with freedom and kindness, following conscience over rules."
                },
                {
                  "id": "LN",
                  "name": "Lawful Neutral",
                  "description": "Values tradition, order, and hierarchy above morality."
                },
                {
                  "id": "N",
                  "name": "Neutral",
                  "description": "Avoids moral extremes and seeks balance or personal interest."
                },
                {
                  "id": "CN",
                  "name": "Chaotic Neutral",
                  "description": "Follows individual freedom and impulse without regard for tradition or others."
                },
                {
                  "id": "LE",
                  "name": "Lawful Evil",
                  "description": "Uses tradition and order as tools for exploitation and control."
                },
                {
                  "id": "NE",
                  "name": "Neutral Evil",
                  "description": "Acts selfishly with no regard for others, unbound by law or chaos."
                },
                {
                  "id": "CE",
                  "name": "Chaotic Evil",
                  "description": "Driven by greed, hatred, or bloodlust with no restraint or order."
                }
              ]
            },
            "help_text": {
              "type": "string",
              "const": "Alignment represents your character's moral and ethical outlook. It's a guide for roleplaying, not a strict rule. Most adventuring parties work best with good or neutral alignments.",
              "description": "Helper text displayed to user"
            },
            "validation": {
              "type": "object",
              "properties": {
                "required": {
                  "type": "boolean",
                  "const": true
                },
                "class_restrictions": {
                  "type": "object",
                  "description": "Some classes restrict alignment choices",
                  "properties": {
                    "champion": {
                      "type": "array",
                      "description": "Champions must follow their deity's alignment",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "error_message": {
                  "type": "string",
                  "const": "Please select an alignment before continuing."
                }
              }
            }
          },
          "required": ["field_type", "label", "required", "options", "help_text", "validation"]
        },
        "deity": {
          "type": "object",
          "description": "Deity selection field (optional except for clerics and champions)",
          "properties": {
            "field_type": {
              "type": "string",
              "const": "select",
              "description": "HTML input type"
            },
            "label": {
              "type": "string",
              "const": "Choose a Deity (Optional)",
              "description": "Field label"
            },
            "required": {
              "type": "boolean",
              "const": false,
              "description": "Optional for most classes, required for clerics and champions"
            },
            "conditional": {
              "type": "object",
              "description": "Required if character is a cleric or champion",
              "properties": {
                "required_for_classes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["cleric", "champion"]
                  }
                }
              }
            },
            "options": {
              "type": "array",
              "description": "Common Pathfinder 2E deities",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "alignment": {
                    "type": "string",
                    "description": "Deity's alignment"
                  },
                  "domains": {
                    "type": "array",
                    "description": "Divine domains",
                    "items": {
                      "type": "string"
                    }
                  },
                  "favored_weapon": {
                    "type": "string",
                    "description": "Deity's favored weapon"
                  },
                  "description": {
                    "type": "string",
                    "description": "Brief description of deity's portfolio"
                  }
                },
                "required": ["id", "name", "alignment", "description"]
              },
              "examples": [
                {
                  "id": "iomedae",
                  "name": "Iomedae",
                  "alignment": "LG",
                  "domains": ["duty", "might", "zeal"],
                  "favored_weapon": "Longsword",
                  "description": "Goddess of justice, honor, and righteous valor"
                },
                {
                  "id": "sarenrae",
                  "name": "Sarenrae",
                  "alignment": "NG",
                  "domains": ["fire", "healing", "sun"],
                  "favored_weapon": "Scimitar",
                  "description": "Goddess of healing, redemption, and the sun"
                },
                {
                  "id": "desna",
                  "name": "Desna",
                  "alignment": "CG",
                  "domains": ["dreams", "luck", "moon", "travel"],
                  "favored_weapon": "Starknife",
                  "description": "Goddess of dreams, stars, travelers, and luck"
                },
                {
                  "id": "abadar",
                  "name": "Abadar",
                  "alignment": "LN",
                  "domains": ["cities", "earth", "travel", "wealth"],
                  "favored_weapon": "Crossbow",
                  "description": "God of cities, law, merchants, and wealth"
                },
                {
                  "id": "gozreh",
                  "name": "Gozreh",
                  "alignment": "N",
                  "domains": ["air", "nature", "travel", "water"],
                  "favored_weapon": "Trident",
                  "description": "Deity of nature, the sea, and weather"
                },
                {
                  "id": "cayden_cailean",
                  "name": "Cayden Cailean",
                  "alignment": "CG",
                  "domains": ["ale", "cities", "freedom", "might"],
                  "favored_weapon": "Rapier",
                  "description": "God of freedom, ale, wine, and bravery"
                },
                {
                  "id": "none",
                  "name": "No Deity",
                  "alignment": "Any",
                  "description": "Character does not worship a specific deity"
                }
              ]
            },
            "help_text": {
              "type": "string",
              "const": "Clerics and Champions must choose a deity, as their powers come from divine worship. Other classes may choose to worship a deity for roleplay purposes.",
              "description": "Helper text displayed to user"
            },
            "validation": {
              "type": "object",
              "properties": {
                "required_for_classes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": ["cleric", "champion"]
                },
                "alignment_compatibility": {
                  "type": "boolean",
                  "const": true,
                  "description": "Character alignment must be within one step of deity alignment"
                },
                "error_message": {
                  "type": "string",
                  "const": "Clerics and Champions must choose a deity. Your alignment must be within one step of your deity's alignment."
                }
              }
            }
          },
          "required": ["field_type", "label", "required", "options", "help_text", "validation"]
        }
      },
      "required": ["alignment", "deity"]
    },
    "navigation": {
      "type": "object",
      "description": "Navigation rules for this step",
      "properties": {
        "previous_step": {
          "type": "integer",
          "const": 5,
          "description": "Previous step number"
        },
        "next_step": {
          "type": "integer",
          "const": 7,
          "description": "Next step number"
        },
        "can_go_back": {
          "type": "boolean",
          "const": true,
          "description": "User can return to previous step"
        },
        "can_skip": {
          "type": "boolean",
          "const": false,
          "description": "Step cannot be skipped"
        }
      },
      "required": ["previous_step", "next_step", "can_go_back", "can_skip"]
    },
    "tips": {
      "type": "array",
      "description": "Helpful tips for new players",
      "items": {
        "type": "string"
      },
      "default": [
        "Alignment is a roleplaying tool, not a straitjacket. Your character can act in complex ways within their alignment.",
        "Evil alignments are generally not recommended for new players or most campaigns.",
        "Your deity choice can unlock special abilities and flavor for divine characters.",
        "Clerics can use their deity's favored weapon with proficiency, even if it's normally outside their class proficiencies.",
        "You can change alignment during play if your character's actions consistently reflect a different worldview."
      ]
    }
  },
  "required": ["step", "step_name", "step_description", "fields", "navigation", "tips"]
}
