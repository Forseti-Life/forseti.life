{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeoncrawler.life/schemas/campaign.schema.json",
  "title": "Campaign Schema",
  "description": "Canonical JSON structure for campaign state stored in dc_campaigns.campaign_data.",
  "type": "object",
  "required": ["created_by", "started", "progress"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Optional schema version for migration compatibility.",
      "default": "1.0.0"
    },
    "created_by": {
      "type": "integer",
      "minimum": 1,
      "description": "Drupal user ID that created the campaign."
    },
    "started": {
      "type": "boolean",
      "description": "Whether the campaign has started."
    },
    "progress": {
      "type": "array",
      "description": "Ordered campaign progress markers/events.",
      "items": {
        "type": "object",
        "required": ["type", "timestamp"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Progress event type."
          },
          "timestamp": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp when this event was recorded."
          },
          "payload": {
            "type": ["object", "array", "string", "number", "boolean", "null"],
            "description": "Optional event-specific details."
          }
        },
        "additionalProperties": true
      }
    },
    "active_hex": {
      "type": "string",
      "description": "Current hex location key, if any."
    },
    "metadata": {
      "type": "object",
      "description": "Optional campaign metadata.",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
