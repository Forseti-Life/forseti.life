/**
 * Development-only table consolidation to a single dc_campaign_characters table.
 *
 * This update intentionally ignores existing row contents and can drop data.
 */
function dungeoncrawler_content_update_10007() {
  $schema = dungeoncrawler_content_schema();
  $database = \Drupal::database();
  $schema_handler = $database->schema();
  $messages = [];

  try {
    if (!$schema_handler->tableExists('dc_campaign_characters')) {
      $schema_handler->createTable('dc_campaign_characters', $schema['dc_campaign_characters']);
      $messages[] = 'Created dc_campaign_characters table.';
    }

    $fields_to_add = [
      'uuid',
      'name',
      'level',
      'ancestry',
      'class',
      'character_data',
      'default_character_data',
      'default_locations',
      'portrait',
      'status',
      'created',
      'changed',
    ];

    foreach ($fields_to_add as $field) {
      if (!$schema_handler->fieldExists('dc_campaign_characters', $field)) {
        $schema_handler->addField('dc_campaign_characters', $field, $schema['dc_campaign_characters']['fields'][$field]);
        $messages[] = 'Added dc_campaign_characters.' . $field;
      }
    }

    $indexes = ['name', 'status', 'ancestry', 'class'];
    foreach ($indexes as $index) {
      if (!$schema_handler->indexExists('dc_campaign_characters', $index)) {
        $schema_handler->addIndex('dc_campaign_characters', $index, [$index], $schema['dc_campaign_characters']);
        $messages[] = 'Added index dc_campaign_characters.' . $index;
      }
    }

    if ($schema_handler->tableExists('dc_characters')) {
      $schema_handler->dropTable('dc_characters');
      $messages[] = 'Dropped dc_characters table.';
    }

    if (empty($messages)) {
      return t('Character table consolidation already applied.');
    }

    return t('Character table consolidation complete: @messages', ['@messages' => implode(' ', $messages)]);
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Update 10007 failed: @error', ['@error' => $e->getMessage()]);
    throw new \Drupal\Core\Utility\UpdateException('Failed to consolidate character tables: ' . $e->getMessage());
  }
}

/**
 * Add hybrid hot columns for character/campaign creation and runtime updates.
 */
function dungeoncrawler_content_update_10008() {
  $schema = dungeoncrawler_content_schema();
  $database = \Drupal::database();
  $schema_handler = $database->schema();
  $messages = [];

  try {
    $fields_to_add = [
      'hp_current',
      'hp_max',
      'armor_class',
      'experience_points',
      'position_q',
      'position_r',
      'last_room_id',
    ];

    foreach ($fields_to_add as $field) {
      if (!$schema_handler->fieldExists('dc_campaign_characters', $field)) {
        $schema_handler->addField('dc_campaign_characters', $field, $schema['dc_campaign_characters']['fields'][$field]);
        $messages[] = 'Added dc_campaign_characters.' . $field;
      }
    }

    foreach (['hp_current', 'experience_points'] as $index) {
      if (!$schema_handler->indexExists('dc_campaign_characters', $index)) {
        $schema_handler->addIndex('dc_campaign_characters', $index, [$index], $schema['dc_campaign_characters']);
        $messages[] = 'Added index dc_campaign_characters.' . $index;
      }
    }

    if (empty($messages)) {
      return t('Hybrid hot columns already present.');
    }

    return t('Hybrid hot-column update complete: @messages', ['@messages' => implode(' ', $messages)]);
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Update 10008 failed: @error', ['@error' => $e->getMessage()]);
    throw new \Drupal\Core\Utility\UpdateException('Failed to add hybrid hot columns: ' . $e->getMessage());
  }
}

/**
 * Migrate combat_participants from Cartesian (x, y) to axial hex (q, r) coordinates.
 */
function dungeoncrawler_content_update_10009() {
  $schema = dungeoncrawler_content_schema();
  $database = \Drupal::database();
  $schema_handler = $database->schema();
  $messages = [];

  try {
    // Check if old columns exist
    $has_x = $schema_handler->fieldExists('combat_participants', 'position_x');
    $has_y = $schema_handler->fieldExists('combat_participants', 'position_y');
    $has_q = $schema_handler->fieldExists('combat_participants', 'position_q');
    $has_r = $schema_handler->fieldExists('combat_participants', 'position_r');

    // If new columns already exist and old ones don't, migration already done
    if ($has_q && $has_r && !$has_x && !$has_y) {
      return t('Axial hex coordinates already in place for combat_participants.');
    }

    // Add new columns if they don't exist
    if (!$has_q) {
      $schema_handler->addField('combat_participants', 'position_q', $schema['combat_participants']['fields']['position_q']);
      $messages[] = 'Added position_q column';
    }
    if (!$has_r) {
      $schema_handler->addField('combat_participants', 'position_r', $schema['combat_participants']['fields']['position_r']);
      $messages[] = 'Added position_r column';
    }

    // Migrate data: Assume x=q, y=r for simplicity (1:1 mapping)
    // In production, you may need more sophisticated coordinate conversion
    if ($has_x && $has_y) {
      $database->query('UPDATE {combat_participants} SET position_q = position_x, position_r = position_y WHERE position_q IS NULL OR position_r IS NULL');
      $messages[] = 'Migrated position data from (x, y) to (q, r)';

      // Drop old columns
      $schema_handler->dropField('combat_participants', 'position_x');
      $schema_handler->dropField('combat_participants', 'position_y');
      $messages[] = 'Dropped position_x and position_y columns';
    }

    if (empty($messages)) {
      return t('No migration needed for combat_participants coordinates.');
    }

    return t('Combat participants coordinate migration complete: @messages', ['@messages' => implode(' ', $messages)]);
  }
  catch (\Exception $e) {
    \Drupal::logger('dungeoncrawler_content')->error('Update 10009 failed: @error', ['@error' => $e->getMessage()]);
    throw new \Drupal\Core\Utility\UpdateException('Failed to migrate combat_participants coordinates: ' . $e->getMessage());
  }
}

