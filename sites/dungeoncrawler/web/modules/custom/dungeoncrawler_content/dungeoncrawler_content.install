        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'PF2e class (Fighter, Rogue, Wizard, etc.).',
      ],
      'character_data' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
        'description' => 'Full PF2e character sheet as JSON.',
      ],
