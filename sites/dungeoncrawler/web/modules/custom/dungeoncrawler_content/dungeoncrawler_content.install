    $existing = \Drupal::entityQuery('node')
      ->condition('type', 'character_class')
      ->condition('title', $class_data['name'])
      ->accessCheck(FALSE)
      ->execute();

    if (!empty($existing)) {
      $skipped[] = $class_data['name'];
      continue;
    }

    $node = \Drupal\node\Entity\Node::create([
      'type'   => 'character_class',
      'title'  => $class_data['name'],
      'status' => 1,
      'uid'    => 1,
      'body'   => [
        'value'  => json_encode([
          'id'             => $class_id,
          'description'    => $class_data['description'],
          'key_ability'    => $class_data['key_ability'],
          'hp_per_level'   => $class_data['hp'],
          'proficiencies'  => $class_data['proficiencies'],
          'trained_skills' => $class_data['trained_skills'],
          'weapons'        => $class_data['weapons'],
          'spellcasting'   => $class_data['spellcasting'] ?? null,
        ], JSON_PRETTY_PRINT),
        'format' => 'plain_text',
      ],
    ]);
    $node->save();
    $created[] = $class_data['name'];
  }

  $msg = 'character_class content type seeded.';
  if ($created) {
    $msg .= ' Created: ' . implode(', ', $created) . '.';
  }
  if ($skipped) {
    $msg .= ' Skipped (already exist): ' . implode(', ', $skipped) . '.';
  }
  return t($msg);
}

/**
 * Add version column to dc_campaign_characters for concurrent-edit protection.
 */
function dungeoncrawler_content_update_10019() {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('dc_campaign_characters', 'version')) {
    $schema->addField('dc_campaign_characters', 'version', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Optimistic lock version counter; increments on each save to detect concurrent edits.',
    ]);
  }
  return t('Added version column to dc_campaign_characters for concurrent-edit protection.');
}

/**
 * Create dc_roll_log table for immutable dice roll audit trail.
 */
function dungeoncrawler_content_update_10020() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('dc_roll_log')) {
    $schema->createTable('dc_roll_log', [
      'description' => 'Immutable audit log of dice rolls.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'expression' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => TRUE,
          'default' => '',
          'description' => 'Dice expression rolled (e.g. 2d6+3).',
        ],
        'total' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
          'description' => 'Final roll total.',
        ],
        'character_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => FALSE,
          'description' => 'Optional character ID associated with roll.',
        ],
        'uid' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
          'description' => 'Drupal user ID (0 = anonymous).',
        ],
        'roll_type' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'default' => 'general',
          'description' => 'Roll context: attack, skill, damage, save, initiative, general.',
        ],
        'created' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
          'description' => 'Unix timestamp when roll was made.',
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'character_id' => ['character_id'],
        'uid'          => ['uid'],
        'created'      => ['created'],
      ],
    ]);
  }
  return t('Created dc_roll_log table for dice roll audit trail.');
}

/**
 * Import/refresh all game content from JSON files into content registry.
 *
 * Seeds the dungeoncrawler_content_registry table with all JSON-defined
 * content (items, creatures, traps, hazards). Uses MERGE (upsert) so
 * existing rows are updated and new rows are inserted.
 */
function dungeoncrawler_content_update_10021() {
  /** @var \Drupal\dungeoncrawler_content\Service\ContentRegistry $registry */
  $registry = \Drupal::service('dungeoncrawler_content.content_registry');
  $count = $registry->importContentFromJson();
  return t('Imported/refreshed @count content items from JSON files.', ['@count' => $count]);
}

/**
 * Create dc_ai_sessions table for per-campaign/NPC AI session isolation.
 */
function dungeoncrawler_content_update_10022() {
  $schema = \Drupal::database()->schema();

  if ($schema->tableExists('dc_ai_sessions')) {
    return t('Table dc_ai_sessions already exists.');
  }

  $schema->createTable('dc_ai_sessions', [
    'description' => 'AI conversation sessions scoped per campaign / NPC / encounter.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'session_key' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Dot-separated session key (e.g. campaign.42.npc.goblin_1).',
      ],
      'campaign_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Campaign ID for indexed lookup.',
      ],
      'messages' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
        'description' => 'JSON array of recent message objects [{role, content, timestamp, extra}].',
      ],
      'summary' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
        'description' => 'Rolling summary of older messages.',
      ],
      'metadata' => [
        'type' => 'text',
        'size' => 'normal',
        'not null' => TRUE,
        'description' => 'JSON metadata for the session (NPC name, persona, etc.).',
      ],
      'message_count' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Total messages ever appended (including summarized).',
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'updated' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'session_key' => ['session_key'],
    ],
    'indexes' => [
      'campaign_id' => ['campaign_id'],
      'updated' => ['updated'],
    ],
  ]);

  return t('Created dc_ai_sessions table for per-campaign/NPC AI session isolation.');
}
