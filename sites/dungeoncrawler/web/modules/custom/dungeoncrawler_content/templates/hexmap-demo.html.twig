{#
/**
 * @file
 * Template for the hex map demo page.
 *
 * Available variables:
 * - launch_context: Optional campaign/dungeon launch context from tavern flow.
 * - dungeon_payload: Optional room/entity payload from example level.
 */
#}

<div class="hexmap-container">
  <div class="hexmap-header">
    <h1>{{ 'Hex Map Demo'|t }}</h1>
    <p>{{ 'Interactive hexagonal grid powered by PixiJS'|t }}</p>
    
    <div class="hexmap-controls">
      <div class="control-group">
        <label>{{ 'Grid Size:'|t }}</label>
        <select id="grid-size">
          <option value="small">{{ 'Small (10x10)'|t }}</option>
          <option value="medium" selected>{{ 'Medium (20x20)'|t }}</option>
          <option value="large">{{ 'Large (40x40)'|t }}</option>
        </select>
      </div>
      
      <div class="control-group">
        <label>{{ 'Hex Size:'|t }}</label>
        <input type="range" id="hex-size" min="20" max="60" value="30" />
        <span id="hex-size-value">30px</span>
      </div>
      
      <div class="control-group">
        <button id="toggle-coordinates" class="btn">{{ 'Toggle Coordinates'|t }}</button>
        <button id="toggle-grid" class="btn">{{ 'Toggle Grid Lines'|t }}</button>
        <button id="reset-view" class="btn">{{ 'Reset View'|t }}</button>
      </div>
    </div>
    
    <div class="hexmap-object-palette">
      <h3>{{ 'Object Palette'|t }}</h3>
      <p class="palette-instructions">{{ 'Click an object type, then click a hex to place it. Click entities to select and move them.'|t }}</p>
      <div class="object-buttons">
        <button id="place-creature" class="btn btn-object" data-type="creature">{{ '🐉 Creature'|t }}</button>
        <button id="place-item" class="btn btn-object" data-type="item">{{ '📦 Item'|t }}</button>
        <button id="place-obstacle" class="btn btn-object" data-type="obstacle">{{ '🚧 Obstacle'|t }}</button>
        <button id="clear-objects" class="btn btn-danger">{{ 'Clear All Objects'|t }}</button>
      </div>
      <p id="selected-object-type" class="selected-type">{{ 'Selected: None'|t }}</p>
    </div>
    
    <div class="hexmap-combat-controls">
      <h3>{{ 'Combat Controls'|t }}</h3>
      <div id="combat-controls" class="combat-buttons">
        <button id="start-combat" class="btn btn-success">{{ '⚔️ Start Combat'|t }}</button>
        <button id="end-turn" class="btn btn-primary" style="display:none;">{{ '➡️ End Turn'|t }}</button>
        <button id="end-combat" class="btn btn-warning" style="display:none;">{{ '🛑 End Combat'|t }}</button>
      </div>
      
      <div id="initiative-tracker" class="initiative-tracker" style="display:none;">
        <div class="tracker-header">
          <h4>{{ 'Initiative Order'|t }}</h4>
          <span id="current-round" class="round-display">{{ 'Round 0'|t }}</span>
        </div>
        <div id="current-turn" class="current-turn-display">
          {{ 'No active turn'|t }}
        </div>
        <div id="initiative-list" class="initiative-list">
          <!-- Initiative order will be populated here -->
        </div>
      </div>
    </div>
  </div>

  <div id="hexmap-canvas-container" class="hexmap-canvas-wrapper">
    <!-- PixiJS canvas will be inserted here -->
  </div>

  <div class="hexmap-info">
    <div class="info-panel">
      <h3>{{ 'Map Info'|t }}</h3>
      <div class="info-content">
        <p><strong>{{ 'Selected Hex:'|t }}</strong> <span id="selected-hex">{{ 'None'|t }}</span></p>
        <p><strong>{{ 'Hovered Hex:'|t }}</strong> <span id="hovered-hex">{{ 'None'|t }}</span></p>
        <p><strong>{{ 'Hovered Object:'|t }}</strong> <span id="hovered-object">{{ 'None'|t }}</span></p>
        <p><strong>{{ 'Zoom Level:'|t }}</strong> <span id="zoom-level">100%</span></p>
      </div>
    </div>

    {% if launch_context and (launch_context.campaign_id or launch_context.room_id or launch_context.dungeon_level_id or launch_context.map_id) %}
      <div class="info-panel">
        <h3>{{ 'Launch Context'|t }}</h3>
        <div class="info-content">
          <p><strong>{{ 'Campaign:'|t }}</strong> {{ launch_context.campaign_id ?: 'n/a' }}</p>
          <p><strong>{{ 'Character:'|t }}</strong> {{ launch_context.character_id ?: 'n/a' }}</p>
          <p><strong>{{ 'Level:'|t }}</strong> {{ launch_context.dungeon_level_id ?: 'n/a' }}</p>
          <p><strong>{{ 'Map:'|t }}</strong> {{ launch_context.map_id ?: 'n/a' }}</p>
          <p><strong>{{ 'Room:'|t }}</strong> {{ launch_context.room_id ?: 'n/a' }}</p>
          <p><strong>{{ 'Next Room:'|t }}</strong> {{ launch_context.next_room_id ?: 'n/a' }}</p>
          <p><strong>{{ 'Start Hex:'|t }}</strong> ({{ launch_context.start_q ?: 0 }}, {{ launch_context.start_r ?: 0 }})</p>
        </div>
      </div>
    {% endif %}

    {% if dungeon_payload and dungeon_payload.active_room_id and dungeon_payload.rooms[dungeon_payload.active_room_id] is defined %}
      <div class="info-panel">
        <h3>{{ 'Active Room'|t }}</h3>
        <div class="info-content">
          <p><strong>{{ 'Room:'|t }}</strong> {{ dungeon_payload.rooms[dungeon_payload.active_room_id].name }}</p>
          <p><strong>{{ 'Room ID:'|t }}</strong> {{ dungeon_payload.active_room_id }}</p>
          <p><strong>{{ 'Hexes:'|t }}</strong> {{ dungeon_payload.rooms[dungeon_payload.active_room_id].hexes|length }}</p>
        </div>
      </div>
    {% endif %}
    
    <div class="info-panel" id="entity-info-panel" style="display:none;">
      <h3>{{ 'Selected Entity'|t }}</h3>
      <div class="info-content">
        <p><strong>{{ 'Name:'|t }}</strong> <span id="entity-name">-</span></p>
        <p><strong>{{ 'Type:'|t }}</strong> <span id="entity-type">-</span></p>
        <p><strong>{{ 'Team:'|t }}</strong> <span id="entity-team">-</span></p>
        <p><strong>{{ 'HP:'|t }}</strong> <span id="entity-hp">-</span></p>
        <p><strong>{{ 'AC:'|t }}</strong> <span id="entity-ac">-</span></p>
        <p><strong>{{ 'Actions:'|t }}</strong> <span id="entity-actions">-</span></p>
        <p><strong>{{ 'Movement:'|t }}</strong> <span id="entity-movement">-</span></p>
      </div>
    </div>
    
    <div class="info-panel">
      <h3>{{ 'Legend'|t }}</h3>
      <div class="info-content">
        <p><span style="display:inline-block;width:18px;height:18px;background:#5b2b2b;border:2px solid #8b3a3a;margin-right:6px;color:#fff;font-size:10px;line-height:14px;text-align:center;">F</span>{{ 'Impassable, fixed obstacle'|t }}</p>
        <p><span style="display:inline-block;width:18px;height:18px;background:#7a5325;border:2px solid #b7791f;margin-right:6px;color:#fff;font-size:10px;line-height:14px;text-align:center;">M</span>{{ 'Impassable, movable obstacle'|t }}</p>
        <p><span style="display:inline-block;width:18px;height:18px;background:#2d5170;border:2px solid #4299e1;margin-right:6px;color:#fff;font-size:10px;line-height:14px;text-align:center;">P</span>{{ 'Passable, movable obstacle'|t }}</p>
        <p><span style="display:inline-block;width:18px;height:18px;background:#2d4b36;border:2px solid #4d7a5b;margin-right:6px;color:#fff;font-size:10px;line-height:14px;text-align:center;">R</span>{{ 'Active room floor'|t }}</p>
        <p><span style="display:inline-block;width:18px;height:18px;background:#2d3748;border:1px solid #4a5568;margin-right:6px;color:#fff;font-size:10px;line-height:14px;text-align:center;">O</span>{{ 'Outside active room'|t }}</p>
        <p><span style="display:inline-block;width:18px;height:18px;background:#3b82f6;border:2px solid #60a5fa;margin-right:6px;color:#fff;font-size:10px;line-height:14px;text-align:center;">S</span>{{ 'Selected hex'|t }}</p>
      </div>
    </div>

    <div class="info-panel">
      <h3>{{ 'Instructions'|t }}</h3>
      <ul>
        <li>{{ 'Click a hex to select it'|t }}</li>
        <li>{{ 'Drag the map to pan around'|t }}</li>
        <li>{{ 'Scroll to zoom in/out'|t }}</li>
        <li>{{ 'Use Object Palette to place creatures and items'|t }}</li>
        <li>{{ 'Click creatures to select them'|t }}</li>
        <li>{{ 'Blue overlay shows movement range'|t }}</li>
        <li>{{ 'Click blue hex to move selected creature'|t }}</li>
        <li><strong>{{ 'Combat:'|t }}</strong> {{ 'Start Combat to roll initiative'|t }}</li>
        <li>{{ 'Actions on your turn: Move, Attack, End Turn'|t }}</li>
      </ul>
    </div>
  </div>
</div>
