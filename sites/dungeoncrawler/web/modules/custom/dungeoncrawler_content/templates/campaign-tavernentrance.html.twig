{#
 # Campaign Tavern Entrance — select a character and launch campaign.
 #}
<div class="dc-character-list">
  <div class="dc-character-list__header">
    <h1 class="dc-character-list__title">🍻 Tavern Entrance</h1>
    <div class="dc-sheet__nav-actions">
      <a href="{{ back_url }}" class="dc-btn dc-btn-secondary">← Back to Campaigns</a>
      <a href="{{ dungeon_selection_url }}" class="dc-btn dc-btn-secondary">🗺️ Select Dungeon</a>
      <a href="{{ create_character_url }}" class="dc-btn dc-btn-primary">
        <span class="dc-btn__icon">+</span> Create New Character
      </a>
    </div>
  </div>

  <div class="dc-sheet__section dc-character-list__campaign-setup">
    <h2 class="dc-sheet__section-title">{{ campaign.name }}</h2>
    <p>
      Theme: <strong>{{ campaign.theme }}</strong> · Difficulty: <strong>{{ campaign.difficulty }}</strong> · Status: <strong>{{ campaign.status }}</strong>
    </p>
    <p>Select a completed character to launch this campaign in the hexmap.</p>
  </div>

  {% if characters|length > 0 %}
    <div class="dc-character-grid">
      {% for char in characters %}
        <a href="{{ char.select_url ?: '#' }}" class="dc-character-card dc-character-card--{{ char.status }} {{ not char.select_url ? 'dc-character-card--disabled' : '' }}">
          <div class="dc-character-card__portrait">
            {% if char.portrait %}
              <img src="{{ char.portrait }}" alt="{{ char.name }}" />
            {% else %}
              <div class="dc-character-card__portrait-placeholder">
                <span class="dc-character-card__initial">{{ char.name|first|upper }}</span>
              </div>
            {% endif %}
          </div>

          <div class="dc-character-card__info">
            <h3 class="dc-character-card__name">{{ char.name }}</h3>
            <div class="dc-character-card__subtitle">
              Level {{ char.level }} {{ char.ancestry }} {{ char.class }}
            </div>

            <div class="dc-character-card__stats">
              <div class="dc-character-card__stat">
                <span class="dc-character-card__stat-label">HP</span>
                <span class="dc-character-card__stat-value dc-character-card__hp">{{ char.hp_current }}/{{ char.hp_max }}</span>
              </div>
              <div class="dc-character-card__stat">
                <span class="dc-character-card__stat-label">AC</span>
                <span class="dc-character-card__stat-value">{{ char.ac }}</span>
              </div>
            </div>

            <div class="dc-character-card__meta">
              <span>{{ char.alignment }}</span>
              <span>{{ char.created }}</span>
            </div>

            {% if char.select_url %}
              <div class="dc-character-card__meta dc-character-card__meta--campaign-state">
                <span class="dc-btn dc-btn-success">▶️ Launch Campaign</span>
              </div>
            {% else %}
              <div class="dc-character-card__meta dc-character-card__meta--campaign-state">
                <span class="dc-btn dc-btn-warning">Complete character creation first</span>
              </div>
            {% endif %}
          </div>

          <div class="dc-character-card__arrow">›</div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="dc-character-list__empty">
      <div class="dc-character-list__empty-icon">🧙</div>
      <h2>No Characters Available</h2>
      <p>Create a character first, then return to the tavern entrance to launch your campaign.</p>
      <a href="{{ create_character_url }}" class="dc-btn dc-btn-primary">Create Your First Character</a>
    </div>
  {% endif %}
</div>
