<?php

/**
 * @file
 * Primary module hooks for forseti_institutional module.
 */

/**
 * Implements hook_help().
 */
function forseti_institutional_help($route_name, $route_match) {
  switch ($route_name) {
    case 'help.page.forseti_institutional':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Institutional Management module provides a comprehensive system for managing institutions on the Forseti platform. Each institution operates as an isolated organization with its own members, roles, permissions, and content.') . '</p>';
      $output .= '<h3>' . t('Features') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('38 institution types across 8 categories') . '</li>';
      $output .= '<li>' . t('5 role types per institution (Owner, Administrator, Department Manager, Staff, Billing)') . '</li>';
      $output .= '<li>' . t('Complete data isolation between institutions') . '</li>';
      $output .= '<li>' . t('Users can belong to multiple institutions with different roles') . '</li>';
      $output .= '<li>' . t('Group-based permissions and access control') . '</li>';
      $output .= '</ul>';
      return $output;
  }
}
