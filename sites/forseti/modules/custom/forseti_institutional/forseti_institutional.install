/**
 * Get role definitions for all groups.
 *
 * @return array
 *   Array of role definitions.
 */
function _forseti_institutional_get_role_definitions() {
  return [
    'owner' => [
      'label' => 'Institution Owner',
      'weight' => -10,
      'permissions' => [
        'view group',
        'update group',
        'delete group',
        'administer members',
      ],
    ],
    'administrator' => [
      'label' => 'Institution Administrator',
      'weight' => -8,
      'permissions' => [
        'view group',
        'update group',
        'administer members',
      ],
    ],
    'department_manager' => [
      'label' => 'Department Manager',
      'weight' => -5,
      'permissions' => [
        'view group',
      ],
    ],
    'staff_member' => [
      'label' => 'Staff Member',
      'weight' => 0,
      'permissions' => [
        'view group',
      ],
    ],
    'billing_contact' => [
      'label' => 'Billing Contact',
      'weight' => 5,
      'permissions' => [
        'view group',
      ],
    ],
  ];
}

/**
 * Implements hook_uninstall().
 */
function forseti_institutional_uninstall() {
  \Drupal::messenger()->addStatus(t('Institutional Management system uninstalled.'));
}
