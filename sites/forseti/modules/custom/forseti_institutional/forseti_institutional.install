<?php

/**
 * @file
 * Install, update and uninstall functions for forseti_institutional module.
 */

use Drupal\group\Entity\GroupType;
use Drupal\group\Entity\GroupRole;

/**
 * Implements hook_install().
 */
function forseti_institutional_install() {
  // Create all institution group types
  _forseti_institutional_create_group_types();
  
  // Create roles for each group type
  _forseti_institutional_create_group_roles();
  
  \Drupal::messenger()->addStatus(t('Institutional Management system installed successfully. Created 38 institution types with 5 roles each.'));
}

/**
 * Create all 38 institution group types.
 */
function _forseti_institutional_create_group_types() {
  $institution_types = _forseti_institutional_get_institution_types();
  
  foreach ($institution_types as $id => $info) {
    // Check if group type already exists
    $group_type = GroupType::load($id);
    if (!$group_type) {
      $group_type = GroupType::create([
        'id' => $id,
        'label' => $info['label'],
        'description' => $info['description'],
        'creator_membership' => TRUE,
        'creator_wizard' => FALSE,
        'creator_roles' => [$id . '-owner'],
      ]);
      $group_type->save();
      
      \Drupal::logger('forseti_institutional')->info('Created group type: @type', ['@type' => $info['label']]);
    }
  }
}

/**
 * Create 5 standard roles for each group type.
 */
function _forseti_institutional_create_group_roles() {
  $institution_types = _forseti_institutional_get_institution_types();
  $role_definitions = _forseti_institutional_get_role_definitions();
  
  foreach ($institution_types as $type_id => $type_info) {
    foreach ($role_definitions as $role_id => $role_info) {
      $group_role_id = $type_id . '-' . $role_id;
      
      // Check if role already exists
      $group_role = GroupRole::load($group_role_id);
      if (!$group_role) {
        $group_role = GroupRole::create([
          'id' => $group_role_id,
          'label' => $role_info['label'],
          'weight' => $role_info['weight'],
          'internal' => FALSE,
          'audience' => 'member',
          'group_type' => $type_id,
          'permissions' => $role_info['permissions'],
        ]);
        $group_role->save();
        
        \Drupal::logger('forseti_institutional')->info('Created role @role for @type', [
          '@role' => $role_info['label'],
          '@type' => $type_info['label']
        ]);
      }
    }
  }
}

