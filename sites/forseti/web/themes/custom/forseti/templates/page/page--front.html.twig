{#
/**
 * @file
 * Theme override to display the front page with animated header.
 */
#}

{{ attach_library('forseti/animated-header') }}

<div class="page-wrapper">
  {# Animated Header Section - Full Height Home Header #}
  <div id="large-header" class="large-header home-header">
    <canvas id="demo-canvas"></canvas>
    <h1 class="main-title">
      <span class="highlight">Forseti</span> <span class="thin">Life</span>
    </h1>
    <p class="main-subtitle">
      AI-Powered Safety Monitoring for Philadelphia - Building Safer Communities Through Intelligence
    </p>
    <div class="hero-cta">
      <a href="/safety-map" class="btn btn-primary">View Safety Map</a>
      <a href="/mobile-app" class="btn btn-outline-light">Forseti Mobile</a>
      <a href="/about" class="btn btn-outline-light">Learn More</a>
    </div>
  </div>

  {# Navigation and Header #}
  {% if page.navbar_branding or page.navbar_left or page.navbar_right %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        {% if page.navbar_branding %}
          {{ page.navbar_branding }}
        {% endif %}
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        
        <div class="collapse navbar-collapse" id="navbarNav">
          {% if page.navbar_left %}
            {{ page.navbar_left }}
          {% endif %}
          
          {% if page.navbar_right %}
            <div class="ms-auto">
              {{ page.navbar_right }}
            </div>
          {% endif %}
        </div>
      </div>
    </nav>
  {% endif %}

  {# Main Content #}
  <main class="main-content">
    {% if page.header %}
      <div class="header-region">
        <div class="container">
          {{ page.header }}
        </div>
      </div>
    {% endif %}

    <div class="container">
      <div class="row">
        <div class="col">
          {% if page.content %}
            {{ page.content }}
          {% endif %}
        </div>
      </div>
    </div>
  </main>

  {# Footer #}
  {% if page.footer %}
    {{ page.footer }}
  {% endif %}
</div>
