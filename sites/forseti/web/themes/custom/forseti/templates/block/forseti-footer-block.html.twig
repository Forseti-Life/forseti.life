{#
/**
 * @file
 * Template for Forseti Footer Block.
 *
 * Available variables:
 * - menu_items: Array of menu items from main menu.
 * - current_year: Current year for copyright.
 */
#}
<div class="footer-content">
  <div class="footer-section footer-brand">
    <h3>Forseti Life</h3>
    <p>AI-Powered Community Safety for Philadelphia</p>
    <p class="footer-tagline">Building safer communities through intelligence</p>
  </div>
  
  <div class="footer-section footer-links">
    <h4>Quick Links</h4>
    {% if menu_items %}
      <ul class="footer-menu">
        {% for item in menu_items %}
          <li>
            <a href="{{ item.url }}">{{ item.title }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
  
  <div class="footer-section footer-legal">
    <h4>Legal</h4>
    <ul class="footer-menu">
      <li><a href="/privacy">Privacy & Security</a></li>
    </ul>
  </div>
  
  <div class="footer-section footer-info">
    <h4>Connect</h4>
    <ul class="footer-menu">
      <li><a href="/talk-with-forseti">💬 Talk with Forseti</a></li>
    </ul>
    <p>📍 Philadelphia Metropolitan Area</p>
    <p>🛡️ 24/7 AI Monitoring Active</p>
  </div>
</div>

<div class="footer-bottom">
  <p>&copy; {{ current_year }} Forseti Life. All rights reserved.</p>
  <p class="footer-tech">Powered by H3 Geospatial Intelligence & AI</p>
</div>
