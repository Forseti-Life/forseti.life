{#
/**
 * @file
 * Template for Forseti Footer Block.
 *
 * Available variables:
 * - menu_items: Array of menu items from main menu.
 * - current_year: Current year for copyright.
 */
#}
<style>
  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(0, 212, 255, 0.2);
  }
  
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  
  .footer-section h3 {
    color: #00d4ff;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  
  .footer-section h4 {
    color: #00d4ff;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .footer-section p {
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }
  
  .footer-tagline {
    color: rgba(0, 212, 255, 0.8);
    font-style: italic;
  }
  
  .footer-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer-menu li {
    margin-bottom: 0.5rem;
  }
  
  .footer-menu a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
  }
  
  .footer-menu a:hover {
    color: #00d4ff;
    padding-left: 0.5rem;
  }
  
  .footer-bottom {
    text-align: center;
    padding-top: 1.5rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
  }
  
  .footer-bottom p {
    margin: 0.25rem 0;
  }
  
  .footer-tech {
    color: rgba(0, 212, 255, 0.6);
    font-size: 0.85rem;
  }
</style>

<div class="footer-content">
  <div class="footer-section footer-brand">
    <h3>Forseti Community</h3>
    <p>A tolerant, scientific, technology-embracing community</p>
    <p class="footer-tagline">Building AI-powered services for our members</p>
  </div>
  
  <div class="footer-section footer-links">
    <h4>Quick Links</h4>
    {% if menu_items %}
      <ul class="footer-menu">
        {% for item in menu_items %}
          <li>
            <a href="{{ item.url }}">{{ item.title }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
  
  <div class="footer-section footer-info">
    <h4>Connect</h4>
    <p><a href="/talk-with-forseti" style="color: rgba(255, 255, 255, 0.8); text-decoration: none;">💬 Talk with Forseti</a></p>
    <p><a href="/contact" style="color: rgba(255, 255, 255, 0.8); text-decoration: none;">✉️ Contact Us</a></p>
    <p>🤖 AI-Powered Member Services</p>
  </div>
</div>

<div class="footer-bottom">
  <p>&copy; {{ current_year }} Forseti Community. All rights reserved.</p>
  <p class="footer-tech">Privately funded. Invitation-based membership.</p>
</div>
