{#
/**
 * @file
 * Template for Agent Evaluation tool page.
 *
 * Available variables:
 * - title: Page title
 * - intro: Introduction content
 */
#}
<div class="container py-3">
  <div class="row">
    <div class="col-lg-10 mx-auto">
      <h1 class="text-center mb-3 text-cyan">{{ title }}</h1>
      
      <div class="alert alert-info-cyan mb-4">
        <p class="mb-0">{{ intro.description }}</p>
      </div>
      
      <div class="card card-forseti mb-4">
        <div class="card-body">
          <h3 class="text-cyan mb-4">
            <i class="fas fa-robot"></i> {{ 'Start Your Evaluation'|t }}
          </h3>
          
          <p class="text-muted-light mb-4">
            {{ 'To evaluate an agent, you can either:'|t }}
          </p>
          
          <div class="row">
            <div class="col-md-6 mb-3">
              <div class="card h-100" style="border: 2px solid #00d4ff;">
                <div class="card-body text-center">
                  <h4 class="text-cyan mb-3">
                    <i class="fas fa-comments"></i><br>
                    {{ 'Chat with Forseti'|t }}
                  </h4>
                  <p class="text-muted-light mb-3">
                    {{ 'Describe the agent you want to evaluate, and Forseti will guide you through an interactive evaluation process.'|t }}
                  </p>
                  <a href="/talk-with-forseti" class="btn btn-primary">
                    <i class="fas fa-comment-dots"></i> {{ 'Start Chat Evaluation'|t }}
                  </a>
                </div>
              </div>
            </div>
            
            <div class="col-md-6 mb-3">
              <div class="card h-100" style="border: 2px solid #4caf50;">
                <div class="card-body text-center">
                  <h4 class="text-success mb-3">
                    <i class="fas fa-list-alt"></i><br>
                    {{ 'Manual Form'|t }}
                  </h4>
                  <p class="text-muted-light mb-3">
                    {{ 'Fill out a structured form to manually score each dimension and sub-dimension.'|t }}
                  </p>
                  <a href="/node/add/evaluated_entity" class="btn btn-success">
                    <i class="fas fa-edit"></i> {{ 'Create Manual Evaluation'|t }}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="card card-forseti mb-4">
        <div class="card-body">
          <h3 class="text-cyan mb-3">
            <i class="fas fa-info-circle"></i> {{ 'What You Will Get'|t }}
          </h3>
          
          <ul class="text-muted-light">
            <li class="mb-2">
              <strong>{{ 'Interactive Radar Chart:'|t }}</strong> 
              {{ 'Visual representation of the agent\'s power profile across all five dimensions'|t }}
            </li>
            <li class="mb-2">
              <strong>{{ 'Detailed Scores:'|t }}</strong> 
              {{ 'Scores for all 30 sub-dimensions (6 per dimension)'|t }}
            </li>
            <li class="mb-2">
              <strong>{{ 'Overall Power Level:'|t }}</strong> 
              {{ 'Classification from Level 0 (No Capability) to Level 9+ (Universal Capability)'|t }}
            </li>
            <li class="mb-2">
              <strong>{{ 'Capability Assessment:'|t }}</strong> 
              {{ 'Identification of strengths, weaknesses, and constraints'|t }}
            </li>
            <li>
              <strong>{{ 'Advanced Metrics:'|t }}</strong> 
              {{ 'For Level 8+ entities, quantitative benchmarks beyond the heuristic scale'|t }}
            </li>
          </ul>
        </div>
      </div>
      
      <div class="card card-forseti mb-4" style="border-left: 4px solid #ffc107;">
        <div class="card-body">
          <h3 class="text-warning mb-3">
            <i class="fas fa-exclamation-triangle"></i> {{ 'Important Notes'|t }}
          </h3>
          
          <ul class="text-muted-light">
            <li class="mb-2">
              {{ 'The 0-9 scale is a heuristic designed for quick capability assessment'|t }}
            </li>
            <li class="mb-2">
              {{ 'Evaluations require judgment - no automated system can perfectly assess agent capabilities'|t }}
            </li>
            <li class="mb-2">
              {{ 'For high-power entities (Level 8+), consider using advanced quantitative metrics'|t }}
            </li>
            <li>
              {{ 'This framework is designed to reveal constraints, biases, and limitations in agent systems'|t }}
            </li>
          </ul>
        </div>
      </div>
      
      <div class="text-center mb-4">
        <a href="/agent-power-framework" class="btn btn-outline-cyan">
          <i class="fas fa-arrow-left"></i> {{ 'Back to Framework Overview'|t }}
        </a>
      </div>
    </div>
  </div>
</div>
