{#
/**
 * @file
 * Template for the evaluations list page.
 *
 * Available variables:
 * - title: Page title
 * - intro: Introduction text
 * - rows: Array of entity data
 * - sort_field: Current sort field
 * - sort_direction: Current sort direction (ASC/DESC)
 */
#}
{{ attach_library('forseti_safety_content/agent-power') }}
{{ attach_library('agent_evaluation/evaluated-entity') }}

<div class="container py-4">
  <div class="row">
    <div class="col-12">
      <h1 class="mb-3 text-cyan">{{ title }}</h1>
      <p class="lead mb-4">{{ intro }}</p>

      {% if entities_data is not empty %}
        {# Radar Chart Visualization #}
        <div class="card card-forseti mb-4">
          <div class="card-body">
            <h3 class="text-cyan mb-3">
              <i class="fas fa-chart-radar me-2"></i>Power Profile Visualization
            </h3>
            
            <div class="mb-3">
              <label for="entity-selector" class="form-label text-cyan">Select Entity to Visualize:</label>
              <select id="entity-selector" class="form-select form-select-lg">
                <option value="">-- Select an Entity --</option>
                {% for entity in entities_data %}
                  <option value="{{ entity.nid }}">{{ entity.name }}</option>
                {% endfor %}
              </select>
            </div>
            
            <div id="chart-container" style="display: none;">
              <div class="power-radar-chart mb-3" 
                   id="evaluations-radar-chart"
                   data-chart=""
                   data-entity-name="">
                <div class="chart-controls mb-3 text-end">
                  <button class="btn btn-sm btn-outline-cyan chart-reset-btn" style="display: none;">
                    <i class="fas fa-undo"></i> Reset View
                  </button>
                </div>
                <canvas id="evaluationsRadarChart" style="max-height: 500px;"></canvas>
              </div>
            </div>
          </div>
        </div>
      {% endif %}

      <div class="card card-forseti mb-4">
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover table-striped">
              <thead>
                <tr>
                  <th>
                    <a href="?sort=title&order={{ sort_field == 'title' and sort_direction == 'ASC' ? 'DESC' : 'ASC' }}">
                      Entity Name
                      {% if sort_field == 'title' %}
                        <i class="fas fa-sort-{{ sort_direction == 'ASC' ? 'up' : 'down' }}"></i>
                      {% else %}
                        <i class="fas fa-sort text-muted"></i>
                      {% endif %}
                    </a>
                  </th>
                  <th class="text-center">
                    <a href="?sort=information_access&order={{ sort_field == 'information_access' and sort_direction == 'ASC' ? 'DESC' : 'ASC' }}">
                      Information Access
                      {% if sort_field == 'information_access' %}
                        <i class="fas fa-sort-{{ sort_direction == 'ASC' ? 'up' : 'down' }}"></i>
                      {% else %}
                        <i class="fas fa-sort text-muted"></i>
                      {% endif %}
                    </a>
                  </th>
                  <th class="text-center">
                    <a href="?sort=resource_control&order={{ sort_field == 'resource_control' and sort_direction == 'ASC' ? 'DESC' : 'ASC' }}">
                      Resource Control
                      {% if sort_field == 'resource_control' %}
                        <i class="fas fa-sort-{{ sort_direction == 'ASC' ? 'up' : 'down' }}"></i>
                      {% else %}
                        <i class="fas fa-sort text-muted"></i>
                      {% endif %}
                    </a>
                  </th>
                  <th class="text-center">
                    <a href="?sort=authority_permission&order={{ sort_field == 'authority_permission' and sort_direction == 'ASC' ? 'DESC' : 'ASC' }}">
                      Authority & Permission
                      {% if sort_field == 'authority_permission' %}
                        <i class="fas fa-sort-{{ sort_direction == 'ASC' ? 'up' : 'down' }}"></i>
                      {% else %}
                        <i class="fas fa-sort text-muted"></i>
                      {% endif %}
                    </a>
                  </th>
                  <th class="text-center">
                    <a href="?sort=network_position&order={{ sort_field == 'network_position' and sort_direction == 'ASC' ? 'DESC' : 'ASC' }}">
                      Network Position
                      {% if sort_field == 'network_position' %}
                        <i class="fas fa-sort-{{ sort_direction == 'ASC' ? 'up' : 'down' }}"></i>
                      {% else %}
                        <i class="fas fa-sort text-muted"></i>
                      {% endif %}
                    </a>
                  </th>
                  <th class="text-center">
                    <a href="?sort=synthesis_application&order={{ sort_field == 'synthesis_application' and sort_direction == 'ASC' ? 'DESC' : 'ASC' }}">
                      Synthesis & Application
                      {% if sort_field == 'synthesis_application' %}
                        <i class="fas fa-sort-{{ sort_direction == 'ASC' ? 'up' : 'down' }}"></i>
                      {% else %}
                        <i class="fas fa-sort text-muted"></i>
                      {% endif %}
                    </a>
                  </th>
                  <th class="text-center">
                    <a href="?sort=total_power&order={{ sort_field == 'total_power' and sort_direction == 'ASC' ? 'DESC' : 'ASC' }}">
                      Total Power
                      {% if sort_field == 'total_power' %}
                        <i class="fas fa-sort-{{ sort_direction == 'ASC' ? 'up' : 'down' }}"></i>
                      {% else %}
                        <i class="fas fa-sort text-muted"></i>
                      {% endif %}
                    </a>
                  </th>
                </tr>
              </thead>
              <tbody>
                {% if rows is empty %}
                  <tr>
                    <td colspan="7" class="text-center text-muted py-5">
                      <i class="fas fa-inbox fa-3x mb-3"></i>
                      <p>No evaluated entities yet. <a href="/agent-power-framework">Start an evaluation</a> to see results here.</p>
                    </td>
                  </tr>
                {% else %}
                  {% for row in rows %}
                    <tr>
                      <td>{{ row.title }}</td>
                      <td class="text-center">
                        <span class="badge bg-{{ row.information_access <= 3 ? 'danger' : (row.information_access <= 6 ? 'warning' : 'success') }}">
                          {{ row.information_access }}/9
                        </span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-{{ row.resource_control <= 3 ? 'danger' : (row.resource_control <= 6 ? 'warning' : 'success') }}">
                          {{ row.resource_control }}/9
                        </span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-{{ row.authority_permission <= 3 ? 'danger' : (row.authority_permission <= 6 ? 'warning' : 'success') }}">
                          {{ row.authority_permission }}/9
                        </span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-{{ row.network_position <= 3 ? 'danger' : (row.network_position <= 6 ? 'warning' : 'success') }}">
                          {{ row.network_position }}/9
                        </span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-{{ row.synthesis_application <= 3 ? 'danger' : (row.synthesis_application <= 6 ? 'warning' : 'success') }}">
                          {{ row.synthesis_application }}/9
                        </span>
                      </td>
                      <td class="text-center">
                        <strong class="text-{{ row.total_power <= 3 ? 'danger' : (row.total_power <= 6 ? 'warning' : 'success') }}">
                          {{ row.total_power }}/9
                        </strong>
                      </td>
                    </tr>
                  {% endfor %}
                {% endif %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="text-center mt-4">
        <a href="/agent-power-framework" class="btn btn-primary">
          <i class="fas fa-plus"></i> Evaluate New Entity
        </a>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';
  
  // Wait for DOM to be fully loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChart);
  } else {
    initChart();
  }
  
  function initChart() {
    console.log('Initializing evaluations chart...');
    
    // Store entities data for chart
    const entitiesData = {{ entities_data|json_encode|raw }};
    console.log('Entities data:', entitiesData);
    
    const selector = document.getElementById('entity-selector');
    const chartContainer = document.getElementById('chart-container');
    const chartElement = document.getElementById('evaluations-radar-chart');
    
    console.log('Selector:', selector);
    console.log('Chart container:', chartContainer);
    console.log('Chart element:', chartElement);
    
    if (!selector || !chartContainer || !chartElement) {
      console.error('Required elements not found');
      return;
    }
    
    selector.addEventListener('change', function() {
      console.log('Entity selected:', this.value);
      const selectedNid = this.value;
      
      if (!selectedNid) {
        chartContainer.style.display = 'none';
        return;
      }
      
      // Find the selected entity data
      const entityData = entitiesData.find(e => e.nid == selectedNid);
      console.log('Entity data:', entityData);
      
      if (!entityData) {
        console.error('Entity data not found for nid:', selectedNid);
        return;
      }
      
      // Prepare chart data
      const chartData = {
        primary_labels: [
          'Information Access',
          'Resource Control',
          'Authority & Permission',
          'Network Position',
          'Synthesis & Application'
        ],
        primary_scores: [
          entityData.scores.information_access,
          entityData.scores.resource_control,
          entityData.scores.authority_permission,
          entityData.scores.network_position,
          entityData.scores.synthesis_application
        ],
        primary_keys: [
          'information_access',
          'resource_control',
          'authority_&_permission',
          'network_position',
          'synthesis_&_application'
        ]
      };
      
      console.log('Chart data:', chartData);
      
      // Update chart element attributes
      chartElement.dataset.chart = JSON.stringify(chartData);
      chartElement.dataset.entityName = entityData.name;
      
      // Show chart container
      chartContainer.style.display = 'block';
      
      // Show chart container
      chartContainer.style.display = 'block';
      
      console.log('Rendering chart directly...');
      
      // Render the chart directly using Chart.js
      const canvas = document.getElementById('evaluationsRadarChart');
      if (!canvas) {
        console.error('Canvas element not found');
        return;
      }
      
      // Check if Chart.js is loaded
      if (typeof Chart === 'undefined') {
        console.error('Chart.js is not loaded');
        return;
      }
      
      // Destroy existing chart if it exists
      const existingChart = Chart.getChart(canvas);
      if (existingChart) {
        existingChart.destroy();
      }
      
      // Create new chart
      const ctx = canvas.getContext('2d');
      new Chart(ctx, {
        type: 'radar',
        data: {
          labels: chartData.primary_labels,
          datasets: [{
            label: entityData.name,
            data: chartData.primary_scores,
            backgroundColor: 'rgba(0, 212, 255, 0.2)',
            borderColor: '#00d4ff',
            borderWidth: 2,
            pointBackgroundColor: '#00d4ff',
            pointBorderColor: '#fff',
            pointHoverBackgroundColor: '#fff',
            pointHoverBorderColor: '#00d4ff',
            pointRadius: 5,
            pointHoverRadius: 7
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          scales: {
            r: {
              min: 0,
              max: 9,
              ticks: {
                stepSize: 1,
                color: '#00d4ff',
                backdropColor: 'transparent'
              },
              grid: {
                color: 'rgba(0, 212, 255, 0.2)'
              },
              pointLabels: {
                color: '#00d4ff',
                font: {
                  size: 14,
                  weight: 'bold'
                }
              }
            }
          },
          plugins: {
            legend: {
              display: true,
              labels: {
                color: '#00d4ff',
                font: {
                  size: 14
                }
              }
            },
            tooltip: {
              backgroundColor: 'rgba(22, 33, 62, 0.95)',
              titleColor: '#00d4ff',
              bodyColor: '#fff',
              borderColor: '#00d4ff',
              borderWidth: 1
            }
          }
        }
      });
      
      console.log('Chart rendered successfully');
    });
    
    console.log('Chart initialization complete');
  }
})();
</script>
