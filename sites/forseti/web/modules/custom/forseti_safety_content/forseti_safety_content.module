<?php

/**
 * @file
 * Primary module hooks for Forseti Safety Content module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function forseti_safety_content_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.forseti_safety_content':
      return '<p>' . t('Forseti Safety Content provides the main pages and content for the Forseti Life website.') . '</p>';
  }
}

/**
 * Implements hook_theme().
 */
function forseti_safety_content_theme($existing, $type, $theme, $path) {
  return [
    'forseti_footer_block' => [
      'variables' => [
        'menu_items' => [],
        'current_year' => NULL,
      ],
    ],
    'forseti_page_agent_hierarchy' => [
      'variables' => [
        'title' => NULL,
        'intro' => [],
        'dimensions' => [],
        'transparency_note' => NULL,
      ],
      'template' => 'forseti-page-agent-hierarchy',
    ],
  ];
}
