{#
/**
 * @file
 * Template for the My Jobs page - displays user's saved job postings.
 *
 * Available variables:
 * - jobs: Array of saved jobs
 * - companies: Array of company names for filtering
 * - filter_company: Current company filter value
 * - filter_status: Current status filter value
 * - filter_ai_status: Current AI status filter value
 * - filter_tailoring: Current tailoring filter value
 * - return_url: Current page URL to return to after inline actions
 * - current_page: Current page number (0-indexed)
 * - total_pages: Total number of pages
 * - total_jobs: Total job count matching filters
 */
#}

<div class="my-jobs-page">
  <h1>📋 {{ 'My Jobs'|t }}</h1>
  <p>{{ 'Manage your saved job postings, track AI parsing and resume tailoring status.'|t }}</p>

  <div class="page-actions">
    <a href="/jobhunter/job/paste" class="button button--primary">
      {{ '+ Add Job Posting'|t }}
    </a>
    <a href="/jobhunter/my-jobs/archive" class="button button--secondary">
      {{ '🗄 Archived Jobs'|t }}
    </a>
  </div>

  {# Filter Form #}
  <div class="jobs-filters">
    <form method="get" action="/jobhunter/my-jobs" class="filter-form">
      <div class="filter-row">
        <div class="filter-field">
          <label for="company">{{ 'Company'|t }}</label>
          <select name="company" id="company">
            <option value="">{{ 'All Companies'|t }}</option>
            {% for company in companies %}
              <option value="{{ company }}"{{ company == filter_company ? ' selected' : '' }}>
                {{ company }}
              </option>
            {% endfor %}
          </select>
        </div>
        
        <div class="filter-field">
          <label for="status">{{ 'Status'|t }}</label>
          <select name="status" id="status">
            <option value="">{{ 'All Statuses'|t }}</option>
            <option value="active"{{ filter_status == 'active' ? ' selected' : '' }}>
              {{ 'Active'|t }}
            </option>
            <option value="archived"{{ filter_status == 'archived' ? ' selected' : '' }}>
              {{ 'Archived'|t }}
            </option>
            <option value="applied"{{ filter_status == 'applied' ? ' selected' : '' }}>
              {{ 'Applied'|t }}
            </option>
          </select>
        </div>
        
        <div class="filter-field">
          <label for="ai_status">{{ 'AI Status'|t }}</label>
          <select name="ai_status" id="ai_status">
            <option value="">{{ 'All AI Statuses'|t }}</option>
            <option value="completed"{{ filter_ai_status == 'completed' ? ' selected' : '' }}>
              {{ 'Parsed'|t }}
            </option>
            <option value="pending"{{ filter_ai_status == 'pending' ? ' selected' : '' }}>
              {{ 'Needs Parsing'|t }}
            </option>
            <option value="processing"{{ filter_ai_status == 'processing' ? ' selected' : '' }}>
              {{ 'Processing'|t }}
            </option>
            <option value="failed"{{ filter_ai_status == 'failed' ? ' selected' : '' }}>
              {{ 'Failed'|t }}
            </option>
          </select>
        </div>
        
        <div class="filter-field">
          <label for="tailoring">{{ 'Tailoring'|t }}</label>
          <select name="tailoring" id="tailoring">
            <option value="">{{ 'All Tailoring Statuses'|t }}</option>
            <option value="completed"{{ filter_tailoring == 'completed' ? ' selected' : '' }}>
              {{ 'Tailored'|t }}
            </option>
            <option value="pending"{{ filter_tailoring == 'pending' ? ' selected' : '' }}>
              {{ 'Not Tailored'|t }}
            </option>
            <option value="processing"{{ filter_tailoring == 'processing' ? ' selected' : '' }}>
              {{ 'Processing'|t }}
            </option>
            <option value="failed"{{ filter_tailoring == 'failed' ? ' selected' : '' }}>
              {{ 'Failed'|t }}
            </option>
          </select>
        </div>
        
        <div class="filter-actions">
          <button type="submit" class="button button--primary">{{ 'Filter'|t }}</button>
          <a href="/jobhunter/my-jobs" class="button button--secondary">{{ 'Clear'|t }}</a>
        </div>
      </div>
    </form>
  </div>

  {# Jobs Table #}
  {% if jobs|length > 0 %}
    <table class="jobs-table">
      <thead>
        <tr>
          <th>{{ 'Job Title'|t }}</th>
          <th>{{ 'Company'|t }}</th>
          <th>{{ 'Status'|t }}</th>
          <th>{{ 'Have Applied'|t }}</th>
          <th>{{ 'AI Parsed'|t }}</th>
          <th>{{ 'Tailored'|t }}</th>
          <th>{{ 'Actions'|t }}</th>
        </tr>
      </thead>
      <tbody>
        {% for job in jobs %}
          {% set extracted = job.extracted_data %}
          {% set job_title = extracted.position.title|default(job.job_title)|default('Job #' ~ job.id) %}
          {% set company_name = extracted.company.name|default(job.company_name)|default('Unknown') %}
          {% set has_raw_text = job.raw_posting_text is not empty %}
          {% set has_extracted = job.extracted_json is not empty %}
          {% set ai_status = job.ai_extraction_status|default('pending') %}
          {% set tailoring_status = job.tailoring_status|default(null) %}
          {% set has_tailored_json = job.tailored_resume_json is not empty %}
          {% set has_pdf = job.pdf_path is not empty %}
          {% set is_applied = job.status|default('active') == 'applied' %}
          
          <tr>
            <td>
              <a href="{{ path('job_hunter.job_view', {'job_id': job.id}) }}">{{ job_title }}</a>
            </td>
            <td>{{ company_name }}</td>
            <td>{{ job.status|default('active')|capitalize }}</td>
            <td>
              <form method="post" action="{{ path('job_hunter.toggle_job_applied', {'job_id': job.id}) }}" class="applied-toggle-form">
                <label>
                  <input
                    type="checkbox"
                    name="have_applied"
                    value="1"
                    {{ is_applied ? 'checked' : '' }}
                    onchange="this.form.querySelector('input[name=applied_on_date]').disabled = !this.checked;"
                  />
                  {{ 'Have applied'|t }}
                </label>
                <input
                  type="date"
                  name="applied_on_date"
                  value="{{ job.applied_on_date|default('') }}"
                  {{ is_applied ? '' : 'disabled' }}
                />
                <input type="hidden" name="return_to" value="{{ return_url }}" />
                <button type="submit" class="button button--small">{{ 'Update'|t }}</button>
              </form>
            </td>
            <td>
              {# AI Status Badge #}
              {% if has_extracted %}
                <span class="badge badge--success" title="{{ 'AI parsing complete'|t }}">
                  ✅ {{ 'Parsed'|t }}
                </span>
              {% elseif ai_status in ['processing', 'queued'] %}
                <span class="badge badge--warning" title="{{ 'AI parsing in progress'|t }}">
                  ⏳ {{ 'Processing'|t }}
                </span>
              {% elseif ai_status == 'failed' %}
                <span class="badge badge--error" title="{{ 'AI parsing failed'|t }}">
                  ❌ {{ 'Failed'|t }}
                </span>
              {% elseif has_raw_text %}
                <span class="badge badge--info" title="{{ 'Has raw text, needs AI parsing'|t }}">
                  📝 {{ 'Needs Parsing'|t }}
                </span>
              {% else %}
                <span class="badge badge--neutral" title="{{ 'No content yet'|t }}">
                  ⚪ {{ 'No Content'|t }}
                </span>
              {% endif %}
            </td>
            <td>
              {# Tailoring Status Badge #}
              {% if tailoring_status == 'completed' and has_tailored_json %}
                {% if has_pdf %}
                  <span class="badge badge--success" title="{{ 'Tailored with PDF ready'|t }}">
                    ✅ {{ 'PDF Ready'|t }}
                  </span>
                {% else %}
                  <span class="badge badge--success" title="{{ 'Resume tailored, generate PDF'|t }}">
                    ✅ {{ 'Tailored'|t }}
                  </span>
                {% endif %}
              {% elseif tailoring_status in ['processing', 'queued'] %}
                <span class="badge badge--warning" title="{{ 'Tailoring in progress'|t }}">
                  ⏳ {{ 'Processing'|t }}
                </span>
              {% elseif tailoring_status == 'failed' %}
                <span class="badge badge--error" title="{{ 'Tailoring failed'|t }}">
                  ❌ {{ 'Failed'|t }}
                </span>
              {% else %}
                <span class="badge badge--neutral" title="{{ 'Not yet tailored'|t }}">
                  ⚪ {{ 'Not Tailored'|t }}
                </span>
              {% endif %}
            </td>
            <td class="operations">
              <div class="dropbutton-wrapper">
                <a href="/jobhunter/tailor-resume/{{ job.id }}" class="button button--small">
                  {{ tailoring_status == 'completed' ? 'View Tailored'|t : 'Tailor Resume'|t }}
                </a>
                <a href="{{ path('job_hunter.job_view', {'job_id': job.id}) }}" class="button button--small">
                  {{ 'View'|t }}
                </a>
                <a href="{{ path('job_hunter.job_edit', {'job_id': job.id}) }}" class="button button--small">
                  {{ 'Edit'|t }}
                </a>
                {% if ai_status == 'failed' and has_raw_text %}
                  <a href="{{ path('job_hunter.job_retry_parsing', {'job_id': job.id}) }}" class="button button--small button--warning">
                    {{ 'Retry Parsing'|t }}
                  </a>
                {% endif %}
                <a href="{{ path('job_hunter.job_archive', {'job_id': job.id}, {'query': {'return_to': return_url}}) }}" 
                   class="button button--small button--warning"
                   onclick="return confirm('{{ 'Archive this job? You can restore it from Archived Jobs.'|t }}')">
                  {{ 'Archive'|t }}
                </a>
              </div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <div class="empty-state">
      <p>
        {{ 'No job postings saved yet.'|t }} 
        <a href="/jobhunter/job/paste">{{ 'Add your first job'|t }}</a> 
        {{ 'or'|t }} 
        <a href="/jobhunter/job-discovery">{{ 'search for jobs'|t }}</a> 
        {{ 'to get started.'|t }}
      </p>
    </div>
  {% endif %}

  {% if total_pages > 1 %}
    <nav class="pager" aria-label="{{ 'Pagination'|t }}">
      <ul class="pager__items">
        {% if current_page > 0 %}
          <li class="pager__item pager__item--previous">
            <a href="?page={{ current_page - 1 }}{% if filter_company %}&company={{ filter_company }}{% endif %}{% if filter_status %}&status={{ filter_status }}{% endif %}{% if filter_ai_status %}&ai_status={{ filter_ai_status }}{% endif %}{% if filter_tailoring %}&tailoring={{ filter_tailoring }}{% endif %}" rel="prev">
              ‹ {{ 'Previous'|t }}
            </a>
          </li>
        {% endif %}
        <li class="pager__item pager__item--current">
          {{ 'Page %current of %total'|t({'%current': current_page + 1, '%total': total_pages}) }}
        </li>
        {% if current_page < total_pages - 1 %}
          <li class="pager__item pager__item--next">
            <a href="?page={{ current_page + 1 }}{% if filter_company %}&company={{ filter_company }}{% endif %}{% if filter_status %}&status={{ filter_status }}{% endif %}{% if filter_ai_status %}&ai_status={{ filter_ai_status }}{% endif %}{% if filter_tailoring %}&tailoring={{ filter_tailoring }}{% endif %}" rel="next">
              {{ 'Next'|t }} ›
            </a>
          </li>
        {% endif %}
      </ul>
    </nav>
  {% endif %}

</div>
