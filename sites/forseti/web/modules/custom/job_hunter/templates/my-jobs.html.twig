{#
/**
 * @file
 * Template for the My Jobs page - displays user's saved job postings.
 *
 * Available variables:
 * - jobs: Array of saved jobs (each job has a workflow_status and display_platform)
 * - companies: Array of company names for filtering
 * - platforms: Array of source platform names for filtering
 * - filter_company: Current company filter value
 * - filter_status: Current workflow status filter value
 * - filter_platform: Current platform filter value
 * - return_url: Current page URL to return to after inline actions
 * - current_page: Current page number (0-indexed)
 * - total_pages: Total number of pages
 * - total_jobs: Total job count matching filters
 */
#}

<div class="my-jobs-page">
  <h1>{{ 'My Jobs'|t }}</h1>
  <p>{{ 'Track your saved jobs through the application pipeline.'|t }}</p>

  {# Process Flow Legend #}
  <div class="workflow-legend">
    <h3>{{ 'Application Process Flow'|t }}</h3>
    <ol class="workflow-steps">
      <li class="workflow-step workflow-step--profile-pending">
        <span class="workflow-step__badge badge badge--warning">1</span>
        <strong>{{ 'Profile Pending'|t }}</strong> &mdash; {{ 'Complete your job seeker profile'|t }}
      </li>
      <li class="workflow-step workflow-step--tailoring-pending">
        <span class="workflow-step__badge badge badge--info">2</span>
        <strong>{{ 'Tailoring Pending'|t }}</strong> &mdash; {{ 'Tailor your resume for this job'|t }}
      </li>
      <li class="workflow-step workflow-step--tailoring-processing">
        <span class="workflow-step__badge badge badge--warning">3</span>
        <strong>{{ 'Tailoring Processing'|t }}</strong> &mdash; {{ 'Resume tailoring is in progress'|t }}
      </li>
      <li class="workflow-step workflow-step--approval-pending">
        <span class="workflow-step__badge badge badge--info">4</span>
        <strong>{{ 'User Approval Pending'|t }}</strong> &mdash; {{ 'Review tailoring and generate PDF'|t }}
      </li>
      <li class="workflow-step workflow-step--application-pending">
        <span class="workflow-step__badge badge badge--info">5</span>
        <strong>{{ 'Application Pending'|t }}</strong> &mdash; {{ 'Submit your application'|t }}
      </li>
      <li class="workflow-step workflow-step--pending-response">
        <span class="workflow-step__badge badge badge--success">6</span>
        <strong>{{ 'Pending Response'|t }}</strong> &mdash; {{ 'Waiting for company response'|t }}
      </li>
      <li class="workflow-step workflow-step--closed">
        <span class="workflow-step__badge badge badge--neutral">7</span>
        <strong>{{ 'Closed'|t }}</strong> &mdash; {{ 'Application cycle complete'|t }}
      </li>
    </ol>
  </div>

  <div class="page-actions">
    <a href="/jobhunter/job/paste" class="button button--primary">
      {{ '+ Add Job Posting'|t }}
    </a>
    <a href="/jobhunter/my-jobs/archive" class="button button--secondary">
      {{ 'Archived Jobs'|t }}
    </a>
  </div>

  {# Filter Form #}
  <div class="jobs-filters">
    <form method="get" action="/jobhunter/my-jobs" class="filter-form">
      <div class="filter-row">
        <div class="filter-field">
          <label for="company">{{ 'Company'|t }}</label>
          <select name="company" id="company">
            <option value="">{{ 'All Companies'|t }}</option>
            {% for company in companies %}
              <option value="{{ company }}"{{ company == filter_company ? ' selected' : '' }}>
                {{ company }}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="filter-field">
          <label for="status">{{ 'Status'|t }}</label>
          <select name="status" id="status">
            <option value="">{{ 'All Statuses'|t }}</option>
            <option value="active"{{ filter_status == 'active' ? ' selected' : '' }}>
              {{ 'Active'|t }}
            </option>
            <option value="applied"{{ filter_status == 'applied' ? ' selected' : '' }}>
              {{ 'Applied'|t }}
            </option>
            <option value="closed"{{ filter_status == 'closed' ? ' selected' : '' }}>
              {{ 'Closed'|t }}
            </option>
          </select>
        </div>

        <div class="filter-field">
          <label for="platform">{{ 'Platform'|t }}</label>
          <select name="platform" id="platform">
            <option value="">{{ 'All Platforms'|t }}</option>
            {% for platform in platforms %}
              <option value="{{ platform }}"{{ platform == filter_platform ? ' selected' : '' }}>
                {{ platform }}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="filter-actions">
          <button type="submit" class="button button--primary">{{ 'Filter'|t }}</button>
          <a href="/jobhunter/my-jobs" class="button button--secondary">{{ 'Clear'|t }}</a>
        </div>
      </div>
    </form>
  </div>

  {# Jobs Table #}
  {% if jobs|length > 0 %}
    <table class="jobs-table">
      <thead>
        <tr>
          <th>{{ 'Job Title'|t }}</th>
          <th>{{ 'Company'|t }}</th>
          <th>{{ 'Platform'|t }}</th>
          <th>{{ 'Status'|t }}</th>
          <th>{{ 'Action'|t }}</th>
        </tr>
      </thead>
      <tbody>
        {% for job in jobs %}
          {% set extracted = job.extracted_data %}
          {% set job_title = extracted.position.title|default(job.job_title)|default('Job #' ~ job.id) %}
          {% set company_name = extracted.company.name|default(job.company_name)|default('Unknown') %}
          {% set wf = job.workflow_status|default('profile_pending') %}

          <tr class="job-row job-row--{{ wf }}">
            <td>
              <a href="{{ path('job_hunter.job_view', {'job_id': job.id}) }}">{{ job_title }}</a>
            </td>
            <td>{{ company_name }}</td>
            <td>{{ job.display_platform|default('&mdash;')|raw }}</td>
            <td>
              {# Workflow Status Badge #}
              {% if wf == 'profile_pending' %}
                <span class="badge badge--warning" title="{{ 'Complete your profile to proceed'|t }}">
                  {{ 'Profile Pending'|t }}
                </span>
              {% elseif wf == 'tailoring_pending' %}
                <span class="badge badge--info" title="{{ 'Tailor your resume for this job'|t }}">
                  {{ 'Tailoring Pending'|t }}
                </span>
              {% elseif wf == 'tailoring_processing' %}
                <span class="badge badge--warning" title="{{ 'Resume tailoring is in progress'|t }}">
                  {{ 'Tailoring Processing'|t }}
                </span>
              {% elseif wf == 'approval_pending' %}
                <span class="badge badge--info" title="{{ 'Review and generate your PDF before applying'|t }}">
                  {{ 'User Approval Pending'|t }}
                </span>
              {% elseif wf == 'application_pending' %}
                <span class="badge badge--info" title="{{ 'Submit your application'|t }}">
                  {{ 'Application Pending'|t }}
                </span>
              {% elseif wf == 'pending_response' %}
                <span class="badge badge--success" title="{{ 'Waiting for company response'|t }}">
                  {{ 'Pending Response'|t }}
                </span>
              {% elseif wf == 'closed' %}
                <span class="badge badge--neutral" title="{{ 'This application cycle is complete'|t }}">
                  {{ 'Closed'|t }}
                </span>
              {% endif %}
            </td>
            <td class="operations">
              <div class="operation-item">
              {% if wf == 'profile_pending' %}
                <a href="/jobhunter/profile" class="button button--small button--primary">
                  {{ 'Complete Profile'|t }}
                </a>
              {% elseif wf == 'tailoring_pending' %}
                <a href="/jobhunter/tailor-resume/{{ job.id }}" class="button button--small button--primary">
                  {{ 'Tailor Resume'|t }}
                </a>
              {% elseif wf == 'tailoring_processing' %}
                <span class="status-text status-text--muted">{{ 'Processing...'|t }}</span>
              {% elseif wf == 'approval_pending' %}
                <a href="{{ path('job_hunter.generate_tailored_resume_pdf_redirect', {'job_id': job.id}, {'query': {'return_to': return_url}}) }}"
                   class="button button--small button--primary"
                   onclick="return confirm('{{ 'Generate PDF now? Your status will update once generation succeeds.'|t }}')">
                  {{ 'Generate PDF'|t }}
                </a>
              {% elseif wf == 'application_pending' %}
                <a href="/jobhunter/jobs/{{ job.id }}/apply" class="button button--small button--primary">
                  {{ 'Submit Application'|t }}
                </a>
              {% elseif wf == 'pending_response' %}
                <span class="status-text status-text--muted">{{ 'Awaiting response'|t }}</span>
              {% elseif wf == 'closed' %}
                <span class="status-text status-text--muted">&mdash;</span>
              {% endif %}
              </div>

              {# Secondary actions always available #}
              <div class="operation-item">
                <a href="/jobhunter/tailor-resume/{{ job.id }}" class="button button--small button--secondary" title="{{ 'Open tailoring page'|t }}">
                  {{ 'Tailoring Page'|t }}
                </a>
              </div>
              <div class="operation-item">
                <a href="{{ path('job_hunter.job_view', {'job_id': job.id}) }}" class="button button--small button--secondary" title="{{ 'View job details'|t }}">
                  {{ 'View'|t }}
                </a>
              </div>
              <div class="operation-item">
                <a href="{{ path('job_hunter.job_archive', {'job_id': job.id}, {'query': {'return_to': return_url}}) }}"
                   class="button button--small button--warning"
                   onclick="return confirm('{{ 'Archive this job? You can restore it from Archived Jobs.'|t }}')"
                   title="{{ 'Archive this job'|t }}">
                  {{ 'Archive'|t }}
                </a>
              </div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <div class="empty-state">
      <p>
        {{ 'No job postings saved yet.'|t }}
        <a href="/jobhunter/job/paste">{{ 'Add your first job'|t }}</a>
        {{ 'or'|t }}
        <a href="/jobhunter/job-discovery">{{ 'search for jobs'|t }}</a>
        {{ 'to get started.'|t }}
      </p>
    </div>
  {% endif %}

  {% if total_pages > 1 %}
    <nav class="pager" aria-label="{{ 'Pagination'|t }}">
      <ul class="pager__items">
        {% if current_page > 0 %}
          <li class="pager__item pager__item--previous">
            <a href="?page={{ current_page - 1 }}{% if filter_company %}&company={{ filter_company }}{% endif %}{% if filter_status %}&status={{ filter_status }}{% endif %}{% if filter_platform %}&platform={{ filter_platform }}{% endif %}" rel="prev">
              &lsaquo; {{ 'Previous'|t }}
            </a>
          </li>
        {% endif %}
        <li class="pager__item pager__item--current">
          {{ 'Page %current of %total'|t({'%current': current_page + 1, '%total': total_pages}) }}
        </li>
        {% if current_page < total_pages - 1 %}
          <li class="pager__item pager__item--next">
            <a href="?page={{ current_page + 1 }}{% if filter_company %}&company={{ filter_company }}{% endif %}{% if filter_status %}&status={{ filter_status }}{% endif %}{% if filter_platform %}&platform={{ filter_platform }}{% endif %}" rel="next">
              {{ 'Next'|t }} &rsaquo;
            </a>
          </li>
        {% endif %}
      </ul>
    </nav>
  {% endif %}

</div>
