/**
 * Add external source tracking columns to jobhunter_job_requirements.
 */
function job_hunter_update_9016() {
  $schema = \Drupal::database()->schema();
  $messages = [];
  
  if (!$schema->tableExists('jobhunter_job_requirements')) {
    return t('Table jobhunter_job_requirements does not exist.');
  }
  
  // Add external_source column
  if (!$schema->fieldExists('jobhunter_job_requirements', 'external_source')) {
    $schema->addField('jobhunter_job_requirements', 'external_source', [
      'type' => 'varchar',
      'length' => 100,
      'description' => 'External source: cloud_talent_solution, linkedin, indeed, etc.',
    ]);
    $messages[] = 'Added external_source column';
  }
  
  // Add external_job_id column
  if (!$schema->fieldExists('jobhunter_job_requirements', 'external_job_id')) {
    $schema->addField('jobhunter_job_requirements', 'external_job_id', [
      'type' => 'varchar',
      'length' => 512,
      'description' => 'External job ID from source system',
    ]);
    $schema->addIndex('jobhunter_job_requirements', 'external_job_id', [['external_job_id', 100]]);
    $messages[] = 'Added external_job_id column';
  }
  
  // Add created_by_user_id column
  if (!$schema->fieldExists('jobhunter_job_requirements', 'created_by_user_id')) {
    $schema->addField('jobhunter_job_requirements', 'created_by_user_id', [
      'type' => 'int',
      'description' => 'User ID who created/imported this job',
    ]);
    $messages[] = 'Added created_by_user_id column';
  }
  
  // Add application_url column
  if (!$schema->fieldExists('jobhunter_job_requirements', 'application_url')) {
    $schema->addField('jobhunter_job_requirements', 'application_url', [
      'type' => 'varchar',
      'length' => 512,
      'description' => 'Direct application URL for the job',
    ]);
    $messages[] = 'Added application_url column';
  }
  
  // Add created_at and updated_at timestamp columns (complement existing created/updated)
  if (!$schema->fieldExists('jobhunter_job_requirements', 'created_at')) {
    $schema->addField('jobhunter_job_requirements', 'created_at', [
      'type' => 'varchar',
      'length' => 50,
      'description' => 'ISO 8601 timestamp when job was created',
    ]);
    $messages[] = 'Added created_at column';
  }
  
  if (!$schema->fieldExists('jobhunter_job_requirements', 'updated_at')) {
    $schema->addField('jobhunter_job_requirements', 'updated_at', [
      'type' => 'varchar',
      'length' => 50,
      'description' => 'ISO 8601 timestamp when job was last updated',
    ]);
    $messages[] = 'Added updated_at column';
  }
  
  if (empty($messages)) {
    return t('No update needed - all columns already exist.');
  }
  
  return t('Updated jobhunter_job_requirements table: @changes', [
    '@changes' => implode(', ', $messages),
  ]);
}

/**
 * Ensure jobhunter_tailored_resumes table has all required columns.
 */
function job_hunter_update_9017() {
  $schema = \Drupal::database()->schema();
  $messages = [];
  
  if (!$schema->tableExists('jobhunter_tailored_resumes')) {
    // Table doesn't exist, create it
    _job_hunter_create_tailored_resumes_table();
    return t('Created jobhunter_tailored_resumes table with all columns.');
  }
  
  // Ensure all required columns exist
  $columns_to_add = [
    'tailored_resume_json' => [
      'type' => 'text',
      'size' => 'big',
      'description' => 'AI-generated tailored resume JSON',
    ],
    'tailoring_status' => [
      'type' => 'varchar',
      'length' => 32,
      'default' => 'pending',
      'description' => 'pending, completed, failed',
    ],
    'pdf_path' => [
      'type' => 'varchar',
      'length' => 512,
      'description' => 'Path to generated PDF file',
    ],
    'pdf_generated' => [
      'type' => 'int',
      'default' => 0,
      'description' => 'Timestamp when PDF was generated',
    ],
    'created' => [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
    ],
    'updated' => [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
    ],
    'uid' => [
      'type' => 'int',
      'not null' => TRUE,
      'description' => 'User ID',
    ],
    'job_id' => [
      'type' => 'int',
      'not null' => TRUE,
      'description' => 'Job requirement ID',
    ],
  ];
  
  foreach ($columns_to_add as $column_name => $spec) {
    if (!$schema->fieldExists('jobhunter_tailored_resumes', $column_name)) {
      $schema->addField('jobhunter_tailored_resumes', $column_name, $spec);
      $messages[] = $column_name;
    }
  }
  
  if (empty($messages)) {
    return t('No update needed - all columns already exist in jobhunter_tailored_resumes table.');
  }
  
  return t('Added missing columns to jobhunter_tailored_resumes: @columns', [
    '@columns' => implode(', ', $messages),
  ]);
}

