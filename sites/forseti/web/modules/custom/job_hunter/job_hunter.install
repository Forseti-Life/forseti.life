/**
 * Add extracted_text column to jobhunter_job_seeker_resumes table.
 */
function job_hunter_update_9001() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('jobhunter_job_seeker_resumes')) {
    if (!$schema->fieldExists('jobhunter_job_seeker_resumes', 'extracted_text')) {
      $spec = [
        'type' => 'text',
        'size' => 'big',
        'description' => 'Extracted text from resume file',
      ];
      $schema->addField('jobhunter_job_seeker_resumes', 'extracted_text', $spec);
      return t('Added extracted_text column to jobhunter_job_seeker_resumes table.');
    }
  }
  return t('No update needed - extracted_text column already exists.');
}

/**
 * Add JSON storage columns to jobhunter_job_requirements for job tailoring workflow.
 */
function job_hunter_update_9002() {
  $schema = \Drupal::database()->schema();
  $messages = [];
  
  if (!$schema->tableExists('jobhunter_job_requirements')) {
    return t('Table jobhunter_job_requirements does not exist.');
  }
  
  $new_fields = [
    'raw_posting_text' => [
      'type' => 'text',
      'size' => 'big',
      'description' => 'Original pasted job posting text',
    ],
    'extracted_json' => [
      'type' => 'text',
      'size' => 'big',
      'description' => 'AI-extracted structured job data',
    ],
    'skills_required_json' => [
      'type' => 'text',
      'size' => 'big',
      'description' => 'Must-have and nice-to-have skills',
    ],
    'keywords_json' => [
      'type' => 'text',
      'size' => 'big',
      'description' => 'Important keywords from posting',
    ],
    'source_platform' => [
      'type' => 'varchar',
      'length' => 100,
      'description' => 'linkedin, indeed, company_site, etc.',
    ],
    'ai_extraction_status' => [
      'type' => 'varchar',
      'length' => 32,
      'default' => 'pending',
      'description' => 'pending, completed, failed',
    ],
  ];
  
  foreach ($new_fields as $field_name => $spec) {
    if (!$schema->fieldExists('jobhunter_job_requirements', $field_name)) {
      $schema->addField('jobhunter_job_requirements', $field_name, $spec);
      $messages[] = $field_name;
    }
  }
  
  if (empty($messages)) {
    return t('No update needed - all JSON columns already exist.');
  }
  
  return t('Added columns to jobhunter_job_requirements: @columns', [
    '@columns' => implode(', ', $messages),
  ]);
}

/**
 * Create jobhunter_tailored_resumes table for user-specific tailored resumes.
 */
function job_hunter_update_9003() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('jobhunter_tailored_resumes')) {
    return t('Table jobhunter_tailored_resumes already exists.');
  }
  
  _job_hunter_create_tailored_resumes_table();
  
  return t('Created jobhunter_tailored_resumes table.');
}

