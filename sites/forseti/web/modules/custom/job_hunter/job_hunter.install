<?php

/**
 * @file
 * Install, update and uninstall functions for the Job Hunter module.
 * 
 * DATA PRESERVATION POLICY:
 * This module preserves all custom tables during uninstallation.
 * Only module configuration is removed during uninstall.
 */

/**
 * Implements hook_schema().
 */
function job_hunter_schema() {
  // Custom tables created in hook_install() to prevent auto-deletion
  return [];
}

/**
 * Implements hook_requirements().
 */
function job_hunter_requirements($phase) {
  $requirements = [];
  
  if ($phase === 'uninstall') {
    $requirements['job_hunter_data_preservation'] = [
      'title' => t('Job Hunter - Data Preservation'),
      'value' => t('All custom tables will be preserved'),
      'description' => t('Custom database tables will NOT be deleted during uninstall to prevent data loss. Manual cleanup available via database tools if needed.'),
      'severity' => REQUIREMENT_INFO,
    ];
  }
  
  return $requirements;
}

/**
 * Implements hook_install().
 */
function job_hunter_install() {
  $messenger = \Drupal::messenger();
  $logger = \Drupal::logger('job_hunter');
  
  try {
    $logger->info('Installing Job Hunter module...');
    
    // Create all custom tables
    _job_hunter_create_companies_table();
    _job_hunter_create_job_requirements_table();
    _job_hunter_create_job_seeker_table();
    _job_hunter_create_job_history_table();
    _job_hunter_create_education_history_table();
    _job_hunter_create_resume_parsed_data_table();
    _job_hunter_create_job_seeker_resumes_table();
    _job_hunter_create_tailored_resumes_table();
    _job_hunter_create_pdf_history_table();
    _job_hunter_create_queue_suspended_table();
    _job_hunter_create_google_jobs_sync_table();
    _job_hunter_create_google_jobs_validation_log_table();
    _job_hunter_create_job_search_queries_table();
    _job_hunter_create_job_search_results_table();
    
    $messenger->addMessage(t('Job Hunter module installed successfully. Custom database tables created.'));
    $logger->info('Job Hunter module installation completed.');
    
  }
  catch (\Exception $e) {
    $messenger->addError(t('Error installing Job Hunter module: @error', ['@error' => $e->getMessage()]));
    $logger->error('Installation error: @error', ['@error' => $e->getMessage()]);
    throw $e;
  }
}

/**
 * Implements hook_uninstall().
 */
function job_hunter_uninstall() {
  $messenger = \Drupal::messenger();
  $logger = \Drupal::logger('job_hunter');
  
  try {
    $logger->info('Uninstalling Job Hunter module...');
    
    // Only remove module configuration - preserve all tables and data
    \Drupal::configFactory()->getEditable('job_hunter.settings')->delete();
    
    $messenger->addStatus(t('Job Hunter module uninstalled. All custom tables and data preserved.'));
    $logger->info('Job Hunter module uninstalled - data preserved.');
    
  }
  catch (\Exception $e) {
    $messenger->addError(t('Error uninstalling Job Hunter module: @error', ['@error' => $e->getMessage()]));
    $logger->error('Uninstallation error: @error', ['@error' => $e->getMessage()]);
  }
}

/**
 * Create jobhunter_companies table.
 */
function _job_hunter_create_companies_table() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('jobhunter_companies')) {
    return;
  }
  
  $table_schema = [
    'description' => 'Target companies for job hunting.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'description' => ['type' => 'text', 'size' => 'big', 'description' => 'Company description'],
      'website' => ['type' => 'varchar', 'length' => 512],
      'careers_page_url' => ['type' => 'varchar', 'length' => 512],
      'industry' => ['type' => 'varchar', 'length' => 100],
      'location' => ['type' => 'varchar', 'length' => 255],
      'active' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'notes' => ['type' => 'text', 'size' => 'big'],
      'cloud_talent_company_name' => ['type' => 'varchar', 'length' => 255, 'description' => 'Company resource name in Google Cloud Talent Solution API (e.g., projects/{project}/companies/{company})'],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'updated' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => ['active' => ['active'], 'name' => ['name'], 'cloud_talent_company_name' => ['cloud_talent_company_name']],
  ];
  
  $schema->createTable('jobhunter_companies', $table_schema);
}

/**
 * Create jobhunter_job_requirements table.
 */
function _job_hunter_create_job_requirements_table() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('jobhunter_job_requirements')) {
    return;
  }
  
  $table_schema = [
    'description' => 'Job requirements and postings.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'company_id' => ['type' => 'int'],
      'job_title' => ['type' => 'varchar', 'length' => 255],
      'job_description' => ['type' => 'text', 'size' => 'big'],
      'requirements' => ['type' => 'text', 'size' => 'big'],
      'salary_range' => ['type' => 'varchar', 'length' => 100],
      'location' => ['type' => 'varchar', 'length' => 255],
      'remote_option' => ['type' => 'varchar', 'length' => 50],
      'employment_type' => ['type' => 'varchar', 'length' => 50],
      'job_url' => ['type' => 'varchar', 'length' => 512],
      'status' => ['type' => 'varchar', 'length' => 50, 'not null' => TRUE, 'default' => 'active'],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'updated' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      // JSON storage fields for job tailoring workflow
      'raw_posting_text' => ['type' => 'text', 'size' => 'big', 'description' => 'Original pasted job posting text'],
      'extracted_json' => ['type' => 'text', 'size' => 'big', 'description' => 'AI-extracted structured job data'],
      'skills_required_json' => ['type' => 'text', 'size' => 'big', 'description' => 'Must-have and nice-to-have skills'],
      'keywords_json' => ['type' => 'text', 'size' => 'big', 'description' => 'Important keywords from posting'],
      'source_platform' => ['type' => 'varchar', 'length' => 100, 'description' => 'linkedin, indeed, company_site, etc.'],
      'ai_extraction_status' => ['type' => 'varchar', 'length' => 32, 'default' => 'pending', 'description' => 'pending, completed, failed'],
      'external_source' => ['type' => 'varchar', 'length' => 100, 'description' => 'External source: cloud_talent_solution, linkedin, indeed, etc.'],
      'external_job_id' => ['type' => 'varchar', 'length' => 512, 'description' => 'External job ID from source system'],
      'potential_duplicates_json' => ['type' => 'text', 'size' => 'medium', 'description' => 'JSON array of potential duplicate job IDs with similarity scores'],
    ],
    'primary key' => ['id'],
    'indexes' => ['company_id' => ['company_id'], 'status' => ['status'], 'external_job_id' => [['external_job_id', 100]]],
  ];
  
  $schema->createTable('jobhunter_job_requirements', $table_schema);
}

