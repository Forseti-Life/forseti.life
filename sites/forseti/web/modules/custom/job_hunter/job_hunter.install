    'unique keys' => ['user_job' => ['uid', 'job_id']],
    'indexes' => [
      'uid' => ['uid'],
      'job_id' => ['job_id'],
    ],
  ];
  
  $schema->createTable('jobhunter_tailored_resumes', $table_schema);
}

