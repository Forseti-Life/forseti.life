/**
 * Create jobhunter_google_jobs_sync table.
 * 
 * Tracks the sync status of job postings to Google for Jobs.
 */
function _job_hunter_create_google_jobs_sync_table() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('jobhunter_google_jobs_sync')) {
    return;
  }
  
  $table_schema = [
    'description' => 'Tracks sync status of job postings for Google for Jobs integration',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key',
      ],
      'job_id' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Reference to jobhunter_job_requirements.id',
      ],
      'structured_data_json' => [
        'type' => 'text',
        'size' => 'big',
        'description' => 'Generated JSON-LD structured data for this job',
      ],
      'is_enabled' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
        'description' => 'Whether Google Jobs integration is enabled for this job (1=enabled, 0=disabled)',
      ],
      'last_validated' => [
        'type' => 'int',
        'description' => 'Timestamp of last validation check',
      ],
      'validation_status' => [
        'type' => 'varchar',
        'length' => 50,
        'description' => 'Status: pending, valid, invalid, error',
        'default' => 'pending',
      ],
      'validation_errors' => [
        'type' => 'text',
        'description' => 'JSON array of validation errors if any',
      ],
      'google_indexing_status' => [
        'type' => 'varchar',
        'length' => 50,
        'description' => 'Status from Google Search Console: indexed, pending, error, not_found',
      ],
      'google_last_crawled' => [
        'type' => 'int',
        'description' => 'Timestamp of last Google crawl (from Search Console API)',
      ],
      'impressions_count' => [
        'type' => 'int',
        'default' => 0,
        'description' => 'Number of impressions in Google Search (from Search Console)',
      ],
      'clicks_count' => [
        'type' => 'int',
        'default' => 0,
        'description' => 'Number of clicks from Google Search (from Search Console)',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Timestamp when record was created',
      ],
      'updated' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Timestamp when record was last updated',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'job_id' => ['job_id'],
      'validation_status' => ['validation_status'],
      'is_enabled' => ['is_enabled'],
      'google_indexing_status' => ['google_indexing_status'],
    ],
    'unique keys' => [
      'unique_job' => ['job_id'],
    ],
  ];
  
  $schema->createTable('jobhunter_google_jobs_sync', $table_schema);
}

/**
 * Create jobhunter_google_jobs_validation_log table.
 * 
 * Stores history of validation attempts and results.
 */
function _job_hunter_create_google_jobs_validation_log_table() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('jobhunter_google_jobs_validation_log')) {
    return;
  }
  
  $table_schema = [
    'description' => 'Log of validation attempts for Google Jobs structured data',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key',
      ],
      'sync_id' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Reference to jobhunter_google_jobs_sync.id',
      ],
      'job_id' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Reference to jobhunter_job_requirements.id (denormalized for queries)',
      ],
      'validation_type' => [
        'type' => 'varchar',
        'length' => 50,
        'not null' => TRUE,
        'description' => 'Type of validation: schema, rich_results, search_console',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 20,
        'not null' => TRUE,
        'description' => 'Result: valid, invalid, error, warning',
      ],
      'errors' => [
        'type' => 'text',
        'description' => 'JSON array of error messages',
      ],
      'warnings' => [
        'type' => 'text',
        'description' => 'JSON array of warning messages',
      ],
      'response_data' => [
        'type' => 'text',
        'size' => 'big',
        'description' => 'Full response from validation service',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Timestamp when validation was performed',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'sync_id' => ['sync_id'],
      'job_id' => ['job_id'],
      'validation_type' => ['validation_type'],
      'status' => ['status'],
      'created' => ['created'],
    ],
  ];
  
  $schema->createTable('jobhunter_google_jobs_validation_log', $table_schema);
}

/**
 * Create jobhunter_job_search_queries table.
 * 
 * Tracks all search queries sent to Cloud Talent Solution API.
 */
function _job_hunter_create_job_search_queries_table() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('jobhunter_job_search_queries')) {
    return;
  }
  
  $table_schema = [
    'description' => 'Tracks search queries sent to Google Cloud Talent Solution API',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key',
      ],
      'uid' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'User ID who performed the search',
      ],
      'query_text' => [
        'type' => 'varchar',
        'length' => 512,
        'description' => 'Search query text',
      ],
      'location' => [
        'type' => 'varchar',
        'length' => 255,
        'description' => 'Location filter',
      ],
      'search_params_json' => [
        'type' => 'text',
        'size' => 'medium',
        'description' => 'Complete JSON of all search parameters sent to API',
      ],
      'company_name' => [
        'type' => 'varchar',
        'length' => 255,
        'description' => 'Company name filter',
      ],
      'employment_types' => [
        'type' => 'varchar',
        'length' => 255,
        'description' => 'Comma-separated employment types (FULL_TIME, PART_TIME, etc.)',
      ],
      'job_categories' => [
        'type' => 'text',
        'description' => 'Comma-separated job categories',
      ],
      'page_token' => [
        'type' => 'varchar',
        'length' => 512,
        'description' => 'Pagination token used for this query',
      ],
      'page_size' => [
        'type' => 'int',
        'default' => 10,
        'description' => 'Number of results requested',
      ],
      'total_results' => [
        'type' => 'int',
        'default' => 0,
        'description' => 'Total number of results returned by API',
      ],
      'next_page_token' => [
        'type' => 'varchar',
        'length' => 512,
        'description' => 'Next page token returned by API',
      ],
      'api_response_time_ms' => [
        'type' => 'int',
        'description' => 'API response time in milliseconds',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 50,
        'default' => 'completed',
        'description' => 'Status: completed, error, timeout',
      ],
      'error_message' => [
        'type' => 'text',
        'description' => 'Error message if status is error',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp when search was performed',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'uid' => ['uid'],
      'status' => ['status'],
      'created' => ['created'],
      'query_text' => [['query_text', 100]],
      'location' => [['location', 100]],
      'company_name' => [['company_name', 100]],
    ],
  ];
  
  $schema->createTable('jobhunter_job_search_queries', $table_schema);
}

/**
 * Create jobhunter_job_search_results table.
 * 
 * Stores individual job results from each search query.
 */
function _job_hunter_create_job_search_results_table() {
  $schema = \Drupal::database()->schema();
  
  if ($schema->tableExists('jobhunter_job_search_results')) {
    return;
  }
  
  $table_schema = [
    'description' => 'Stores individual job results from Cloud Talent Solution API searches',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key',
      ],
      'search_query_id' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Reference to jobhunter_job_search_queries.id',
      ],
      'external_job_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Google job ID (e.g., projects/{project}/companies/{company}/jobs/{job})',
      ],
      'job_title' => [
        'type' => 'varchar',
        'length' => 255,
        'description' => 'Job title from search result',
      ],
      'company_name' => [
        'type' => 'varchar',
        'length' => 255,
        'description' => 'Company name from search result',
      ],
      'location' => [
        'type' => 'varchar',
        'length' => 255,
        'description' => 'Job location',
      ],
      'job_data_json' => [
        'type' => 'text',
        'size' => 'big',
        'description' => 'Complete JSON data of the job from API',
      ],
      'rank_position' => [
        'type' => 'int',
        'description' => 'Position in search results (1-based)',
      ],
      'imported_to_job_id' => [
        'type' => 'int',
        'description' => 'Reference to jobhunter_job_requirements.id if imported',
      ],
      'imported_at' => [
        'type' => 'int',
        'description' => 'Timestamp when job was imported, NULL if not imported',
      ],
      'imported_by_uid' => [
        'type' => 'int',
        'description' => 'User ID who imported this job',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp when result was stored',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'search_query_id' => ['search_query_id'],
      'external_job_id' => [['external_job_id', 100]],
      'imported_to_job_id' => ['imported_to_job_id'],
      'imported_at' => ['imported_at'],
      'job_title' => [['job_title', 100]],
      'company_name' => [['company_name', 100]],
      'created' => ['created'],
    ],
  ];
  
  $schema->createTable('jobhunter_job_search_results', $table_schema);
}

