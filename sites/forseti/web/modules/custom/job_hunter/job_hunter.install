    return t('Column potential_duplicates_json already exists.');
  }
  
  $schema->addField('jobhunter_job_requirements', 'potential_duplicates_json', [
    'type' => 'text',
    'size' => 'medium',
    'description' => 'JSON array of potential duplicate job IDs with similarity scores',
  ]);
  
  return t('Added potential_duplicates_json column to jobhunter_job_requirements.');
}

