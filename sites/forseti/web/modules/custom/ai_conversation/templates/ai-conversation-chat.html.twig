{% if stats and stats.total_messages > 0 %}
<div class="ai-conversation-stats">
  <h3>{{ 'Conversation Statistics'|t }}</h3>
  <div class="stats-grid">
    <div class="stat-item">
      <strong>{{ 'Total Messages'|t }}:</strong> {{ stats.total_messages }}
    </div>
    <div class="stat-item">
      <strong>{{ 'Recent Messages'|t }}:</strong> {{ stats.recent_messages }}
    </div>
    <div class="stat-item">
      <strong>{{ 'Total Tokens'|t }}:</strong> {{ stats.total_tokens|number_format }}
    </div>
    <div class="stat-item">
      <strong>{{ 'Has Summary'|t }}:</strong> 
      {% if stats.has_summary %}
        <span class="status-yes">{{ 'Yes'|t }}</span>
      {% else %}
        <span class="status-no">{{ 'No'|t }}</span>
      {% endif %}
    </div>
    {% if stats.summary_updated %}
    <div class="stat-item">
      <strong>{{ 'Summary Updated'|t }}:</strong> {{ stats.summary_updated|date('M j, Y - H:i') }}
    </div>
    {% endif %}
    <div class="stat-item">
      <strong>{{ 'Context Tokens'|t }}:</strong> {{ stats.estimated_tokens|number_format }}
    </div>
  </div>
</div>
{% endif %}

<div class="ai-conversation-chat">
  <div class="chat-header">
    <h2>{{ conversation.label }}</h2>
    {% if conversation.field_context.value %}
      <div class="context-info">
        <strong>{{ 'Context'|t }}:</strong> {{ conversation.field_context.value|striptags|slice(0, 100) }}{% if conversation.field_context.value|striptags|length > 100 %}...{% endif %}
      </div>
    {% endif %}
  </div>

  <div class="chat-messages" id="chat-messages">
    {% if stats and stats.has_summary %}
      <div class="summary-indicator">
        <em>{{ 'This conversation has been summarized. Showing recent 20 messages.'|t }}</em>
      </div>
    {% endif %}
    
    {# Show introduction message for new conversations #}
    {% if not messages or messages|length == 0 %}
      <div class="message message--assistant message--introduction">
        <div class="message-content">
          <h3>Welcome to Forseti Life - AI-Powered Community Safety</h3>
          <p><strong>"AI Looking Out For Us"</strong> - I'm your Forseti AI assistant, here to help you understand how our intelligent safety platform protects Philadelphia communities through advanced technology and data analysis.</p>
          
          <div class="demo-highlights">
            <p><strong>🛡️ How Forseti Protects Communities:</strong></p>
            <ul>
              <li><strong>Real-Time Crime Mapping:</strong> H3 hexagonal geospatial analysis of Philadelphia crime data</li>
              <li><strong>AI Pattern Recognition:</strong> Machine learning identifies temporal and spatial crime patterns</li>
              <li><strong>Predictive Analytics:</strong> Forecasting high-risk areas and times to help you stay safe</li>
              <li><strong>Intelligent Alerts:</strong> Targeted notifications when safety threats emerge in your area</li>
              <li><strong>Community Engagement:</strong> Tools for neighborhood watch coordination and resource sharing</li>
            </ul>
          </div>
          
          <div class="demo-purpose">
            <p><strong>💬 Ask me about:</strong></p>
            <ul>
              <li>How Forseti's crime mapping and H3 geospatial system works</li>
              <li>Understanding safety trends and patterns in Philadelphia</li>
              <li>Using the Safety Map to check conditions in your neighborhood</li>
              <li>Our mobile app (AmISafe) for on-the-go safety monitoring</li>
              <li>Privacy protections and how we handle your data securely</li>
              <li>Community safety best practices and prevention strategies</li>
            </ul>
          </div>
          
          <p><strong>Ready to learn about community safety?</strong> Ask me anything about how Forseti's AI technology helps keep Philadelphia neighborhoods safer!</p>
          
          <div class="transparency-note">
            <em><strong>Transparency:</strong> This AI assistant is powered by Anthropic's Claude 3.5 Sonnet, demonstrating the kind of intelligent, conversational technology that makes Forseti possible. Named after the Norse god of justice, Forseti represents our commitment to fair, transparent, and effective community protection.</em>
          </div>
        </div>
      </div>
    {% endif %}
    
    {% for message in messages %}
      <div class="message message--{{ message.role }}">
        <div class="message-content">
          {{ message.content|nl2br }}
        </div>
        {% if message.timestamp %}
          <div class="message-timestamp">
            {{ message.timestamp|date('M j, H:i') }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="chat-input-container">
    <div class="input-group">
      <textarea 
        id="message-input" 
        class="form-control" 
        placeholder="{{ 'Type your message...'|t }}"
        rows="3"
      ></textarea>
      <button id="send-button" class="btn btn-primary" type="button">
        {{ 'Send'|t }}
      </button>
    </div>
    
    <div class="chat-controls">
      <button id="clear-input" class="btn btn-secondary btn-sm" type="button">
        {{ 'Clear'|t }}
      </button>
      {% if stats and stats.total_messages > 20 %}
        <button id="trigger-summary" class="btn btn-info btn-sm" type="button">
          {{ 'Update Summary'|t }}
        </button>
      {% endif %}
    </div>
  </div>

  <div id="loading-indicator" class="loading-indicator" style="display: none;">
    <div class="spinner"></div>
    <span>{{ 'AI is thinking...'|t }}</span>
  </div>
</div>

