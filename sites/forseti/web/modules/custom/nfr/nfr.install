<?php

/**
 * @file
 * Install, update and uninstall functions for the NFR module.
 */

/**
 * Implements hook_install().
 */
function nfr_install() {
  \Drupal::messenger()->addStatus(__FUNCTION__);
}

/**
 * Implements hook_uninstall().
 */
function nfr_uninstall() {
  \Drupal::messenger()->addStatus(__FUNCTION__);
}

/**
 * Add missing timestamp columns to normalized work history tables.
 */
function nfr_update_9003() {
  $schema = \Drupal::database()->schema();
  
  // Add created and updated to nfr_incident_frequency
  if (!$schema->fieldExists('nfr_incident_frequency', 'created')) {
    $schema->addField('nfr_incident_frequency', 'created', [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Timestamp when record was created',
    ]);
  }
  
  if (!$schema->fieldExists('nfr_incident_frequency', 'updated')) {
    $schema->addField('nfr_incident_frequency', 'updated', [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Timestamp when record was last updated',
    ]);
  }
  
  // Add updated to nfr_job_titles (created already exists)
  if (!$schema->fieldExists('nfr_job_titles', 'updated')) {
    $schema->addField('nfr_job_titles', 'updated', [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Timestamp when record was last updated',
    ]);
  }
  
  return t('Added timestamp columns to work history tables.');
}

/**
 * Remove generic data JSON column now that we use normalized tables and specific JSON columns.
 */
function nfr_update_9004() {
  $schema = \Drupal::database()->schema();
  
  // Drop the generic 'data' column from nfr_questionnaire
  if ($schema->fieldExists('nfr_questionnaire', 'data')) {
    $schema->dropField('nfr_questionnaire', 'data');
  }
  
  return t('Removed generic data JSON column from nfr_questionnaire table.');
}

/**
 * Add exposure_data JSON column for Section 3 data.
 */
function nfr_update_9005() {
  $schema = \Drupal::database()->schema();
  
  if (!$schema->fieldExists('nfr_questionnaire', 'exposure_data')) {
    $schema->addField('nfr_questionnaire', 'exposure_data', [
      'type' => 'text',
      'size' => 'big',
      'not null' => FALSE,
      'description' => 'JSON data for exposure information (AFFF, diesel, etc)',
    ]);
  }
  
  return t('Added exposure_data JSON column to nfr_questionnaire table.');
}

/**
 * Remove unused columns from nfr_job_titles table.
 */
function nfr_update_9006() {
  $schema = \Drupal::database()->schema();
  
  // Drop start_date and end_date - job dates aren't tracked, only department dates
  if ($schema->fieldExists('nfr_job_titles', 'start_date')) {
    $schema->dropField('nfr_job_titles', 'start_date');
  }
  if ($schema->fieldExists('nfr_job_titles', 'end_date')) {
    $schema->dropField('nfr_job_titles', 'end_date');
  }
  
  // Drop incident_types JSON - data properly stored in nfr_incident_frequency table
  if ($schema->fieldExists('nfr_job_titles', 'incident_types')) {
    $schema->dropField('nfr_job_titles', 'incident_types');
  }
  
  return t('Removed unused columns from nfr_job_titles table.');
}

/**
 * Add Section 3 exposure columns and create nfr_major_incidents table.
 */
function nfr_update_9007() {
  $schema = \Drupal::database()->schema();
  
  // Add exposure columns to nfr_questionnaire
  if (!$schema->fieldExists('nfr_questionnaire', 'afff_used')) {
    $schema->addField('nfr_questionnaire', 'afff_used', [
      'type' => 'varchar',
      'length' => 20,
      'not null' => FALSE,
      'description' => 'yes, no, unknown',
    ]);
  }
  
  if (!$schema->fieldExists('nfr_questionnaire', 'afff_times')) {
    $schema->addField('nfr_questionnaire', 'afff_times', [
      'type' => 'int',
      'not null' => FALSE,
      'description' => 'Number of times AFFF was used',
    ]);
  }
  
  if (!$schema->fieldExists('nfr_questionnaire', 'afff_first_year')) {
    $schema->addField('nfr_questionnaire', 'afff_first_year', [
      'type' => 'int',
      'not null' => FALSE,
      'description' => 'Year first used AFFF',
    ]);
  }
  
  if (!$schema->fieldExists('nfr_questionnaire', 'diesel_exhaust')) {
    $schema->addField('nfr_questionnaire', 'diesel_exhaust', [
      'type' => 'varchar',
      'length' => 20,
      'not null' => FALSE,
      'description' => 'regularly, sometimes, rarely, never',
    ]);
  }
  
  if (!$schema->fieldExists('nfr_questionnaire', 'chemical_activities')) {
    $schema->addField('nfr_questionnaire', 'chemical_activities', [
      'type' => 'text',
      'not null' => FALSE,
      'description' => 'JSON array of chemical exposure activities',
    ]);
  }
  
  if (!$schema->fieldExists('nfr_questionnaire', 'major_incidents')) {
    $schema->addField('nfr_questionnaire', 'major_incidents', [
      'type' => 'int',
      'size' => 'tiny',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Whether involved in major incidents with prolonged exposure',
    ]);
  }
  
  // Create nfr_major_incidents table
  if (!$schema->tableExists('nfr_major_incidents')) {
    $schema->createTable('nfr_major_incidents', [
      'description' => 'Stores major incidents with prolonged/intense exposure',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'not null' => TRUE,
        ],
        'uid' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'description' => [
          'type' => 'text',
          'not null' => FALSE,
          'description' => 'Event description',
        ],
        'incident_date' => [
          'type' => 'varchar',
          'length' => 10,
          'not null' => FALSE,
          'description' => 'YYYY-MM-DD',
        ],
        'duration' => [
          'type' => 'varchar',
          'length' => 20,
          'not null' => FALSE,
          'description' => 'hours, days, weeks, months',
        ],
        'created' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
        'updated' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'uid' => ['uid'],
      ],
    ]);
  }
  
  // Create nfr_other_employment table if it doesn't exist
  if (!$schema->tableExists('nfr_other_employment')) {
    $schema->createTable('nfr_other_employment', [
      'fields' => [
        'id' => [
          'type' => 'serial',
          'not null' => TRUE,
        ],
        'uid' => [
          'type' => 'int',
          'not null' => TRUE,
          'description' => 'User ID',
        ],
        'occupation' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => FALSE,
        ],
        'industry' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => FALSE,
        ],
        'start_year' => [
          'type' => 'int',
          'not null' => FALSE,
        ],
        'end_year' => [
          'type' => 'int',
          'not null' => FALSE,
        ],
        'exposures' => [
          'type' => 'text',
          'not null' => FALSE,
          'description' => 'JSON array of exposure types',
        ],
        'exposures_other' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => FALSE,
        ],
        'created' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
        'updated' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'uid' => ['uid'],
      ],
    ]);
  }
  
  // Create nfr_cancer_diagnoses table if it doesn't exist
  if (!$schema->tableExists('nfr_cancer_diagnoses')) {
    $schema->createTable('nfr_cancer_diagnoses', [
      'fields' => [
        'id' => [
          'type' => 'serial',
          'not null' => TRUE,
        ],
        'uid' => [
          'type' => 'int',
          'not null' => TRUE,
          'description' => 'User ID',
        ],
        'cancer_type' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => FALSE,
        ],
        'year_diagnosed' => [
          'type' => 'int',
          'not null' => FALSE,
        ],
        'created' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
        'updated' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'uid' => ['uid'],
      ],
    ]);
  }
  
  return t('Added Section 3 exposure columns and created nfr_major_incidents table.');
}

/**
 * Create nfr_cancer_diagnoses table and add health condition columns.
 */
function nfr_update_9012() {
  $schema = \Drupal::database()->schema();
  $database = \Drupal::database();
  
  // Create nfr_cancer_diagnoses table
  if (!$schema->tableExists('nfr_cancer_diagnoses')) {
    $schema->createTable('nfr_cancer_diagnoses', [
      'fields' => [
        'id' => [
          'type' => 'serial',
          'not null' => TRUE,
        ],
        'uid' => [
          'type' => 'int',
          'not null' => TRUE,
          'description' => 'User ID',
        ],
        'cancer_type' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => FALSE,
        ],
        'year_diagnosed' => [
          'type' => 'int',
          'not null' => FALSE,
        ],
        'created' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
        'updated' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'uid' => ['uid'],
      ],
    ]);
  }
  
  // Add health condition columns
  $conditions = ['heart_disease', 'copd', 'asthma', 'diabetes'];
  foreach ($conditions as $condition) {
    $col_name = 'health_' . $condition;
    if (!$schema->fieldExists('nfr_questionnaire', $col_name)) {
      $schema->addField('nfr_questionnaire', $col_name, [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ]);
    }
  }
  
  // Migrate data from cancer_details JSON to new structures
  if ($schema->fieldExists('nfr_questionnaire', 'cancer_details')) {
    $results = $database->select('nfr_questionnaire', 'q')
      ->fields('q', ['uid', 'cancer_details'])
      ->condition('cancer_details', '', '<>')
      ->isNotNull('cancer_details')
      ->execute();
    
    $time = \Drupal::time()->getRequestTime();
    
    foreach ($results as $row) {
      $data = json_decode($row->cancer_details, TRUE);
      if (!empty($data)) {
        // Migrate cancer diagnoses to new table
        if (!empty($data['cancers']) && is_array($data['cancers'])) {
          foreach ($data['cancers'] as $cancer) {
            if (!empty($cancer['type'])) {
              $database->insert('nfr_cancer_diagnoses')
                ->fields([
                  'uid' => $row->uid,
                  'cancer_type' => $cancer['type'],
                  'year_diagnosed' => !empty($cancer['year_diagnosed']) ? (int) $cancer['year_diagnosed'] : NULL,
                  'created' => $time,
                  'updated' => $time,
                ])
                ->execute();
            }
          }
        }
        
        // Migrate other conditions to boolean columns
        if (!empty($data['other_conditions']) && is_array($data['other_conditions'])) {
          $update_fields = [];
          foreach ($conditions as $condition) {
            if (in_array($condition, $data['other_conditions'])) {
              $update_fields['health_' . $condition] = 1;
            }
          }
          
          if (!empty($update_fields)) {
            $database->update('nfr_questionnaire')
              ->fields($update_fields)
              ->condition('uid', $row->uid)
              ->execute();
          }
        }
      }
    }
    
    // Drop the old JSON column
    $schema->dropField('nfr_questionnaire', 'cancer_details');
  }
  
  return t('Created nfr_cancer_diagnoses table and added health condition columns.');
}

/**
 * Create nfr_section_completion table for individual section tracking.
 */
function nfr_update_9013() {
  $schema = \Drupal::database()->schema();
  
  // Create the section completion tracking table
  if (!$schema->tableExists('nfr_section_completion')) {
    $table = [
      'description' => 'Tracks individual section completion status for questionnaire.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'not null' => TRUE,
          'description' => 'Primary key',
        ],
        'uid' => [
          'type' => 'int',
          'not null' => TRUE,
          'description' => 'User ID',
        ],
        'section_number' => [
          'type' => 'int',
          'size' => 'tiny',
          'not null' => TRUE,
          'description' => 'Section number (1-9)',
        ],
        'completed' => [
          'type' => 'int',
          'size' => 'tiny',
          'not null' => TRUE,
          'default' => 0,
          'description' => 'Whether section is completed (0 or 1)',
        ],
        'completed_at' => [
          'type' => 'int',
          'not null' => FALSE,
          'description' => 'Timestamp when section was completed',
        ],
        'updated' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
          'description' => 'Timestamp when record was last updated',
        ],
      ],
      'primary key' => ['id'],
      'unique keys' => [
        'uid_section' => ['uid', 'section_number'],
      ],
      'indexes' => [
        'uid' => ['uid'],
        'section_number' => ['section_number'],
      ],
    ];
    
    $schema->createTable('nfr_section_completion', $table);
  }
  
  // Migrate existing progress from last_section_completed
  $database = \Drupal::database();
  $questionnaires = $database->select('nfr_questionnaire', 'q')
    ->fields('q', ['uid', 'last_section_completed'])
    ->execute();
  
  foreach ($questionnaires as $row) {
    if ($row->last_section_completed > 0) {
      // Mark all sections up to last_section_completed as complete
      for ($section = 1; $section <= $row->last_section_completed; $section++) {
        $database->merge('nfr_section_completion')
          ->keys([
            'uid' => $row->uid,
            'section_number' => $section,
          ])
          ->fields([
            'completed' => 1,
            'completed_at' => time(),
            'updated' => time(),
          ])
          ->execute();
      }
    }
  }
  
  return t('Created nfr_section_completion table and migrated existing progress.');
}

