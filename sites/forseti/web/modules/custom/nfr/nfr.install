          'type' => 'varchar',
          'length' => 255,
          'not null' => FALSE,
        ],
        'industry' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => FALSE,
        ],
        'start_year' => [
          'type' => 'int',
          'not null' => FALSE,
        ],
        'end_year' => [
          'type' => 'int',
          'not null' => FALSE,
        ],
        'exposures' => [
          'type' => 'text',
          'not null' => FALSE,
          'description' => 'JSON array of exposure types',
        ],
        'exposures_other' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => FALSE,
        ],
        'created' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
        'updated' => [
          'type' => 'int',
