      if (!empty($data)) {
        // Update had_other_jobs
        if (isset($data['had_other_jobs'])) {
          $database->update('nfr_questionnaire')
            ->fields(['had_other_jobs' => $data['had_other_jobs']])
            ->condition('uid', $row->uid)
            ->execute();
        }
        
        // Migrate jobs to new table
        if (!empty($data['jobs']) && is_array($data['jobs'])) {
          foreach ($data['jobs'] as $job) {
            $database->insert('nfr_other_employment')
              ->fields([
                'uid' => $row->uid,
                'occupation' => $job['occupation'] ?? '',
                'industry' => $job['industry'] ?? '',
                'start_year' => $job['start_year'] ?? NULL,
                'end_year' => $job['end_year'] ?? NULL,
                'exposures' => !empty($job['exposures']) ? json_encode(array_filter($job['exposures'])) : NULL,
                'exposures_other' => $job['exposures_other'] ?? '',
                'created' => $time,
                'updated' => $time,
              ])
              ->execute();
          }
        }
      }
    }
    
    // Drop the old JSON column
    $schema->dropField('nfr_questionnaire', 'other_employment_data');
  }
  
  return t('Created nfr_other_employment table and migrated data from JSON.');
}

/**
 * Add missing military service columns.
 */
function nfr_update_9008() {
  $schema = \Drupal::database()->schema();
  
  // Add military_start_date
  if (!$schema->fieldExists('nfr_questionnaire', 'military_start_date')) {
    $schema->addField('nfr_questionnaire', 'military_start_date', [
      'type' => 'varchar',
      'mysql_type' => 'date',
      'not null' => FALSE,
    ]);
  }
  
  // Add military_end_date
  if (!$schema->fieldExists('nfr_questionnaire', 'military_end_date')) {
    $schema->addField('nfr_questionnaire', 'military_end_date', [
      'type' => 'varchar',
      'mysql_type' => 'date',
      'not null' => FALSE,
    ]);
  }
  
  // Add military_currently_serving
  if (!$schema->fieldExists('nfr_questionnaire', 'military_currently_serving')) {
    $schema->addField('nfr_questionnaire', 'military_currently_serving', [
      'type' => 'int',
      'size' => 'tiny',
      'not null' => TRUE,
      'default' => 0,
    ]);
  }
  
  // Add military_was_firefighter
  if (!$schema->fieldExists('nfr_questionnaire', 'military_was_firefighter')) {
    $schema->addField('nfr_questionnaire', 'military_was_firefighter', [
      'type' => 'varchar',
      'length' => 10,
      'not null' => FALSE,
    ]);
  }
  
  // Add military_firefighting_duties
  if (!$schema->fieldExists('nfr_questionnaire', 'military_firefighting_duties')) {
    $schema->addField('nfr_questionnaire', 'military_firefighting_duties', [
      'type' => 'text',
      'not null' => FALSE,
    ]);
  }
  
  // Drop unused military_years column
  if ($schema->fieldExists('nfr_questionnaire', 'military_years')) {
    $schema->dropField('nfr_questionnaire', 'military_years');
  }
  
  return t('Added missing military service columns and removed unused military_years column.');
}

