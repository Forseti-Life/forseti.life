{#
/**
 * @file
 * Act overview template for story structure
 *
 * Available variables:
 * - act: Act data including title, description, themes, progression, and world building
 */
#}

<div class="act-overview cyberpunk-container">
  
  <div class="page-header">
    <h1 class="page-title glitch-text" data-text="{{ act.title }}">
      {{ act.title }}
    </h1>
    <div class="page-description">
      {{ act.description }}
    </div>
  </div>

  <!-- Major Themes Section -->
  <div class="themes-section timeline-section">
    <h2 class="section-title">Major Themes</h2>
    <div class="timeline-container">
      <div class="timeline-bar"></div>
      {% for theme in act.major_themes %}
        <div class="timeline-item theme-card">
          <div class="timeline-marker">{{ loop.index }}</div>
          <div class="timeline-content">
            <h3 class="theme-title">{{ theme.theme }}</h3>
            <p class="theme-description">{{ theme.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Act Progression Section -->
  <div class="progression-section timeline-section">
    <h2 class="section-title">Story Progression</h2>
    <div class="timeline-container">
      <div class="timeline-bar"></div>
      <div class="timeline-item progression-item">
        <div class="timeline-marker">1</div>
        <div class="timeline-content">
          <div class="progression-marker">Opening</div>
          <div class="progression-content">{{ act.act_progression.opening }}</div>
        </div>
      </div>
      <div class="timeline-item progression-item">
        <div class="timeline-marker">2</div>
        <div class="timeline-content">
          <div class="progression-marker">Inciting Incident</div>
          <div class="progression-content">{{ act.act_progression.inciting_incident }}</div>
        </div>
      </div>
      <div class="timeline-item progression-item">
        <div class="timeline-marker">3</div>
        <div class="timeline-content">
          <div class="progression-marker">Rising Action</div>
          <div class="progression-content">{{ act.act_progression.rising_action }}</div>
        </div>
      </div>
      <div class="timeline-item progression-item">
        <div class="timeline-marker">4</div>
        <div class="timeline-content">
          <div class="progression-marker">Midpoint</div>
          <div class="progression-content">{{ act.act_progression.midpoint }}</div>
        </div>
      </div>
      <div class="timeline-item progression-item">
        <div class="timeline-marker">5</div>
        <div class="timeline-content">
          <div class="progression-marker">Climax</div>
          <div class="progression-content">{{ act.act_progression.climax }}</div>
        </div>
      </div>
      <div class="timeline-item progression-item">
        <div class="timeline-marker">6</div>
        <div class="timeline-content">
          <div class="progression-marker">Resolution</div>
          <div class="progression-content">{{ act.act_progression.resolution }}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- World Building Section -->
  <div class="world-building-section timeline-section">
    <h2 class="section-title">World Building Elements</h2>
    <div class="timeline-container">
      <div class="timeline-bar"></div>
      {% for element in act.world_building_elements %}
        <div class="timeline-item world-building-card">
          <div class="timeline-marker">{{ loop.index }}</div>
          <div class="timeline-content">
            <h3 class="world-building-title">{{ element.element }}</h3>
            <p class="world-building-description">{{ element.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="act-navigation">
    <a href="/characters" class="cyberpunk-btn">View Characters</a>
    {% if 'ACT I' in act.title %}
      <a href="/story/act-ii" class="cyberpunk-btn">Continue to Act II</a>
    {% elseif 'ACT II' in act.title %}
      <a href="/story/act-i" class="cyberpunk-btn">Back to Act I</a>
    {% endif %}
    <a href="/setting/philadelphia-2085" class="cyberpunk-btn">Explore Setting</a>
  </div>

</div>

<style>
/* Timeline Styles for Act Overview */
.timeline-section {
  margin: 4rem 0;
}

.section-title {
  font-family: 'Orbitron', monospace;
  font-size: 2.5rem;
  color: #00ffff;
  text-shadow: 0 0 20px rgba(0, 255, 255, 0.6);
  text-align: center;
  margin-bottom: 3rem;
  letter-spacing: 3px;
  text-transform: uppercase;
}

.timeline-container {
  position: relative;
  max-width: 1200px;
  margin: 0 auto;
  padding-left: 4rem;
}

.timeline-bar {
  position: absolute;
  left: 2rem;
  top: 0;
  bottom: 0;
  width: 4px;
  background: linear-gradient(180deg, #00ffff 0%, #ff00ff 50%, #ffff00 100%);
  box-shadow: 0 0 20px rgba(0, 255, 255, 0.6);
}

.timeline-item {
  position: relative;
  margin-bottom: 3rem;
  background: linear-gradient(135deg, rgba(26, 26, 26, 0.95), rgba(17, 17, 17, 0.9));
  border: 2px solid rgba(0, 255, 255, 0.3);
  border-radius: 8px;
  padding: 2rem;
  margin-left: 2rem;
  overflow: hidden;
  transition: all 0.4s ease;
}

.timeline-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: repeating-linear-gradient(
    45deg,
    transparent,
    transparent 20px,
    rgba(0, 255, 255, 0.02) 20px,
    rgba(0, 255, 255, 0.02) 40px
  );
  pointer-events: none;
}

.timeline-item:hover {
  transform: translateX(10px);
  border-color: #00ffff;
  box-shadow: 0 10px 30px rgba(0, 255, 255, 0.3);
}

.timeline-marker {
  position: absolute;
  left: -4.5rem;
  top: 50%;
  transform: translateY(-50%);
  width: 3rem;
  height: 3rem;
  background: linear-gradient(45deg, #00ffff, #ff00ff);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Orbitron', monospace;
  font-weight: bold;
  color: #000000;
  font-size: 1.2rem;
  box-shadow: 0 0 20px rgba(0, 255, 255, 0.8);
  z-index: 10;
}

.timeline-content {
  position: relative;
  z-index: 5;
}

/* Theme Card Styles */
.theme-title, .world-building-title {
  font-family: 'Orbitron', monospace;
  font-size: 1.5rem;
  color: #00ffff;
  text-shadow: 0 0 10px rgba(0, 255, 255, 0.6);
  margin-bottom: 1rem;
  letter-spacing: 2px;
}

.theme-description, .world-building-description {
  color: rgba(255, 255, 255, 0.9);
  font-family: 'Rajdhani', sans-serif;
  line-height: 1.6;
  font-size: 1.1rem;
}

/* Progression Item Styles */
.progression-marker {
  font-family: 'Orbitron', monospace;
  font-size: 1.3rem;
  color: #ff00ff;
  text-shadow: 0 0 10px rgba(255, 0, 255, 0.6);
  margin-bottom: 0.5rem;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.progression-content {
  color: rgba(255, 255, 255, 0.9);
  font-family: 'Rajdhani', sans-serif;
  line-height: 1.6;
  font-size: 1.1rem;
}

/* Different colors for different section types */
.themes-section .timeline-item:hover {
  border-color: #00ff41;
  box-shadow: 0 10px 30px rgba(0, 255, 65, 0.3);
}

.themes-section .timeline-marker {
  background: linear-gradient(45deg, #00ff41, #00ffff);
}

.progression-section .timeline-item:hover {
  border-color: #ff00ff;
  box-shadow: 0 10px 30px rgba(255, 0, 255, 0.3);
}

.progression-section .timeline-marker {
  background: linear-gradient(45deg, #ff00ff, #ff0040);
}

.world-building-section .timeline-item:hover {
  border-color: #ffff00;
  box-shadow: 0 10px 30px rgba(255, 255, 0, 0.3);
}

.world-building-section .timeline-marker {
  background: linear-gradient(45deg, #ffff00, #ff6900);
}

/* Navigation Buttons */
.act-navigation {
  text-align: center;
  margin: 4rem 0;
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
  justify-content: center;
  align-items: center;
}

.cyberpunk-btn {
  background: linear-gradient(45deg, #000000, #1a1a1a);
  border: 3px solid #00ffff;
  color: #00ffff;
  padding: 1.5rem 3rem;
  text-decoration: none;
  font-family: 'Orbitron', monospace;
  font-weight: bold;
  font-size: 1.2rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  transition: all 0.4s ease;
  display: inline-block;
  position: relative;
  overflow: hidden;
  border-radius: 8px;
  min-width: 200px;
  text-shadow: 0 0 10px rgba(0, 255, 255, 0.8);
  box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
}

.cyberpunk-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.4), transparent);
  transition: left 0.5s;
  z-index: 1;
}

.cyberpunk-btn:hover {
  color: #ffffff;
  background: linear-gradient(45deg, #003333, #006666);
  border-color: #ffffff;
  text-shadow: 0 0 15px rgba(255, 255, 255, 1);
  box-shadow: 0 0 30px rgba(0, 255, 255, 0.6), inset 0 0 20px rgba(0, 255, 255, 0.1);
  transform: translateY(-3px);
}

.cyberpunk-btn:hover::before {
  left: 100%;
}

.cyberpunk-btn:active {
  transform: translateY(0);
}

/* Responsive Design */
@media (max-width: 768px) {
  .timeline-container {
    padding-left: 2rem;
  }
  
  .timeline-marker {
    left: -2.5rem;
    width: 2rem;
    height: 2rem;
    font-size: 1rem;
  }
  
  .timeline-item {
    margin-left: 1rem;
    padding: 1.5rem;
  }
  
  .section-title {
    font-size: 2rem;
  }
  
  .act-navigation {
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .cyberpunk-btn {
    padding: 1.2rem 2rem;
    font-size: 1rem;
    min-width: 180px;
  }
}
</style>