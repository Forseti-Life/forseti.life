{#
/**
 * @file
 * Theory of Conspiracies home page template
 *
 * Available variables:
 * - movie_data: Movie information and details
 * - featured_characters: Array of featured characters
 * - nav_sections: Navigation sections for site exploration
 * - updates: Latest news and updates
 */
#}

<div class="theory-home cyberpunk-container">

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-background">
      <div class="matrix-rain"></div>
      <div class="scan-lines"></div>
    </div>
    
    <div class="hero-content">
      <h1 class="hero-title glitch-text" data-text="{{ movie_data.title }}">
        {{ movie_data.title }}
      </h1>
      
      <div class="hero-tagline">
        {{ movie_data.tagline }}
      </div>
      
      <div class="hero-details">
        <div class="movie-info">
          <span class="info-item">{{ movie_data.year }}</span>
          <span class="info-separator">•</span>
          <span class="info-item">{{ movie_data.genre }}</span>
          <span class="info-separator">•</span>
          <span class="info-item">{{ movie_data.rating }}</span>
          <span class="info-separator">•</span>
          <span class="info-item">{{ movie_data.runtime }}</span>
        </div>
      </div>
      
      <div class="hero-actions">
        <a href="/characters" class="cyberpunk-btn primary">View Characters</a>
        <a href="/story/act-i" class="cyberpunk-btn secondary">View Story Timeline</a>
        <a href="/setting/philadelphia-2085" class="cyberpunk-btn tertiary">Explore Setting</a>
      </div>
    </div>
    
    <div class="hero-overlay"></div>
  </section>

  <!-- Synopsis Section -->
  <section class="synopsis-section">
    <div class="section-container">
      <h2 class="section-title">The Story</h2>
      <div class="synopsis-content">
        <p class="synopsis-text">{{ movie_data.synopsis }}</p>
        
        <div class="crew-info">
          <div class="crew-item">
            <span class="crew-role">Writer:</span>
            <span class="crew-name">{{ movie_data.writer }}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Characters Section -->
  <section class="featured-characters-section">
    <div class="section-container">
      <h2 class="section-title">Main Characters</h2>
      <div class="characters-grid">
        {% for character in featured_characters %}
          <div class="character-preview">
            <div class="character-image">
              <div class="image-placeholder">
                <div class="loading-animation">
                  <span>{{ character.name|upper }}_LOADING...</span>
                </div>
              </div>
            </div>
            <div class="character-info">
              <h3 class="character-name">
                <a href="{{ character.path }}">{{ character.name }}</a>
              </h3>
              <div class="character-role">{{ character.role }}</div>
              <p class="character-description">{{ character.description }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="characters-action">
        <a href="/characters" class="cyberpunk-btn">View Characters</a>
      </div>
    </div>
  </section>

  <!-- Themes Section -->
  <section class="themes-section">
    <div class="section-container">
      <h2 class="section-title">Themes Explored</h2>
      <div class="themes-grid">
        {% for theme in movie_data.themes %}
          <div class="theme-item">
            <div class="theme-icon">▸</div>
            <div class="theme-text">{{ theme }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Navigation Sections -->
  <section class="navigation-sections">
    <div class="section-container">
      <h2 class="section-title">Explore the World</h2>
      <div class="nav-grid">
        {% for section in nav_sections %}
          <div class="nav-card">
            <div class="nav-icon">{{ section.icon }}</div>
            <h3 class="nav-title">{{ section.title }}</h3>
            <p class="nav-description">{{ section.description }}</p>
            <a href="{{ section.path }}" class="nav-link">Explore →</a>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Updates Section -->
  <section class="updates-section">
    <div class="section-container">
      <h2 class="section-title">Latest Updates</h2>
      <div class="updates-timeline">
        {% for update in updates %}
          <div class="update-item">
            <div class="update-marker"></div>
            <div class="update-content">
              <h3 class="update-title">{{ update.title }}</h3>
              <div class="update-date">{{ update.date }}</div>
              <p class="update-description">{{ update.description }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="footer-cta">
    <div class="section-container">
      <div class="cta-content">
        <h2 class="cta-title">Enter Philadelphia 2085</h2>
        <p class="cta-description">
          Discover a world where the line between human and artificial intelligence blurs, 
          and every choice determines the fate of authentic connection.
        </p>
        <div class="cta-actions">
          <a href="/setting/philadelphia-2085" class="cyberpunk-btn primary">Explore Setting</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Site Footer -->
  <footer class="site-footer">
    <div class="footer-container">
      <!-- Brand Section -->
      <div class="footer-brand">
        <h3 class="footer-logo">Theory of Conspiracies</h3>
        <p class="footer-tagline">Philadelphia 2085 • Where Reality Meets Fiction</p>
        <div class="footer-rating">
          <span class="rating-badge">PG-13</span>
          <span class="rating-text">Parental Guidance Suggested</span>
        </div>
      </div>

      <!-- Navigation Section -->
      <div class="footer-nav">
        <h4 class="footer-section-title">Explore</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/characters">Characters</a></li>
          <li><a href="/story/act-i">Story Timeline</a></li>
          <li><a href="/setting/philadelphia-2085">Setting</a></li>
        </ul>
      </div>

      <!-- Legal Section -->
      <div class="footer-legal">
        <h4 class="footer-section-title">Legal</h4>
        <ul class="footer-links">
          <li><a href="/legal/terms">Terms of Use</a></li>
          <li><a href="/legal/privacy">Privacy Policy</a></li>
          <li><a href="/legal/disclaimer">Content Disclaimer</a></li>
          <li><a href="/legal/copyright">Copyright</a></li>
        </ul>
      </div>

      <!-- Contact Section -->
      <div class="footer-contact">
        <h4 class="footer-section-title">Connect</h4>
        <ul class="footer-links">
          <li><a href="/legal/about">About</a></li>
          <li><a href="/legal/credits">Credits</a></li>
          <li><a href="#top">Back to Top</a></li>
        </ul>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <div class="footer-container">
        <div class="footer-disclaimer">
          <p><strong>Fiction Disclaimer:</strong> This is a work of science fiction. All characters, events, and technologies depicted are fictional and created for entertainment purposes.</p>
          <p><strong>Copyright Notice:</strong> © 2025 Theory of Conspiracies. All rights reserved. This fictional universe and its contents are protected by copyright law.</p>
          <p><strong>Content Rating:</strong> Rated PG-13 for futuristic themes, mild language, and sci-fi action sequences. Suitable for teens and adults.</p>
        </div>
      </div>
    </div>
  </footer>

</div>

<style>
/* Theory of Conspiracies Home Page Styles */
.theory-home {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  overflow-x: hidden;
}

/* Hero Section */
.hero-section {
  position: relative;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(135deg, #000011, #001122, #000033);
}

.hero-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.3;
}

.matrix-rain {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 2px,
    rgba(0, 255, 255, 0.03) 2px,
    rgba(0, 255, 255, 0.03) 4px
  );
  animation: matrix-scroll 20s linear infinite;
}

.scan-lines {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(0, 255, 255, 0.02) 2px,
    rgba(0, 255, 255, 0.02) 4px
  );
  animation: scan-lines-move 15s linear infinite;
}

.hero-content {
  text-align: center;
  z-index: 2;
  max-width: 1000px;
  padding: 2rem;
}

.hero-title {
  font-family: 'Orbitron', monospace;
  font-size: 5rem;
  font-weight: 900;
  color: #00ffff;
  text-shadow: 
    0 0 10px rgba(0, 255, 255, 0.8),
    0 0 20px rgba(0, 255, 255, 0.6),
    0 0 40px rgba(0, 255, 255, 0.4);
  margin-bottom: 2rem;
  letter-spacing: 8px;
  line-height: 1.1;
}

.hero-tagline {
  font-family: 'Rajdhani', sans-serif;
  font-size: 1.8rem;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 2rem;
  letter-spacing: 2px;
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
}

.hero-details {
  margin-bottom: 3rem;
}

.movie-info {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.info-item {
  font-family: 'Rajdhani', sans-serif;
  color: #ff00ff;
  font-size: 1.2rem;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 1px;
  text-shadow: 0 0 5px rgba(255, 0, 255, 0.6);
}

.info-separator {
  color: rgba(255, 255, 255, 0.5);
  font-size: 1.2rem;
}

.hero-actions {
  display: flex;
  gap: 2rem;
  justify-content: center;
  flex-wrap: wrap;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(
    ellipse at center,
    transparent 20%,
    rgba(0, 0, 0, 0.3) 70%,
    rgba(0, 0, 0, 0.7) 100%
  );
  pointer-events: none;
  z-index: 1;
}

/* Section Styles */
.section-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 4rem 2rem;
}

.section-title {
  font-family: 'Orbitron', monospace;
  font-size: 2.5rem;
  color: #00ff41;
  text-shadow: 0 0 15px rgba(0, 255, 65, 0.6);
  text-align: center;
  margin-bottom: 3rem;
  letter-spacing: 3px;
}

/* Synopsis Section */
.synopsis-section {
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.9), rgba(17, 17, 17, 0.8));
  border-top: 2px solid rgba(0, 255, 255, 0.3);
  border-bottom: 2px solid rgba(0, 255, 255, 0.3);
}

.synopsis-content {
  text-align: center;
}

.synopsis-text {
  font-family: 'Rajdhani', sans-serif;
  font-size: 1.2rem;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.8;
  max-width: 900px;
  margin: 0 auto 2rem;
}

.crew-info {
  display: flex;
  justify-content: center;
  gap: 3rem;
  flex-wrap: wrap;
}

.crew-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.crew-role {
  font-family: 'Rajdhani', sans-serif;
  color: #ff00ff;
  font-size: 1rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.crew-name {
  font-family: 'Orbitron', monospace;
  color: #00ffff;
  font-size: 1.1rem;
  text-shadow: 0 0 5px rgba(0, 255, 255, 0.6);
}

/* Featured Characters Section */
.featured-characters-section {
  background: linear-gradient(135deg, rgba(26, 26, 26, 0.95), rgba(17, 17, 17, 0.9));
}

.characters-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  margin-bottom: 3rem;
}

.character-preview {
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.1), rgba(0, 255, 255, 0.05));
  border: 2px solid rgba(0, 255, 255, 0.3);
  padding: 1.5rem;
  border-radius: 8px;
  transition: all 0.4s ease;
  position: relative;
  overflow: hidden;
}

.character-preview::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: repeating-linear-gradient(
    45deg,
    transparent,
    transparent 10px,
    rgba(0, 255, 255, 0.02) 10px,
    rgba(0, 255, 255, 0.02) 20px
  );
  pointer-events: none;
}

.character-preview:hover {
  transform: translateY(-10px);
  border-color: #00ffff;
  box-shadow: 0 20px 40px rgba(0, 255, 255, 0.3);
}

.character-image {
  height: 200px;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  border: 2px dashed rgba(0, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  position: relative;
  overflow: hidden;
}

.image-placeholder::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, #00ffff, transparent);
  animation: scan-line-horizontal 3s linear infinite;
}

.loading-animation {
  color: rgba(0, 255, 255, 0.6);
  font-family: 'Rajdhani', monospace;
  font-size: 0.8rem;
  letter-spacing: 1px;
  animation: pulse 2s infinite;
}

.character-info {
  text-align: center;
}

.character-name a {
  font-family: 'Orbitron', monospace;
  font-size: 1.3rem;
  color: #00ffff;
  text-decoration: none;
  text-shadow: 0 0 10px rgba(0, 255, 255, 0.6);
  letter-spacing: 1px;
  transition: all 0.3s ease;
}

.character-name a:hover {
  color: #ffffff;
  text-shadow: 0 0 15px rgba(0, 255, 255, 0.8);
}

.character-role {
  font-family: 'Rajdhani', sans-serif;
  color: #ff00ff;
  font-size: 1rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin: 0.5rem 0;
}

.character-description {
  color: rgba(255, 255, 255, 0.8);
  font-family: 'Rajdhani', sans-serif;
  line-height: 1.6;
  font-size: 0.9rem;
}

.characters-action {
  text-align: center;
}

/* Themes Section */
.themes-section {
  background: linear-gradient(135deg, rgba(0, 255, 65, 0.1), rgba(0, 255, 65, 0.05));
  border-top: 2px solid rgba(0, 255, 65, 0.3);
  border-bottom: 2px solid rgba(0, 255, 65, 0.3);
}

.themes-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1rem;
}

.theme-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  background: rgba(0, 255, 65, 0.1);
  border-left: 3px solid #00ff41;
  transition: all 0.3s ease;
}

.theme-item:hover {
  background: rgba(0, 255, 65, 0.2);
  transform: translateX(10px);
}

.theme-icon {
  color: #00ff41;
  font-size: 1.2rem;
  text-shadow: 0 0 5px rgba(0, 255, 65, 0.6);
}

.theme-text {
  font-family: 'Rajdhani', sans-serif;
  color: rgba(255, 255, 255, 0.9);
  font-size: 1.1rem;
  font-weight: bold;
  letter-spacing: 1px;
}

/* Navigation Sections */
.navigation-sections {
  background: linear-gradient(135deg, rgba(17, 17, 17, 0.95), rgba(26, 26, 26, 0.9));
}

.nav-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2rem;
}

.nav-card {
  background: linear-gradient(135deg, rgba(255, 0, 255, 0.1), rgba(255, 0, 255, 0.05));
  border: 2px solid rgba(255, 0, 255, 0.3);
  padding: 2rem;
  border-radius: 8px;
  text-align: center;
  transition: all 0.4s ease;
  position: relative;
  overflow: hidden;
}

.nav-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 15px,
    rgba(255, 0, 255, 0.02) 15px,
    rgba(255, 0, 255, 0.02) 30px
  );
  pointer-events: none;
}

.nav-card:hover {
  transform: translateY(-10px);
  border-color: #ff00ff;
  box-shadow: 0 20px 40px rgba(255, 0, 255, 0.3);
}

.nav-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
  filter: grayscale(1);
  transition: filter 0.3s ease;
}

.nav-card:hover .nav-icon {
  filter: grayscale(0);
}

.nav-title {
  font-family: 'Orbitron', monospace;
  color: #ff00ff;
  font-size: 1.4rem;
  margin-bottom: 1rem;
  text-shadow: 0 0 10px rgba(255, 0, 255, 0.6);
  letter-spacing: 1px;
}

.nav-description {
  color: rgba(255, 255, 255, 0.8);
  font-family: 'Rajdhani', sans-serif;
  line-height: 1.6;
  margin-bottom: 1.5rem;
}

.nav-link {
  color: #ff00ff;
  font-family: 'Rajdhani', sans-serif;
  font-weight: bold;
  text-decoration: none;
  font-size: 1.1rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: all 0.3s ease;
}

.nav-link:hover {
  color: #ffffff;
  text-shadow: 0 0 10px rgba(255, 0, 255, 0.8);
}

/* Updates Section */
.updates-section {
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.9), rgba(17, 17, 17, 0.8));
}

.updates-timeline {
  max-width: 800px;
  margin: 0 auto;
}

.update-item {
  display: flex;
  margin-bottom: 2rem;
  position: relative;
}

.update-item:last-child .update-marker::after {
  display: none;
}

.update-marker {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: linear-gradient(45deg, #00ffff, #ff00ff);
  margin-right: 2rem;
  margin-top: 0.5rem;
  position: relative;
  box-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
}

.update-marker::after {
  content: '';
  position: absolute;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: 2px;
  height: 60px;
  background: linear-gradient(180deg, #00ffff, rgba(0, 255, 255, 0.3));
}

.update-content {
  flex: 1;
}

.update-title {
  font-family: 'Orbitron', monospace;
  color: #00ffff;
  font-size: 1.2rem;
  margin-bottom: 0.5rem;
  text-shadow: 0 0 5px rgba(0, 255, 255, 0.6);
}

.update-date {
  font-family: 'Rajdhani', sans-serif;
  color: #ff00ff;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 0.5rem;
}

.update-description {
  color: rgba(255, 255, 255, 0.8);
  font-family: 'Rajdhani', sans-serif;
  line-height: 1.6;
}

/* Footer CTA */
.footer-cta {
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.1), rgba(255, 0, 255, 0.1));
  border-top: 3px solid rgba(0, 255, 255, 0.5);
  text-align: center;
}

.cta-content {
  max-width: 800px;
  margin: 0 auto;
}

.cta-title {
  font-family: 'Orbitron', monospace;
  font-size: 2.5rem;
  color: #00ffff;
  text-shadow: 0 0 15px rgba(0, 255, 255, 0.8);
  margin-bottom: 1.5rem;
  letter-spacing: 3px;
}

.cta-description {
  font-family: 'Rajdhani', sans-serif;
  font-size: 1.2rem;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
  margin-bottom: 2rem;
}

.cta-actions {
  display: flex;
  justify-content: center;
}

/* Animations */
@keyframes matrix-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50px); }
}

@keyframes scan-lines-move {
  0% { transform: translateY(0); }
  100% { transform: translateY(-50px); }
}

@keyframes scan-line-horizontal {
  0% { left: -100%; }
  100% { left: 100%; }
}

@keyframes pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* Responsive Design */
@media (max-width: 768px) {
  .hero-title {
    font-size: 3rem;
    letter-spacing: 4px;
  }
  
  .hero-tagline {
    font-size: 1.4rem;
  }
  
  .hero-actions {
    flex-direction: column;
    align-items: center;
  }
  
  .section-title {
    font-size: 2rem;
  }
  
  .movie-info {
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .info-separator {
    display: none;
  }
  
  .characters-grid,
  .nav-grid {
    grid-template-columns: 1fr;
  }
  
  .themes-grid {
    grid-template-columns: 1fr;
  }
  
  .crew-info {
    flex-direction: column;
    gap: 1rem;
  }
  
  .update-item {
    flex-direction: column;
  }
  
  .update-marker {
    margin-right: 0;
    margin-bottom: 1rem;
  }
  
  .update-marker::after {
    display: none;
  }
}

/* Site Footer Styles */
.site-footer {
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.95), rgba(17, 17, 17, 0.9));
  border-top: 2px solid rgba(0, 255, 255, 0.3);
  margin-top: 4rem;
  position: relative;
}

.site-footer::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 2px,
    rgba(0, 255, 255, 0.02) 2px,
