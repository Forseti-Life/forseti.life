{#
/**
 * @file
 * Characters overview page template
 *
 * Available variables:
 * - characters: Array of character data
 */
#}

<div class="characters-overview cyberpunk-container">
  
  <div class="page-header">
    <h1 class="page-title glitch-text" data-text="CHARACTERS">
      CHARACTERS
    </h1>
    <div class="page-subtitle">
      Main Characters in Theory of Conspiracies
    </div>
    <div class="page-description">
      Philadelphia 2085: A cast of humans and AI consciousnesses navigate the complex landscape of institutional control and resistance networks.
    </div>
  </div>

  <div class="characters-grid">
    {% for character in characters %}
      <div class="character-card" data-character-type="{{ character.type|lower|replace({' ': '-'}) }}">
        
        <div class="character-card-header">
          <h3 class="character-card-name">
            <a href="{{ character.path }}">{{ character.name }}</a>
          </h3>
          <div class="character-card-role">{{ character.role }}</div>
          <div class="character-card-type type-{{ character.type|lower|replace({' ': '-'}) }}">
            {{ character.type }}
          </div>
        </div>

        <div class="character-card-image">
          <div class="image-placeholder">
            <div class="loading-animation">
              <span>IMG_LOADING...</span>
            </div>
          </div>
        </div>

        <div class="character-card-content">
          <p class="character-card-description">
            {{ character.description }}
          </p>
        </div>

        <div class="character-card-actions">
          <a href="{{ character.path }}" class="character-btn">
            View Profile
          </a>
        </div>

      </div>
    {% endfor %}
  </div>

  <div class="characters-navigation">
    <a href="/story/act-i" class="cyberpunk-btn">View Story Timeline</a>
    <a href="/setting/philadelphia-2085" class="cyberpunk-btn">Explore Setting</a>
    <a href="/" class="cyberpunk-btn">Return Home</a>
  </div>

</div>
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem;
}

.page-header {
  text-align: center;
  margin-bottom: 4rem;
  position: relative;
}

.page-title {
  font-family: 'Orbitron', monospace;
  font-size: 4rem;
  color: #00ffff;
  text-shadow: 0 0 30px rgba(0, 255, 255, 0.8);
  margin-bottom: 1rem;
  letter-spacing: 6px;
}

.page-subtitle {
  font-family: 'Rajdhani', sans-serif;
  font-size: 1.5rem;
  color: #ff00ff;
  text-transform: uppercase;
  letter-spacing: 3px;
  margin-bottom: 1rem;
}

.page-description {
  font-family: 'Rajdhani', sans-serif;
  color: rgba(255, 255, 255, 0.8);
  font-size: 1.1rem;
  max-width: 800px;
  margin: 0 auto;
  line-height: 1.6;
}

.characters-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2rem;
  margin-bottom: 4rem;
}

.character-card {
  background: linear-gradient(135deg, rgba(26, 26, 26, 0.95), rgba(17, 17, 17, 0.9));
  border: 2px solid rgba(0, 255, 255, 0.3);
  padding: 2rem;
  border-radius: 8px;
  position: relative;
  overflow: hidden;
  transition: all 0.4s ease;
}

.character-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: repeating-linear-gradient(
    45deg,
    transparent,
    transparent 20px,
    rgba(0, 255, 255, 0.02) 20px,
    rgba(0, 255, 255, 0.02) 40px
  );
  pointer-events: none;
}

.character-card:hover {
  transform: translateY(-10px);
  border-color: #00ffff;
  box-shadow: 0 20px 40px rgba(0, 255, 255, 0.3);
}

.character-card[data-character-type="ai-consciousness"]:hover {
  border-color: #ff00ff;
  box-shadow: 0 20px 40px rgba(255, 0, 255, 0.3);
}

.character-card[data-character-type="primary-antagonist"]:hover {
  border-color: #ff0040;
  box-shadow: 0 20px 40px rgba(255, 0, 64, 0.3);
}

.character-card-header {
  text-align: center;
  margin-bottom: 1.5rem;
}

.character-card-name {
  margin-bottom: 0.5rem;
}

.character-card-name a {
  font-family: 'Orbitron', monospace;
  font-size: 1.5rem;
  color: #00ffff;
  text-decoration: none;
  text-shadow: 0 0 10px rgba(0, 255, 255, 0.6);
  transition: all 0.3s ease;
  letter-spacing: 2px;
}

.character-card-name a:hover {
  color: #ffffff;
  text-shadow: 0 0 15px rgba(0, 255, 255, 0.8);
}

.character-card-role {
  font-family: 'Rajdhani', sans-serif;
  color: #ff00ff;
  font-size: 1rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 0.5rem;
}

.character-card-type {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.9rem;
  padding: 0.3rem 0.8rem;
  border-radius: 15px;
  display: inline-block;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: bold;
}

.type-protagonist {
  background: rgba(0, 255, 65, 0.2);
  color: #00ff41;
  border: 1px solid rgba(0, 255, 65, 0.4);
}

.type-deuteragonist {
  background: rgba(255, 255, 0, 0.2);
  color: #ffff00;
  border: 1px solid rgba(255, 255, 0, 0.4);
}

.type-ai-consciousness {
  background: rgba(255, 0, 255, 0.2);
  color: #ff00ff;
  border: 1px solid rgba(255, 0, 255, 0.4);
}

.type-primary-antagonist {
  background: rgba(255, 0, 64, 0.2);
  color: #ff0040;
  border: 1px solid rgba(255, 0, 64, 0.4);
}

.type-love-interest {
  background: rgba(255, 105, 180, 0.2);
  color: #ff69b4;
  border: 1px solid rgba(255, 105, 180, 0.4);
}

.type-supporting {
  background: rgba(0, 255, 255, 0.2);
  color: #00ffff;
  border: 1px solid rgba(0, 255, 255, 0.4);
}

.character-card-image {
  height: 200px;
  margin: 1.5rem 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  border: 2px dashed rgba(0, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  position: relative;
  overflow: hidden;
}

.image-placeholder::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, #00ffff, transparent);
  animation: scan-line-horizontal 3s linear infinite;
}

.loading-animation {
  color: rgba(0, 255, 255, 0.6);
  font-family: 'Rajdhani', monospace;
  font-size: 0.9rem;
  letter-spacing: 1px;
  animation: pulse 2s infinite;
}

.character-card-description {
  color: rgba(255, 255, 255, 0.8);
  font-family: 'Rajdhani', sans-serif;
  line-height: 1.6;
  margin-bottom: 1.5rem;
  font-size: 1rem;
}

.character-card-actions {
  text-align: center;
}

.character-btn {
  background: linear-gradient(45deg, rgba(0, 255, 255, 0.1), rgba(0, 255, 255, 0.2));
  border: 2px solid #00ffff;
  color: #00ffff;
  padding: 10px 20px;
  text-decoration: none;
  font-family: 'Rajdhani', sans-serif;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: all 0.3s ease;
  display: inline-block;
  position: relative;
  overflow: hidden;
}

.character-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.3), transparent);
  transition: left 0.5s;
}

.character-btn:hover {
  color: #ffffff;
  text-shadow: 0 0 10px rgba(0, 255, 255, 0.8);
  box-shadow: 0 0 20px rgba(0, 255, 255, 0.4);
  transform: translateY(-2px);
}

.character-btn:hover::before {
  left: 100%;
}

.characters-navigation {
  display: flex;
  gap: 2rem;
  justify-content: center;
  flex-wrap: wrap;
}

@keyframes scan-line-horizontal {
  0% { left: -100%; }
  100% { left: 100%; }
}

@keyframes pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

@media (max-width: 768px) {
  .page-title {
    font-size: 2.5rem;
  }
  
  .characters-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .character-card {
    padding: 1.5rem;
  }
  
  .characters-navigation {
    flex-direction: column;
    align-items: center;
  }
}
</style>