# Environment Configuration Template
# Copy this file to .env in the project root and update with your values

# Database Configuration
DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_HOST=localhost
DB_PORT=3306

# Drupal Admin Configuration
DRUPAL_ADMIN_USER=YOUR_ADMIN_USER
DRUPAL_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
DRUPAL_ADMIN_EMAIL=YOUR_ADMIN_EMAIL

# Site Configuration
SITE_NAME="YOUR_SITE_NAME"
SITE_EMAIL=YOUR_SITE_EMAIL

# Development Settings
ENVIRONMENT=development
DEBUG_MODE=true

# Optional: Web Server Configuration
APACHE_DOCUMENT_ROOT=YOUR_APACHE_DOCUMENT_ROOT
DOMAIN_NAME=YOUR_DOMAIN_NAME

# Optional: Backup Configuration
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30