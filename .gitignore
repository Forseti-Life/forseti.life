# Never commit raw local Copilot session logs by default
**/events.jsonl
**/workspace.yaml
**/checkpoints/

# Common local artifacts
.DS_Store
*.log
*.tmp

# Runtime state (do not commit)
tmp/escalation-streaks/
tmp/site-audit/
tmp/.last-publish-agent-tracker.epoch
tmp/org-control.json

# Runtime locks
**/.exec-lock/
tmp/.agent-exec-*.lock
tmp/.agent-exec-*/

# Python bytecode
**/__pycache__/

# Derived message-bus artifacts


# Local LLM — model weights, cache, and venv are never committed
llm/models/*.gguf
llm/models/*.bin
llm/cache/sessions/
llm/.venv/

# CEO loop runtime
.ceo-inbox-loop.pid
.ceo-health-loop.pid
.agent-exec-loop.pid
.inbox-loop.pid
inbox/responses/.ceo-health-last-queue
.inbox-loop.pid
.ceo-health-loop.pid
.agent-exec-loop.pid
.improvement-round-loop.pid
.publish-forseti-agent-tracker-loop.pid
.auto-checkpoint-loop.pid
.ceo-ops-loop.pid
llm/__pycache__/
llm/lib/__pycache__/

# Sessions are the audit trail (inbox/outbox/artifacts). Keep them tracked.
# Ignore only volatile pointers inside artifacts (e.g. symlink that moves each run).
sessions/**/artifacts/**/latest
sessions/**/artifacts/**/latest.*

# Public-repo safe defaults
# 1) Python virtualenvs and local runtime envs
**/.venv/
orchestrator/.venv/

# 2) Runtime PID / state files
*.pid
.orchestrator-loop.pid

# 3) Volatile response/log outputs (keep only directory placeholder)
inbox/responses/**
!inbox/responses/.gitkeep

# 4) Temp and lock state (keep only directory placeholder)
tmp/**
!tmp/.gitkeep
!tmp/ba-scan-progress/
!tmp/ba-scan-progress/*.json

# 5) Session audit trail is local/private by default for publication prep
sessions/**
!sessions/README.md
